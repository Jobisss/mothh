# Copie para .env.prod e escolha uma senha forte. O arquivo real fica fora do Git.
# Se a senha contiver caracteres especiais, codifique-os na URL do banco.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgres://mothh:troque-por-uma-senha-forte@postgres:5432/mothh

# LiveKit (chamadas). Gere um par novo, por exemplo:
#   docker run --rm livekit/livekit-server:v1.13.11 generate-keys
# O segredo precisa ter pelo menos 32 caracteres.
MOTHH_LIVEKIT_URL=wss://livekit.mothh.joaoschianti.com
MOTHH_LIVEKIT_KEY=troque-pela-api-key
MOTHH_LIVEKIT_SECRET=troque-pelo-segredo-com-pelo-menos-32-caracteres
