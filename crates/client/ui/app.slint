// Interface do mothh. Os valores de cor e fonte seguem docs/design-system.md.
//
// Dica: `slint-viewer ui/app.slint --auto-reload` mostra a tela e recarrega
// a cada mudança, sem recompilar o Rust.

import { ListView, ScrollView } from "std-widgets.slint";
import "fonts/VT323-Regular.ttf";
import "fonts/Geist-Regular.ttf";
import "fonts/Geist-SemiBold.ttf";

export struct ConversationRow {
    id: string,
    name: string,
    initial: string,
    preview: string,
    time: string,
    is-group: bool,
    selected: bool,
    // "▪ 3 na sala" quando há gente na chamada do grupo; vazio se não.
    in-call: string,
}

// Um quadro de vídeo na chamada: câmera ou tela. `id` vazio é a própria
// câmera; os de tela terminam em "#tela".
export struct VideoTile {
    id: string,
    name: string,
    frame: image,
    // De quem é (id da pessoa); vazio nos nossos.
    person: string,
}

// Uma tela ou janela que dá para compartilhar, com a foto dela quando
// já chegou. `detail` é o tamanho da tela ("1920×1080").
export struct ShareSourceRow {
    id: string,
    name: string,
    detail: string,
    has-preview: bool,
    preview: image,
}

export struct MessageRow {
    author: string,
    time: string,
    text: string,
    // Mesma pessoa, menos de 5 min depois da anterior: sem nome e horário.
    continues: bool,
    // Mensagem de áudio: id do anexo e duração ("0:10"). Vazio no texto.
    audio-id: string,
    duration: string,
    file-id: string,
    file-name: string,
    file-size: string,
    is-image: bool,
    preview-ready: bool,
    preview-image: image,
}

export struct MemberRow {
    id: string,
    name: string,
    is-owner: bool,
    // Quem vê é o dono e esta linha não é a dele.
    can-remove: bool,
    // Está falando na chamada deste grupo agora (F2-04).
    speaking: bool,
}

// Uma pessoa na chamada em que estamos, com o volume dela para nós
// (0 a 200, em %): a voz e o som da tela, se ela está mandando.
export struct CallPersonRow {
    id: string,
    name: string,
    speaking: bool,
    is-me: bool,
    voice: int,
    screen-audio: bool,
    screen: int,
}

export struct ModuleRow {
    id: string,
    name: string,
    description: string,
    on: bool,
}

// O que está ligado no registro de módulos (modules.rs). O Rust escreve aqui
// ao abrir o app e a cada interruptor; o resto da tela só lê, e módulo
// desligado não aparece.
export global Modules {
    in-out property <bool> dither: true;
    in-out property <bool> received-sound: true;
}

global Theme {
    out property <color> surface-0: #0a0a0a;
    out property <color> surface-1: #111111;
    out property <color> surface-2: #1a1a1a;
    out property <color> surface-3: #262626;
    out property <color> border: #262626;
    out property <color> border-strong: #6b6b6b;
    out property <color> ink: #f2f2f2;
    out property <color> ink-muted: #9a9a9a;
    out property <color> danger: #ff5a4f;
    out property <string> pixel: "VT323";
    out property <string> sans: "Geist";
}

component ConversationItem inherits Rectangle {
    in property <ConversationRow> item;
    callback clicked();

    height: 64px;
    border-radius: 4px;
    background: item.selected ? Theme.surface-3 : area.has-hover ? Theme.surface-2 : transparent;

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: item.is-group ? 4px : 22px;
            background: Theme.surface-3;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: item.initial;
                font-family: Theme.pixel;
                font-size: 26px;
                color: Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.name;
                    font-family: Theme.pixel;
                    font-size: 24px;
                    color: Theme.ink;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: item.time;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink-muted;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.preview;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if item.in-call != "": Text {
                    text: item.in-call;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink;
                }
            }
        }
    }
}

// Player de uma mensagem de áudio: tocar/parar, barra e duração.
component AudioPlayer inherits Rectangle {
    in property <bool> playing;
    // De 0 a 1, quanto já tocou.
    in property <float> progress;
    in property <string> duration;
    // Quanto já tocou ("0:03"), enquanto toca.
    in property <string> elapsed;
    callback play();
    callback stop();

    width: 280px;
    height: 40px;
    border-radius: 2px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: area.has-hover || root.playing ? Theme.ink : Theme.border-strong;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.playing {
                root.stop();
            } else {
                root.play();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // Triângulo para tocar, quadrado para parar. Desenhados, porque a
        // VT323 não tem esses símbolos.
        Rectangle {
            width: 12px;
            if !root.playing: Path {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 14px;
                viewbox-width: 12;
                viewbox-height: 14;
                commands: "M 0 0 L 12 7 L 0 14 Z";
                fill: Theme.ink;
            }
            if root.playing: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 11px;
                height: 11px;
                background: Theme.ink;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 2px;
                background: Theme.border-strong;
            }
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width * clamp(root.progress, 0, 1);
                height: 2px;
                background: Theme.ink;
            }
        }

        Text {
            text: root.playing ? root.elapsed + " / " + root.duration : root.duration;
            font-family: Theme.pixel;
            font-size: 20px;
            color: Theme.ink-muted;
            vertical-alignment: center;
        }
    }
}

component MessageItem inherits VerticalLayout {
    in property <MessageRow> item;
    // Este áudio é o que está tocando agora.
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    callback play-audio(string);
    callback stop-audio();
    callback save-file(string, string);
    // Bloco novo ganha espaço em cima; continuação fica colada na anterior.
    padding-top: item.continues ? 0px : 10px;
    padding-bottom: 2px;
    spacing: 2px;

    if !item.continues: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: item.author;
            font-family: Theme.pixel;
            font-size: 22px;
            color: Theme.ink;
        }
        Text {
            text: item.time;
            font-family: Theme.pixel;
            font-size: 18px;
            color: Theme.ink-muted;
            vertical-alignment: bottom;
        }
    }
    if item.audio-id == "" && item.file-id == "": Text {
        text: item.text;
        font-family: Theme.sans;
        font-size: 15px;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if item.audio-id != "": HorizontalLayout {
        alignment: start;
        padding-top: 2px;
        padding-bottom: 2px;
        AudioPlayer {
            playing: root.playing;
            progress: root.progress;
            elapsed: root.elapsed;
            duration: item.duration;
            play => { root.play-audio(item.audio-id); }
            stop => { root.stop-audio(); }
        }
    }
    if item.file-id != "": Rectangle {
        width: 260px;
        height: item.is-image ? 230px : 64px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: Theme.surface-2;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                text: item.file-name;
                font-family: Theme.sans;
                font-size: 14px;
                color: Theme.ink;
                overflow: elide;
            }
            if item.is-image && item.preview-ready: Image {
                source: item.preview-image;
                width: 240px;
                height: 170px;
                image-fit: contain;
            }
            if item.is-image && !item.preview-ready: Text {
                text: "carregando imagem...";
                height: 170px;
                font-family: Theme.pixel;
                font-size: 20px;
                color: Theme.ink-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            Text {
                text: item.file-size + "  ·  baixar";
                font-family: Theme.pixel;
                font-size: 18px;
                color: Theme.ink-muted;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.save-file(item.file-id, item.file-name); }
        }
    }
}

// Campo de texto com cara de terminal: "> " na frente e borda clara no foco.
component Field inherits Rectangle {
    in property <bool> password;
    // Texto cinza que aparece com o campo vazio.
    in property <string> placeholder;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted();
    forward-focus: input;

    height: 48px;
    border-radius: 2px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.ink : Theme.border-strong;

    // Clicar em qualquer parte da caixa foca o campo.
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            text: ">";
            font-family: Theme.pixel;
            font-size: 22px;
            color: Theme.ink-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                enabled: root.enabled;
                input-type: root.password ? InputType.password : InputType.text;
                font-family: Theme.sans;
                font-size: 15px;
                color: Theme.ink;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
            }
            if input.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-family: Theme.pixel;
                font-size: 20px;
                color: Theme.ink-muted;
                vertical-alignment: center;
            }
        }
    }
}

// Botão principal (fundo claro) ou secundário (só a borda).
component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    border-radius: 2px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary
        ? (area.has-hover ? Theme.ink-muted : Theme.ink)
        : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.primary ? Theme.ink : Theme.border-strong;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-family: Theme.pixel;
        font-size: 24px;
        color: root.primary ? Theme.surface-0 : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FieldLabel inherits Text {
    font-family: Theme.pixel;
    font-size: 22px;
    color: Theme.ink-muted;
}

// Texto clicável pequeno, como o "sair" do rodapé.
component Link inherits Text {
    callback clicked();
    out property <bool> link-hover: link-area.has-hover;
    font-family: Theme.pixel;
    font-size: 20px;
    color: link-area.has-hover ? Theme.ink : Theme.ink-muted;
    link-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Dica que aparece embaixo de um botão de ícone. A janela desenha ela por
// cima de tudo; o botão só escreve aqui depois de um tempo com o mouse em
// cima, e apaga quando o mouse sai.
global Tip {
    in-out property <string> text;
    // Meio da borda de baixo do botão, em coordenadas da janela.
    in-out property <length> x;
    in-out property <length> y;
}

// Botão quadrado só com ícone; o que ele faz aparece na dica. `active`:
// ligado (câmera ligada, tela sendo mostrada), fica invertido. `danger`:
// vermelho (microfone mudo, sair da chamada).
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> active;
    in property <bool> danger;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 2px;
    background: root.active ? Theme.ink : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.ink : (area.has-hover ? Theme.border-strong : transparent);

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.icon;
        colorize: root.active ? Theme.surface-0
            : root.danger ? Theme.danger
            : (area.has-hover ? Theme.ink : Theme.ink-muted);
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // O botão costuma mudar de dica ao clicar (ligar vira desligar).
            Tip.text = "";
            root.clicked();
        }
        changed has-hover => {
            if !self.has-hover && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }

    Timer {
        interval: 450ms;
        running: area.has-hover && Tip.text != root.tip;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 6px;
        }
    }
}

// Nome de quem está na chamada. Quem fala fica invertido (fundo claro);
// o tamanho não muda, então nada na faixa pula de lugar.
component SpeakerTag inherits Rectangle {
    in property <string> name;
    in property <bool> speaking;
    // Botão direito: abre o menu de volume, onde está o ponteiro.
    callback menu(length, length);

    TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }

    border-radius: 2px;
    border-width: 1px;
    border-color: root.speaking ? Theme.ink : Theme.border-strong;
    background: root.speaking ? Theme.ink : transparent;
    animate background, border-color { duration: 90ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.name;
            font-family: Theme.pixel;
            font-size: 20px;
            color: root.speaking ? Theme.surface-0 : Theme.ink-muted;
            vertical-alignment: center;
            animate color { duration: 90ms; }
        }
    }
}

// Volume de 0% a 200%, com um risco no 100%. Arrastar ou rolar a roda
// muda; perto do 100% ele gruda no 100%; clique duplo volta para 100%.
component VolumeSlider inherits Rectangle {
    in property <bool> vertical;
    in property <int> value;
    callback moved-to(int);

    property <float> ratio: root.value / 200;
    property <length> track: (root.vertical ? root.height : root.width) - 12px;

    function pick(pos: length) {
        let r = clamp(root.vertical ? 1 - (pos - 6px) / root.track : (pos - 6px) / root.track, 0, 1);
        let v = round(r * 200);
        root.moved-to(abs(v - 100) <= 6 ? 100 : v);
    }

    // Trilho, parte cheia e o risco do 100%.
    Rectangle {
        x: root.vertical ? (root.width - 4px) / 2 : 6px;
        y: root.vertical ? 6px : (root.height - 4px) / 2;
        width: root.vertical ? 4px : root.track;
        height: root.vertical ? root.track : 4px;
        background: Theme.surface-3;
    }
    Rectangle {
        x: root.vertical ? (root.width - 4px) / 2 : 6px;
        y: root.vertical ? 6px + root.track * (1 - root.ratio) : (root.height - 4px) / 2;
        width: root.vertical ? 4px : root.track * root.ratio;
        height: root.vertical ? root.track * root.ratio : 4px;
        background: Theme.ink;
    }
    Rectangle {
        x: root.vertical ? (root.width - 16px) / 2 : 6px + root.track / 2 - 1px;
        y: root.vertical ? 6px + root.track / 2 - 1px : (root.height - 16px) / 2;
        width: root.vertical ? 16px : 2px;
        height: root.vertical ? 2px : 16px;
        background: Theme.border-strong;
    }
    Rectangle {
        width: root.vertical ? 22px : 10px;
        height: root.vertical ? 10px : 22px;
        x: root.vertical ? (root.width - self.width) / 2 : 6px + root.track * root.ratio - self.width / 2;
        y: root.vertical ? 6px + root.track * (1 - root.ratio) - self.height / 2 : (root.height - self.height) / 2;
        border-radius: 1px;
        border-width: 2px;
        border-color: Theme.ink;
        background: area.pressed || area.has-hover ? Theme.ink : Theme.surface-0;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pick(root.vertical ? self.mouse-y : self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.pick(root.vertical ? self.mouse-y : self.mouse-x);
            }
        }
        double-clicked => { root.moved-to(100); }
        scroll-event(event) => {
            if event.delta-y == 0 {
                return reject;
            }
            root.moved-to(clamp(root.value + (event.delta-y > 0 ? 5 : -5), 0, 200));
            accept
        }
    }
}

// Uma coluna do mixer: o volume em cima, o slider e o nome embaixo.
component MixerStrip inherits VerticalLayout {
    in property <string> name;
    in property <string> kind;
    in property <int> value;
    callback moved-to(int);

    width: 76px;
    spacing: 4px;
    Text {
        text: root.value + "%";
        font-family: Theme.pixel;
        font-size: 20px;
        color: root.value == 0 ? Theme.danger : Theme.ink;
        horizontal-alignment: center;
    }
    VolumeSlider {
        vertical: true;
        height: 160px;
        value: root.value;
        moved-to(v) => { root.moved-to(v); }
    }
    Text {
        text: root.name;
        font-family: Theme.pixel;
        font-size: 20px;
        color: Theme.ink;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.kind;
        font-family: Theme.pixel;
        font-size: 16px;
        color: Theme.ink-muted;
        horizontal-alignment: center;
    }
}

// O mixer da chamada: uma coluna para a voz de cada pessoa e outra para o
// som da tela de quem está mandando. Só muda o que nós ouvimos.
component Mixer inherits Rectangle {
    in property <[CallPersonRow]> people;
    callback set-volume(string, bool, int);
    callback close();

    width: max(240px, mixer-layout.preferred-width);
    height: mixer-layout.preferred-height;
    background: Theme.surface-0;
    border-width: 1px;
    border-color: Theme.ink;
    border-radius: 2px;

    // Clique no fundo do painel não fecha ele.
    TouchArea {}

    mixer-layout := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: "MIXER";
                font-family: Theme.pixel;
                font-size: 24px;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: @image-url("icons/close.svg");
                tip: "fechar o mixer";
                clicked => { root.close(); }
            }
        }
        if root.people.length <= 1: Text {
            text: "> só você na chamada";
            font-family: Theme.pixel;
            font-size: 20px;
            color: Theme.ink-muted;
        }
        HorizontalLayout {
            alignment: start;
            for person in root.people: HorizontalLayout {
                spacing: 8px;
                if !person.is-me: MixerStrip {
                    name: person.name;
                    kind: "voz";
                    value: person.voice;
                    moved-to(v) => { root.set-volume(person.id, false, v); }
                }
                if !person.is-me && person.screen-audio: MixerStrip {
                    name: person.name;
                    kind: "tela";
                    value: person.screen;
                    moved-to(v) => { root.set-volume(person.id, true, v); }
                }
            }
        }
        Text {
            text: "só muda o que você ouve · clique duplo: 100%";
            font-family: Theme.pixel;
            font-size: 16px;
            color: Theme.ink-muted;
        }
    }
}

// Uma linha clicável do menu do botão direito.
component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    border-radius: 2px;
    background: item-area.has-hover ? Theme.ink : transparent;
    Text {
        x: 8px;
        height: parent.height;
        text: root.text;
        font-family: Theme.pixel;
        font-size: 20px;
        color: item-area.has-hover ? Theme.surface-0 : Theme.ink;
        vertical-alignment: center;
    }
    item-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Uma linha de volume no menu do botão direito.
component MenuVolume inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    callback moved-to(int);
    spacing: 8px;
    height: 30px;
    Text {
        width: 44px;
        text: root.label;
        font-family: Theme.pixel;
        font-size: 20px;
        color: Theme.ink-muted;
        vertical-alignment: center;
    }
    VolumeSlider {
        horizontal-stretch: 1;
        value: root.value;
        moved-to(v) => { root.moved-to(v); }
    }
    Text {
        width: 48px;
        text: root.value + "%";
        font-family: Theme.pixel;
        font-size: 20px;
        color: root.value == 0 ? Theme.danger : Theme.ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Menu do botão direito sobre uma pessoa ou um vídeo da chamada: o volume
// dela e o da tela, mutar só para nós e a tela cheia.
component CallMenu inherits Rectangle {
    in property <string> title;
    in property <bool> has-person;
    in property <CallPersonRow> person;
    // O vídeo clicado (vazio: clicou no nome) e se ele já está em tela cheia.
    in property <string> tile;
    in property <bool> full;
    callback set-volume(string, bool, int);
    callback toggle-full();
    callback close();

    width: 280px;
    height: menu-layout.preferred-height;
    background: Theme.surface-0;
    border-width: 1px;
    border-color: Theme.ink;
    border-radius: 2px;

    TouchArea {}

    menu-layout := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text {
            text: root.title;
            font-family: Theme.pixel;
            font-size: 22px;
            color: Theme.ink;
            overflow: elide;
        }
        if root.has-person && !root.person.is-me: MenuVolume {
            label: "voz";
            value: root.person.voice;
            moved-to(v) => { root.set-volume(root.person.id, false, v); }
        }
        if root.has-person && !root.person.is-me && root.person.screen-audio: MenuVolume {
            label: "tela";
            value: root.person.screen;
            moved-to(v) => { root.set-volume(root.person.id, true, v); }
        }
        if root.has-person && !root.person.is-me: MenuItem {
            text: root.person.voice == 0 ? "desmutar para mim" : "mutar para mim";
            clicked => { root.set-volume(root.person.id, false, root.person.voice == 0 ? 100 : 0); }
        }
        if root.tile != "": MenuItem {
            text: root.full ? "sair da tela cheia" : "tela cheia";
            clicked => {
                root.toggle-full();
                root.close();
            }
        }
    }
}

// Linha de erro em vermelho; vazia, não ocupa espaço.
component ErrorLine inherits Text {
    in property <string> message;
    visible: root.message != "";
    height: root.message == "" ? 0px : self.preferred-height;
    text: "! " + root.message;
    font-family: Theme.pixel;
    font-size: 20px;
    color: Theme.danger;
    wrap: word-wrap;
}

// Coluna da direita dentro de um grupo: quem está nele, convidar e sair.
component MembersPanel inherits Rectangle {
    in property <[MemberRow]> members;
    in property <string> error;
    callback invite(string);
    callback remove(string);
    callback leave();

    // Sair pede um segundo clique, para não sair sem querer.
    property <bool> confirm-leave;

    width: 260px;
    background: Theme.surface-0;

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "MEMBROS · " + root.members.length;
            font-family: Theme.pixel;
            font-size: 26px;
            color: Theme.ink;
        }

        ListView {
            vertical-stretch: 1;
            for member in root.members: HorizontalLayout {
                height: 32px;
                spacing: 8px;
                // Falando na chamada: o nome fica invertido.
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 2px;
                    background: member.speaking ? Theme.ink : transparent;
                    animate background { duration: 90ms; }
                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        text: member.name;
                        font-family: Theme.pixel;
                        font-size: 22px;
                        color: member.speaking ? Theme.surface-0 : Theme.ink;
                        overflow: elide;
                        vertical-alignment: center;
                        animate color { duration: 90ms; }
                    }
                }
                if member.is-owner: Text {
                    text: "[dono]";
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink-muted;
                    vertical-alignment: center;
                }
                if member.can-remove: Link {
                    text: "remover";
                    vertical-alignment: center;
                    clicked => { root.remove(member.id); }
                }
            }
        }

        FieldLabel { text: "convidar pelo usuário"; }
        invite-field := Field {
            accepted => {
                root.invite(self.text);
                self.text = "";
            }
        }
        ErrorLine { message: root.error; }

        Rectangle { height: 4px; }

        Button {
            label: root.confirm-leave ? "[ confirmar saída ]" : "sair do grupo";
            primary: root.confirm-leave;
            clicked => {
                if root.confirm-leave {
                    root.leave();
                }
                root.confirm-leave = !root.confirm-leave;
            }
        }
    }
}

// Interruptor de liga/desliga, quadrado como o resto da tela.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 2px;
    background: root.on ? Theme.ink : Theme.surface-2;
    border-width: 1px;
    border-color: root.on ? Theme.ink : Theme.border-strong;

    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 16px;
        height: parent.height - 8px;
        border-radius: 1px;
        background: root.on ? Theme.surface-0 : Theme.ink-muted;
        animate x { duration: 120ms; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Aba de cima do seletor de compartilhar.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 36px;
    width: tab-label.preferred-width + 24px;
    border-radius: 2px;
    background: root.selected ? Theme.ink : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.ink : Theme.border-strong;

    tab-label := Text {
        text: root.label;
        font-family: Theme.pixel;
        font-size: 22px;
        color: root.selected ? Theme.surface-0 : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Escolher o que mostrar na chamada (F2-06): uma aba para a tela inteira e
// outra para uma janela, cada opção com a foto do que ela é de verdade, e o
// som junto ou não. Fica por cima da conversa, com o fundo escurecido.
component SharePicker inherits Rectangle {
    in property <[ShareSourceRow]> screens;
    in property <[ShareSourceRow]> windows;
    in property <bool> audio-supported;
    in-out property <bool> audio;
    callback pick(string, bool);
    callback close();

    // 0: tela inteira, 1: janela.
    property <int> tab: 0;
    property <string> chosen;
    property <[ShareSourceRow]> shown: root.tab == 0 ? root.screens : root.windows;

    background: #000000b0;

    // Clicar fora do quadro fecha.
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(parent.width - 48px, 820px);
        height: min(parent.height - 48px, 600px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-0;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: 2px;

        // Segura os cliques dentro do quadro.
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "COMPARTILHAR";
                    font-family: Theme.pixel;
                    font-size: 28px;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: @image-url("icons/close.svg");
                    tip: "fechar";
                    clicked => { root.close(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Tab {
                    label: root.screens.length + root.windows.length == 0 ? "tela inteira" : "tela inteira (" + root.screens.length + ")";
                    selected: root.tab == 0;
                    clicked => {
                        root.tab = 0;
                        root.chosen = "";
                    }
                }
                Tab {
                    label: root.screens.length + root.windows.length == 0 ? "janela" : "janela (" + root.windows.length + ")";
                    selected: root.tab == 1;
                    clicked => {
                        root.tab = 1;
                        root.chosen = "";
                    }
                }
            }

            Text {
                text: root.screens.length + root.windows.length == 0 ? "> procurando telas e janelas..."
                    : root.tab == 0 ? "> mostra tudo o que aparece no monitor, inclusive notificações"
                    : "> mostra só uma janela, mesmo com outra por cima dela";
                font-family: Theme.pixel;
                font-size: 20px;
                color: Theme.ink-muted;
                wrap: word-wrap;
            }

            grid := ScrollView {
                vertical-stretch: 1;
                property <length> gap: 12px;
                property <int> cols: max(1, floor((self.visible-width + self.gap) / (220px + self.gap)));
                property <length> card-width: (self.visible-width - (self.cols - 1) * self.gap) / self.cols;
                // Foto em 16:9 e uma linha de nome embaixo.
                property <length> card-height: (self.card-width - 8px) * 9 / 16 + 40px;
                content-height: ceil(root.shown.length / self.cols) * (self.card-height + self.gap);

                for source[i] in root.shown: Rectangle {
                    x: mod(i, grid.cols) * (grid.card-width + grid.gap);
                    y: floor(i / grid.cols) * (grid.card-height + grid.gap);
                    width: grid.card-width;
                    height: grid.card-height;
                    border-radius: 2px;
                    border-width: source.id == root.chosen ? 2px : 1px;
                    border-color: source.id == root.chosen ? Theme.ink
                        : (card-area.has-hover ? Theme.border-strong : Theme.border);
                    background: source.id == root.chosen ? Theme.surface-2 : Theme.surface-1;

                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: (parent.width - 8px) * 9 / 16;
                        background: Theme.surface-0;
                        clip: true;
                        if source.has-preview: Image {
                            width: 100%;
                            height: 100%;
                            source: source.preview;
                            image-fit: contain;
                        }
                        if !source.has-preview: Text {
                            text: "...";
                            font-family: Theme.pixel;
                            font-size: 22px;
                            color: Theme.ink-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 8px;
                        y: parent.height - 36px;
                        width: parent.width - 16px;
                        height: 32px;
                        text: source.detail == "" ? source.name : source.name + " · " + source.detail;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: source.id == root.chosen ? Theme.ink : Theme.ink-muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    card-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.chosen = source.id; }
                        double-clicked => { root.pick(source.id, root.audio && root.audio-supported); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                if root.audio-supported: Switch {
                    y: (parent.height - self.height) / 2;
                    on: root.audio;
                    toggled => { root.audio = !root.audio; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.audio-supported ? "compartilhar o som" : "som da tela: só no Windows por enquanto";
                        font-family: Theme.pixel;
                        font-size: 22px;
                        color: root.audio-supported && root.audio ? Theme.ink : Theme.ink-muted;
                    }
                    if root.audio-supported: Text {
                        text: root.tab == 0 ? "todo o som do PC, menos o do mothh" : "só o som do programa dessa janela";
                        font-family: Theme.pixel;
                        font-size: 18px;
                        color: Theme.ink-muted;
                        overflow: elide;
                    }
                }
                Button {
                    width: 120px;
                    label: "cancelar";
                    clicked => { root.close(); }
                }
                Button {
                    width: 160px;
                    primary: true;
                    enabled: root.chosen != "";
                    label: "compartilhar";
                    clicked => { root.pick(root.chosen, root.audio && root.audio-supported); }
                }
            }
        }
    }
}

// Uma escolha entre várias opções (qual microfone, por exemplo). Clicar na
// linha abre a lista embaixo; a escolhida tem o ">".
component Select inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> current;
    callback choose(int);
    property <bool> open;

    Rectangle {
        height: 56px;
        border-radius: 4px;
        background: head.has-hover ? Theme.surface-2 : transparent;
        head := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            Text {
                width: 180px;
                text: root.label;
                font-family: Theme.pixel;
                font-size: 24px;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Text {
                text: root.options.length == 0 ? "procurando..." : root.options[root.current];
                font-family: Theme.pixel;
                font-size: 22px;
                color: Theme.ink-muted;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.open ? "fechar" : "trocar";
                font-family: Theme.pixel;
                font-size: 20px;
                color: head.has-hover ? Theme.ink : Theme.ink-muted;
                vertical-alignment: center;
            }
        }
    }
    if root.open: VerticalLayout {
        padding-left: 8px;
        padding-bottom: 8px;
        for option[i] in root.options: Rectangle {
            height: 32px;
            border-radius: 2px;
            background: option-area.has-hover ? Theme.surface-2 : transparent;
            Text {
                x: 8px;
                width: parent.width - 16px;
                text: (i == root.current ? "> " : "  ") + option;
                font-family: Theme.pixel;
                font-size: 22px;
                color: i == root.current ? Theme.ink : Theme.ink-muted;
                overflow: elide;
                vertical-alignment: center;
            }
            option-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = false;
                    root.choose(i);
                }
            }
        }
    }
}

// Coluna da direita quando a engrenagem está aberta: os dispositivos da
// chamada e um interruptor por módulo.
component SettingsPanel inherits Rectangle {
    in property <[ModuleRow]> modules;
    // Opções de cada dispositivo (a primeira é o padrão do sistema) e qual
    // está escolhida.
    in property <[string]> mic-options;
    in property <int> mic-choice;
    in property <[string]> speaker-options;
    in property <int> speaker-choice;
    in property <[string]> camera-options;
    in property <int> camera-choice;
    // Teste da câmera: ligado, o último quadro e a frase de como foi.
    in property <bool> camera-testing;
    in property <image> camera-test-frame;
    in property <string> camera-test-status;
    callback test-camera(bool);
    callback toggle(string, bool);
    // "mic", "speaker" ou "camera", e a posição na lista.
    callback choose-device(string, int);
    callback close();

    background: Theme.surface-1;

    VerticalLayout {
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: "CONFIGURAÇÕES";
                    font-family: Theme.pixel;
                    font-size: 28px;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/close.svg");
                    tip: "fechar configurações";
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        settings-scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: settings-scroll.visible-width;
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "> chamada";
                    font-family: Theme.pixel;
                    font-size: 22px;
                    color: Theme.ink-muted;
                }
                Select {
                    label: "microfone";
                    options: root.mic-options;
                    current: root.mic-choice;
                    choose(i) => { root.choose-device("mic", i); }
                }
                Select {
                    label: "saída de áudio";
                    options: root.speaker-options;
                    current: root.speaker-choice;
                    choose(i) => { root.choose-device("speaker", i); }
                }
                Select {
                    label: "câmera";
                    options: root.camera-options;
                    current: root.camera-choice;
                    choose(i) => { root.choose-device("camera", i); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    Button {
                        width: 180px;
                        label: root.camera-testing ? "parar teste" : "testar câmera";
                        clicked => { root.test-camera(!root.camera-testing); }
                    }
                    Text {
                        text: root.camera-test-status;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: Theme.ink-muted;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.camera-testing: Rectangle {
                    height: 240px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface-0;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.camera-test-frame;
                        image-fit: contain;
                    }
                }

                Rectangle { height: 16px; }

                Text {
                    text: "> módulos";
                    font-family: Theme.pixel;
                    font-size: 22px;
                    color: Theme.ink-muted;
                }

                for module in root.modules: Rectangle {
                    height: 64px;
                    border-radius: 4px;
                    background: row-area.has-hover ? Theme.surface-2 : transparent;

                    // A linha toda liga e desliga, não só o interruptor.
                    row-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle(module.id, !module.on); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: module.name;
                                font-family: Theme.pixel;
                                font-size: 24px;
                                color: module.on ? Theme.ink : Theme.ink-muted;
                            }
                            Text {
                                text: module.description;
                                font-family: Theme.pixel;
                                font-size: 20px;
                                color: Theme.ink-muted;
                                overflow: elide;
                            }
                        }
                        Switch {
                            y: (parent.height - self.height) / 2;
                            on: module.on;
                            toggled => { root.toggle(module.id, !module.on); }
                        }
                    }
                }
            }
        }
    }
}

// Tela de entrada: usuário, senha, "entrar" e "criar conta".
component LoginScreen inherits Rectangle {
    in property <bool> connecting;
    in-out property <string> error;
    callback login(string, string);
    callback register(string, string);

    background: Theme.surface-0;

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                spacing: 10px;

                Text {
                    text: "mothh";
                    font-family: Theme.pixel;
                    font-size: 72px;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.connecting ? "> conectando..." : "> entre para conversar";
                    font-family: Theme.pixel;
                    font-size: 22px;
                    color: Theme.ink-muted;
                    horizontal-alignment: center;
                }

                Rectangle { height: 16px; }

                FieldLabel { text: "usuário"; }
                username := Field {
                    enabled: !root.connecting;
                    accepted => { password.focus(); }
                }

                Rectangle { height: 4px; }

                FieldLabel { text: "senha"; }
                password := Field {
                    password: true;
                    enabled: !root.connecting;
                    accepted => { enter.clicked(); }
                }

                // A linha de erro guarda o espaço mesmo vazia, para a tela não pular,
                // e cresce quando o texto quebra em duas linhas.
                Text {
                    min-height: 28px;
                    text: root.error == "" ? "" : "! " + root.error;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.danger;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                enter := Button {
                    label: "[ entrar ]";
                    primary: true;
                    enabled: !root.connecting;
                    clicked => {
                        root.error = "";
                        root.login(username.text, password.text);
                    }
                }
                Button {
                    label: "criar conta";
                    enabled: !root.connecting;
                    clicked => {
                        root.error = "";
                        root.register(username.text, password.text);
                    }
                }
            }
        }
    }

    init => { username.focus(); }
}

// Botão da barra da janela (minimizar, maximizar, fechar). O desenho é feito
// com linhas de 1px, no traço fino do resto do app.
component WindowButton inherits Rectangle {
    // "min", "max", "restore" ou "close".
    in property <string> kind;
    callback clicked();

    width: 46px;
    background: area.pressed ? (root.kind == "close" ? Theme.danger.darker(20%) : Theme.surface-3)
        : area.has-hover ? (root.kind == "close" ? Theme.danger : Theme.surface-2)
        : transparent;
    property <color> line: area.has-hover ? (root.kind == "close" ? #ffffff : Theme.ink) : Theme.ink-muted;

    if root.kind == "min": Rectangle {
        x: (parent.width - 10px) / 2;
        y: parent.height / 2;
        width: 10px;
        height: 1px;
        background: root.line;
    }
    if root.kind == "max": Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-width: 1px;
        border-color: root.line;
    }
    // Restaurar: dois quadrados, um atrás do outro.
    if root.kind == "restore": Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        Rectangle {
            x: 2px;
            y: 0;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.line;
        }
        Rectangle {
            x: 0;
            y: 2px;
            width: 8px;
            height: 8px;
            background: area.has-hover ? Theme.surface-2 : Theme.surface-0;
            border-width: 1px;
            border-color: root.line;
        }
    }
    if root.kind == "close": Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.line;
        stroke-width: 1px;
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Barra da janela do próprio app, no lugar da barra do Windows: a mariposa,
// o nome e os três botões. Arrastar move a janela (o Windows ainda encaixa
// nas bordas da tela); clique duplo maximiza.
component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();

    background: Theme.surface-0;

    // Primeiro: fica atrás dos botões, que pegam o clique antes.
    TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag();
            }
        }
    }

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("icons/mothh.png");
    }
    Text {
        x: 36px;
        height: parent.height;
        text: root.title;
        font-family: Theme.pixel;
        font-size: 20px;
        color: Theme.ink-muted;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: parent.width - self.width;
        width: 3 * 46px;
        height: parent.height;
        WindowButton {
            kind: "min";
            clicked => { root.minimize(); }
        }
        WindowButton {
            kind: root.maximized ? "restore" : "max";
            clicked => { root.toggle-maximize(); }
        }
        WindowButton {
            kind: "close";
            clicked => { root.close(); }
        }
    }

    // Linha de baixo, a mesma das divisões do app.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// Faixa invisível na borda da janela sem moldura: arrastar muda o tamanho.
// `dir` é o lado, como o winit chama ("n", "se", ...).
component ResizeEdge inherits TouchArea {
    in property <string> dir;
    callback resize(string);

    mouse-cursor: dir == "n" || dir == "s" ? MouseCursor.ns-resize
        : dir == "e" || dir == "w" ? MouseCursor.ew-resize
        : dir == "ne" || dir == "sw" ? MouseCursor.nesw-resize
        : MouseCursor.nwse-resize;
    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            root.resize(root.dir);
        }
    }
}

export component AppWindow inherits Window {
    title: root.profile == "" ? "mothh" : "mothh · " + root.profile;
    // Ícone da janela e da barra de tarefas (logo temporária, a mariposa).
    icon: @image-url("icons/mothh.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.surface-0;
    default-font-family: Theme.sans;
    // Sem a barra do Windows: o app desenha a dele (`TitleBar`).
    no-frame: true;
    // O Rust avisa quando a janela maximiza ou volta (o ícone do botão muda
    // e as bordas de mudar o tamanho somem).
    in property <bool> window-maximized;
    // Altura da barra; some no vídeo em tela cheia.
    property <length> bar-h: root.full-tile != "" ? 0 : 32px;

    in property <[ConversationRow]> conversations;
    in property <[MessageRow]> messages;
    in property <[MemberRow]> members;
    in property <string> open-title;
    // A conversa aberta é um grupo criado por alguém (dá para convidar e sair).
    in property <bool> open-is-group;
    in property <bool> members-open;
    // O formulário de grupo novo está aberto; o Rust fecha quando o grupo nasce.
    in-out property <bool> creating-group;
    // Erro do último pedido de grupo (criar, convidar, remover, sair).
    in-out property <string> group-error;
    in property <string> status: "conectando...";
    in property <string> user-name;
    in property <string> profile;
    in property <bool> logged-in;
    in property <bool> connecting: true;
    in-out property <string> auth-error;
    // Existem mensagens mais antigas no servidor / já foram pedidas.
    in property <bool> has-older;
    in property <bool> loading-older;
    // O Rust liga antes de pôr mensagens no topo da lista; a tela mantém o
    // ponto de leitura e desliga de novo.
    in-out property <bool> keep-from-bottom;
    // Campo "nova conversa": o Rust limpa quando a conversa abre, e mostra o
    // erro embaixo quando a busca não dá certo.
    in-out property <string> direct-search;
    in property <string> direct-error;
    // Lista da tela de configurações e se ela está aberta no lugar da conversa.
    in property <[ModuleRow]> modules;
    in-out property <bool> settings-open;
    // Quadro atual do fundo em dither; o Rust troca alguns por segundo.
    in property <image> dither-frame;
    // O botão "mic" está apertado e o microfone gravando ("0:03").
    in property <bool> recording;
    in property <string> recording-time;
    // O áudio tocando agora (id do anexo; vazio se nenhum) e onde ele está.
    in property <string> playing-id;
    in property <float> playing-progress;
    in property <string> playing-time;
    // A conversa aberta tem chamada (é um grupo).
    in property <bool> can-call;
    // Nome da conversa da chamada em que estamos ou entrando (vazio: nenhuma),
    // e se é a que está aberta.
    in property <string> call-name;
    in property <bool> call-is-open;
    // Já conectou (antes disso, "entrando...") e se o microfone está mudo.
    in property <bool> call-connected;
    in property <bool> call-muted;
    // Quem está na chamada e quem fala agora.
    in property <[CallPersonRow]> call-people;
    in property <bool> call-camera;
    // Estamos compartilhando a tela; a lista para escolher qual está aberta.
    in property <bool> call-sharing;
    in property <bool> share-picker-open;
    in property <[ShareSourceRow]> share-screens;
    in property <[ShareSourceRow]> share-windows;
    // Levar o som junto com a tela; o Rust põe a escolha da última vez ao
    // abrir a lista. Só o Windows sabe gravar o som da tela por enquanto.
    in-out property <bool> share-audio: true;
    in property <bool> share-audio-supported;
    // Listas das configurações: microfone, saída e câmera (a primeira opção
    // é o padrão do sistema) e a posição da escolhida.
    in property <[string]> mic-options;
    in property <int> mic-choice;
    in property <[string]> speaker-options;
    in property <int> speaker-choice;
    in property <[string]> camera-options;
    in property <int> camera-choice;
    // Teste da câmera nas configurações (`video::start_test`).
    in property <bool> camera-testing;
    in property <image> camera-test-frame;
    in property <string> camera-test-status;
    // Câmeras e telas na chamada; `video.rs` troca o quadro de cada uma.
    in property <[VideoTile]> video-tiles;
    // O tile ampliado (id; vazio: nenhum). Clicar num tile amplia ou volta;
    // o Rust limpa quando o tile some.
    in-out property <string> big-tile;
    // O vídeo em tela cheia (id; vazio: nenhum). Cobre a janela toda e põe
    // ela em tela cheia; Esc ou clique duplo sai.
    in-out property <string> full-tile;
    // Mixer aberto, e onde fica o botão dele (o painel abre embaixo).
    property <bool> mixer-open;
    property <length> mixer-x;
    property <length> mixer-y;
    // Menu do botão direito: de quem (id da pessoa; vazio nos nossos
    // vídeos), de qual vídeo (vazio: clicou no nome), o título e onde abrir.
    property <bool> menu-open;
    property <string> menu-person;
    property <string> menu-tile;
    property <string> menu-title;
    property <length> menu-x;
    property <length> menu-y;

    function open-menu(person: string, tile: string, title: string, x: length, y: length) {
        Tip.text = "";
        root.menu-person = person;
        root.menu-tile = tile;
        root.menu-title = title;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-open = true;
    }

    changed full-tile => { root.set-window-fullscreen(self.full-tile != ""); }
    changed call-is-open => {
        if !self.call-is-open {
            root.mixer-open = false;
            root.menu-open = false;
            root.full-tile = "";
        }
    }

    // A lista está colada no fim: mensagem nova faz ela descer junto.
    property <bool> stick-to-bottom: true;
    // Altura do conteúdo antes da última mudança, para saber quanto entrou.
    property <length> last-content-height;

    callback login(string, string);
    callback register(string, string);
    callback logout();
    callback open-conversation(string);
    callback send-message(string);
    callback load-older();
    callback open-direct(string);
    callback create-group(string);
    callback show-members(bool);
    callback invite(string);
    callback remove-member(string);
    callback leave-group();
    callback toggle-module(string, bool);
    // Segurar o "mic" grava; soltar em cima envia, soltar fora cancela.
    callback start-recording();
    callback stop-recording();
    callback cancel-recording();
    callback play-audio(string);
    callback stop-audio();
    callback pick-file();
    callback save-file(string, string);
    callback join-call();
    callback leave-call();
    callback toggle-mute();
    callback toggle-camera();
    callback open-share-picker();
    callback close-share-picker();
    // O id da tela ou janela, e se vai com som.
    callback start-share(string, bool);
    // A tela de configurações abriu: procura os dispositivos de novo.
    callback refresh-devices();
    callback choose-device(string, int);
    // Liga (`true`) ou desliga o teste da câmera.
    callback test-camera(bool);
    callback stop-share();
    // Volume de alguém para nós: id da pessoa, se é o som da tela, em %.
    callback set-volume(string, bool, int);
    callback set-window-fullscreen(bool);
    callback window-drag();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback window-resize(string);
    // Muda o tamanho: o Rust confere se maximizou (arrastar para o topo da
    // tela também maximiza).
    callback window-changed();
    changed width => { root.window-changed(); }
    changed height => { root.window-changed(); }

    // Fechar as configurações desliga o teste, para soltar a câmera.
    changed settings-open => {
        if !root.settings-open && root.camera-testing {
            root.test-camera(false);
        }
    }

    if root.bar-h > 0: TitleBar {
        y: 0;
        height: root.bar-h;
        title: root.title;
        maximized: root.window-maximized;
        drag => { root.window-drag(); }
        minimize => { root.window-minimize(); }
        toggle-maximize => { root.window-toggle-maximize(); }
        close => { root.window-close(); }
    }

    if !root.logged-in: LoginScreen {
        y: root.bar-h;
        height: root.height - root.bar-h;
        connecting: root.connecting;
        error <=> root.auth-error;
        login(username, password) => { root.login(username, password); }
        register(username, password) => { root.register(username, password); }
    }

    if root.logged-in: HorizontalLayout {
        y: root.bar-h;
        height: root.height - root.bar-h;
        // Coluna da esquerda: lista de conversas.
        Rectangle {
            width: 320px;
            background: Theme.surface-0;

            // Primeiro filho: fica atrás de todo o resto da coluna.
            if Modules.dither: Image {
                width: parent.width;
                height: parent.height;
                source: root.dither-frame;
                image-fit: fill;
                image-rendering: pixelated;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: "CONVERSAS";
                        font-family: Theme.pixel;
                        font-size: 26px;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                    Link {
                        text: root.creating-group ? "cancelar" : "+ grupo";
                        font-size: 22px;
                        vertical-alignment: center;
                        clicked => {
                            root.group-error = "";
                            root.creating-group = !root.creating-group;
                        }
                    }
                }

                if root.creating-group: VerticalLayout {
                    spacing: 8px;
                    FieldLabel { text: "nome do grupo"; }
                    group-name := Field {
                        accepted => {
                            root.group-error = "";
                            root.create-group(self.text);
                        }
                    }
                    ErrorLine { message: root.group-error; }
                    init => { group-name.focus(); }
                }

                VerticalLayout {
                    spacing: 4px;
                    Field {
                        placeholder: "conversar com... (usuário)";
                        text <=> root.direct-search;
                        accepted => {
                            root.stick-to-bottom = true;
                            root.open-direct(self.text);
                        }
                    }
                    if root.direct-error != "": Text {
                        text: "! " + root.direct-error;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for row in root.conversations: ConversationItem {
                        item: row;
                        clicked => {
                            // Conversa recém-aberta começa pelo fim.
                            root.stick-to-bottom = true;
                            root.open-conversation(row.id);
                        }
                    }
                }

                // Na chamada de outra conversa: dá para sair sem abrir ela.
                if root.call-name != "" && !root.call-is-open: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "▪ na chamada: " + root.call-name;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.call-connected: IconButton {
                        icon: root.call-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                        danger: root.call-muted;
                        tip: root.call-muted ? "ligar o microfone" : "mutar o microfone";
                        clicked => { root.toggle-mute(); }
                    }
                    IconButton {
                        icon: @image-url("icons/leave.svg");
                        danger: true;
                        tip: "sair da chamada";
                        clicked => { root.leave-call(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.user-name + " · " + root.status;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: Theme.ink-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: @image-url("icons/gear.svg");
                        active: root.settings-open;
                        tip: root.settings-open ? "fechar configurações" : "configurações";
                        clicked => {
                            root.settings-open = !root.settings-open;
                            if root.settings-open {
                                root.refresh-devices();
                            }
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/logout.svg");
                        tip: "sair da conta";
                        clicked => { root.logout(); }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        if root.settings-open: SettingsPanel {
            horizontal-stretch: 1;
            modules: root.modules;
            mic-options: root.mic-options;
            mic-choice: root.mic-choice;
            speaker-options: root.speaker-options;
            speaker-choice: root.speaker-choice;
            camera-options: root.camera-options;
            camera-choice: root.camera-choice;
            camera-testing: root.camera-testing;
            camera-test-frame: root.camera-test-frame;
            camera-test-status: root.camera-test-status;
            test-camera(on) => { root.test-camera(on); }
            toggle(id, on) => { root.toggle-module(id, on); }
            choose-device(kind, i) => { root.choose-device(kind, i); }
            close => { root.settings-open = false; }
        }

        // Coluna da direita: conversa aberta.
        if !root.settings-open: Rectangle {
            background: Theme.surface-1;
            horizontal-stretch: 1;

            VerticalLayout {
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        // Os botões de ícone têm 36px: sobra 14px em cima e embaixo.
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        Text {
                            text: root.open-title == "" ? "> escolha uma conversa" : root.open-title;
                            font-family: Theme.pixel;
                            font-size: 28px;
                            color: root.open-title == "" ? Theme.ink-muted : Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.can-call && !root.call-is-open: IconButton {
                            icon: @image-url("icons/phone.svg");
                            tip: "entrar na chamada";
                            clicked => { root.join-call(); }
                        }
                        if root.call-is-open && !root.call-connected: Text {
                            text: "entrando...";
                            font-family: Theme.pixel;
                            font-size: 22px;
                            color: Theme.ink-muted;
                            vertical-alignment: center;
                        }
                        if root.call-is-open && root.call-connected: HorizontalLayout {
                            spacing: 4px;
                            IconButton {
                                icon: root.call-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                                danger: root.call-muted;
                                tip: root.call-muted ? "ligar o microfone" : "mutar o microfone";
                                clicked => { root.toggle-mute(); }
                            }
                            IconButton {
                                icon: root.call-camera ? @image-url("icons/camera.svg") : @image-url("icons/camera-off.svg");
                                active: root.call-camera;
                                tip: root.call-camera ? "desligar a câmera" : "ligar a câmera";
                                clicked => { root.toggle-camera(); }
                            }
                            IconButton {
                                icon: @image-url("icons/screen.svg");
                                active: root.call-sharing || root.share-picker-open;
                                tip: root.call-sharing ? "parar de mostrar a tela" : "mostrar a tela ou uma janela";
                                clicked => {
                                    if root.call-sharing {
                                        root.stop-share();
                                    } else if root.share-picker-open {
                                        root.close-share-picker();
                                    } else {
                                        root.open-share-picker();
                                    }
                                }
                            }
                            mixer-button := IconButton {
                                icon: @image-url("icons/mixer.svg");
                                active: root.mixer-open;
                                tip: root.mixer-open ? "fechar o mixer" : "volume de cada pessoa";
                                clicked => {
                                    root.mixer-x = mixer-button.absolute-position.x + mixer-button.width;
                                    root.mixer-y = mixer-button.absolute-position.y + mixer-button.height + 6px;
                                    root.mixer-open = !root.mixer-open;
                                }
                            }
                        }
                        if root.call-is-open: IconButton {
                            icon: @image-url("icons/leave.svg");
                            danger: true;
                            tip: "sair da chamada";
                            clicked => { root.leave-call(); }
                        }
                        if root.open-is-group: IconButton {
                            icon: @image-url("icons/members.svg");
                            active: root.members-open;
                            tip: root.members-open ? "fechar membros" : "membros do grupo";
                            clicked => {
                                root.group-error = "";
                                root.show-members(!root.members-open);
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // Na chamada desta conversa: quem está nela, e quem fala em destaque.
                if root.call-is-open && root.call-connected && root.call-people.length > 0: Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;
                        for person in root.call-people: SpeakerTag {
                            name: person.name;
                            speaking: person.speaking;
                            menu(x, y) => {
                                if !person.is-me {
                                    root.open-menu(person.id, "", person.name, x, y);
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // O tile ampliado (uma tela compartilhada, ou uma câmera
                // clicada) ocupa a largura toda, até metade da janela.
                if root.call-is-open && root.big-tile != "": big := Rectangle {
                    height: min(root.height / 2, (self.width - 32px) * 9 / 16) + 16px;
                    for tile in root.video-tiles: Rectangle {
                        x: 16px;
                        y: 8px;
                        width: parent.width - 32px;
                        height: parent.height - 16px;
                        visible: tile.id == root.big-tile;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 2px;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: tile.frame;
                            image-fit: contain;
                        }
                        Rectangle {
                            x: 4px;
                            y: parent.height - self.height - 4px;
                            width: big-label.preferred-width + 8px;
                            height: big-label.preferred-height;
                            background: Theme.surface-0;
                            big-label := Text {
                                text: tile.name + " · clique para reduzir · botão direito: volume e tela cheia";
                                font-family: Theme.pixel;
                                font-size: 18px;
                                color: Theme.ink;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.big-tile = ""; }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.open-menu(tile.person, tile.id, tile.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // Câmeras e telas da chamada aberta, lado a lado em 16:9. Com
                // muita gente, os tiles encolhem para caber na largura. Clicar
                // num tile amplia ele.
                if root.call-is-open && root.video-tiles.length > 0: strip := Rectangle {
                    // Posição à mão em vez de HorizontalLayout: com layout, a
                    // largura dos tiles dependeria dela mesma.
                    property <length> tile-width: min(240px, (self.width - 32px - 8px * (root.video-tiles.length - 1)) / root.video-tiles.length);
                    height: self.tile-width * 9 / 16 + 16px;
                    for tile[i] in root.video-tiles: Rectangle {
                        x: 16px + i * (strip.tile-width + 8px);
                        y: 8px;
                        width: strip.tile-width;
                        height: strip.tile-width * 9 / 16;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: tile.id == root.big-tile ? Theme.ink : Theme.border;
                        border-radius: 2px;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: tile.frame;
                            image-fit: contain;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.big-tile = root.big-tile == tile.id ? "" : tile.id;
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.open-menu(tile.person, tile.id, tile.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        Rectangle {
                            x: 4px;
                            y: parent.height - self.height - 4px;
                            width: label.preferred-width + 8px;
                            height: label.preferred-height;
                            background: Theme.surface-0;
                            label := Text {
                                text: tile.name;
                                font-family: Theme.pixel;
                                font-size: 18px;
                                color: Theme.ink;
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // ScrollView em vez de ListView: a ListView estima a altura das
                // linhas que ainda não desenhou, e com mensagens de tamanhos
                // diferentes o "fim da lista" ficava no lugar errado.
                messages-scroll := ScrollView {
                    vertical-stretch: 1;

                    changed content-height => {
                        if root.stick-to-bottom {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        } else if root.keep-from-bottom {
                            // Entrou coisa em cima: desce o mesmo tanto para o texto
                            // que estava na tela não sair do lugar.
                            self.content-y -= self.content-height - root.last-content-height;
                        }
                        root.keep-from-bottom = false;
                        root.last-content-height = self.content-height;
                    }
                    changed visible-height => {
                        if root.stick-to-bottom {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                    }
                    changed content-y => {
                        // Uma folga pequena: chegar "quase" no fim já conta.
                        root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 8px;
                        if self.content-y >= -1px && root.has-older && !root.loading-older {
                            root.load-older();
                        }
                    }

                    VerticalLayout {
                        width: messages-scroll.visible-width;
                        // Sem isto, com poucas mensagens o layout estica cada uma
                        // até encher a tela.
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 8px;

                        if root.open-title != "": Text {
                            height: 36px;
                            text: root.loading-older ? "> carregando..."
                                : root.has-older ? "> role para cima para ver mais"
                                : "> início da conversa";
                            font-family: Theme.pixel;
                            font-size: 20px;
                            color: Theme.ink-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for row in root.messages: MessageItem {
                            item: row;
                            playing: row.audio-id != "" && row.audio-id == root.playing-id;
                            progress: self.playing ? root.playing-progress : 0;
                            elapsed: root.playing-time;
                            play-audio(id) => { root.play-audio(id); }
                            stop-audio => { root.stop-audio(); }
                            save-file(id, name) => { root.save-file(id, name); }
                        }
                    }
                }

                // Campo de mensagem com cara de terminal: "> " e cursor.
                Rectangle {
                    height: 80px;
                    Rectangle {
                        x: 16px;
                        y: 16px;
                        // Sobra lugar à direita para arquivo e microfone.
                        width: parent.width - 32px - 112px;
                        height: 48px;
                        border-radius: 2px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: input.has-focus ? Theme.ink : Theme.border-strong;

                        // Clicar em qualquer parte da caixa foca o campo.
                        TouchArea {
                            mouse-cursor: text;
                            clicked => { input.focus(); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text {
                                text: ">";
                                font-family: Theme.pixel;
                                font-size: 22px;
                                color: Theme.ink-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            input := TextInput {
                                horizontal-stretch: 1;
                                enabled: root.open-title != "";
                                font-family: Theme.sans;
                                font-size: 15px;
                                color: Theme.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => {
                                    root.send-message(self.text);
                                    self.text = "";
                                }
                            }
                        }

                        // Enquanto grava, o aviso cobre o campo de texto.
                        if root.recording: Rectangle {
                            border-radius: 2px;
                            background: Theme.surface-2;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                Rectangle {
                                    width: 10px;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: Theme.danger;
                                    }
                                }
                                Text {
                                    text: "gravando " + root.recording-time;
                                    font-family: Theme.pixel;
                                    font-size: 22px;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "solte para enviar · arraste para fora para cancelar";
                                    font-family: Theme.pixel;
                                    font-size: 20px;
                                    color: Theme.ink-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    file-button := Rectangle {
                        property <bool> enabled: root.open-title != "";
                        x: parent.width - 16px - 104px;
                        y: 16px;
                        width: 48px;
                        height: 48px;
                        border-radius: 2px;
                        opacity: self.enabled ? 1 : 0.5;
                        background: file-area.has-hover ? Theme.surface-2 : transparent;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        file-area := TouchArea {
                            enabled: file-button.enabled;
                            mouse-cursor: pointer;
                            clicked => {
                                Tip.text = "";
                                root.pick-file();
                            }
                            changed has-hover => {
                                if !self.has-hover {
                                    Tip.text = "";
                                }
                            }
                        }
                        Text {
                            text: "+";
                            font-family: Theme.pixel;
                            font-size: 26px;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // A mesma dica dos botões de ícone.
                        Timer {
                            interval: 450ms;
                            running: file-area.has-hover && Tip.text != "mandar imagem ou arquivo";
                            triggered => {
                                Tip.text = "mandar imagem ou arquivo";
                                Tip.x = file-button.absolute-position.x + file-button.width / 2;
                                Tip.y = file-button.absolute-position.y + file-button.height + 6px;
                            }
                        }
                    }

                    // Segure para gravar um áudio.
                    mic := Rectangle {
                        property <bool> enabled: root.open-title != "";
                        x: parent.width - 16px - 48px;
                        y: 16px;
                        width: 48px;
                        height: 48px;
                        border-radius: 2px;
                        opacity: self.enabled ? 1 : 0.5;
                        background: root.recording ? Theme.ink
                            : mic-area.has-hover ? Theme.surface-2 : transparent;
                        border-width: 1px;
                        border-color: root.recording ? Theme.ink : Theme.border-strong;

                        mic-area := TouchArea {
                            enabled: mic.enabled;
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if !self.has-hover {
                                    Tip.text = "";
                                }
                            }
                            pointer-event(event) => {
                                if event.button != PointerEventButton.left {
                                    return;
                                }
                                if event.kind == PointerEventKind.down {
                                    Tip.text = "";
                                    root.start-recording();
                                } else if event.kind == PointerEventKind.up {
                                    // Soltou ainda em cima do botão: envia.
                                    if self.mouse-x >= 0 && self.mouse-x <= self.width
                                        && self.mouse-y >= 0 && self.mouse-y <= self.height {
                                        root.stop-recording();
                                    } else {
                                        root.cancel-recording();
                                    }
                                } else if event.kind == PointerEventKind.cancel {
                                    root.cancel-recording();
                                }
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/mic.svg");
                            colorize: root.recording ? Theme.surface-0 : Theme.ink;
                        }
                        Timer {
                            interval: 450ms;
                            running: mic-area.has-hover && !root.recording && Tip.text != "segure para gravar um áudio";
                            triggered => {
                                Tip.text = "segure para gravar um áudio";
                                Tip.x = mic.absolute-position.x + mic.width / 2;
                                Tip.y = mic.absolute-position.y + mic.height + 6px;
                            }
                        }
                    }
                }
            }
        }

        if root.members-open && root.open-is-group && !root.settings-open: MembersPanel {
            members: root.members;
            error: root.group-error;
            invite(username) => {
                root.group-error = "";
                root.invite(username);
            }
            remove(id) => {
                root.group-error = "";
                root.remove-member(id);
            }
            leave => { root.leave-group(); }
        }
    }
    // Por cima da conversa (a lista de conversas continua à vista).
    if root.logged-in && root.share-picker-open && root.call-is-open && !root.settings-open: SharePicker {
        x: 320px;
        y: root.bar-h;
        width: root.width - 320px;
        height: root.height - root.bar-h;
        screens: root.share-screens;
        windows: root.share-windows;
        audio-supported: root.share-audio-supported;
        audio <=> root.share-audio;
        pick(id, audio) => { root.start-share(id, audio); }
        close => { root.close-share-picker(); }
    }

    // Um vídeo em tela cheia, por cima de tudo.
    if root.logged-in && root.call-is-open && root.full-tile != "": Rectangle {
        background: #000000;
        for tile in root.video-tiles: Rectangle {
            visible: tile.id == root.full-tile;
            Image {
                width: 100%;
                height: 100%;
                source: tile.frame;
                image-fit: contain;
            }
            TouchArea {
                double-clicked => { root.full-tile = ""; }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.open-menu(tile.person, tile.id, tile.name, self.mouse-x, self.mouse-y);
                    }
                }
            }
            Rectangle {
                x: 8px;
                y: parent.height - self.height - 8px;
                width: full-label.preferred-width + 12px;
                height: full-label.preferred-height + 4px;
                background: Theme.surface-0;
                full-label := Text {
                    text: tile.name + " · esc ou clique duplo para sair";
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink;
                }
            }
        }
        full-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.full-tile = "";
                    return accept;
                }
                reject
            }
        }
        init => { full-keys.focus(); }
    }

    // O mixer, embaixo do botão dele. Clicar fora (com qualquer botão) fecha.
    if root.logged-in && root.mixer-open && root.call-is-open && root.call-connected: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-open = false;
                }
            }
        }
        Mixer {
            x: max(8px, min(root.width - self.width - 8px, root.mixer-x - self.width));
            y: root.mixer-y;
            people: root.call-people;
            set-volume(id, screen, v) => { root.set-volume(id, screen, v); }
            close => { root.mixer-open = false; }
        }
    }

    // O menu do botão direito. Clicar fora (com qualquer botão) fecha.
    if root.logged-in && root.menu-open && root.call-is-open: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.menu-open = false;
                }
            }
        }
        if root.menu-person == "": CallMenu {
            x: max(8px, min(root.width - self.width - 8px, root.menu-x));
            y: max(8px, min(root.height - self.height - 8px, root.menu-y));
            title: root.menu-title;
            has-person: false;
            tile: root.menu-tile;
            full: root.menu-tile != "" && root.menu-tile == root.full-tile;
            toggle-full => { root.full-tile = root.full-tile == root.menu-tile ? "" : root.menu-tile; }
            close => { root.menu-open = false; }
        }
        for person in root.call-people: CallMenu {
            visible: person.id == root.menu-person;
            x: max(8px, min(root.width - self.width - 8px, root.menu-x));
            y: max(8px, min(root.height - self.height - 8px, root.menu-y));
            title: root.menu-title;
            has-person: true;
            person: person;
            tile: root.menu-tile;
            full: root.menu-tile != "" && root.menu-tile == root.full-tile;
            set-volume(id, screen, v) => { root.set-volume(id, screen, v); }
            toggle-full => { root.full-tile = root.full-tile == root.menu-tile ? "" : root.menu-tile; }
            close => { root.menu-open = false; }
        }
    }

    // Bordas de mudar o tamanho (a janela não tem moldura). Ficam por cima
    // do resto, mas são finas; somem com a janela maximizada ou em tela cheia.
    if !root.window-maximized && root.full-tile == "": Rectangle {
        property <length> e: 5px;
        ResizeEdge { dir: "n"; x: parent.e; y: 0; width: root.width - 2 * parent.e; height: parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "s"; x: parent.e; y: root.height - parent.e; width: root.width - 2 * parent.e; height: parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "w"; x: 0; y: parent.e; width: parent.e; height: root.height - 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "e"; x: root.width - parent.e; y: parent.e; width: parent.e; height: root.height - 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "nw"; x: 0; y: 0; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "ne"; x: root.width - 2 * parent.e; y: 0; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "sw"; x: 0; y: root.height - 2 * parent.e; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "se"; x: root.width - 2 * parent.e; y: root.height - 2 * parent.e; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
    }

    // A dica dos botões de ícone, por último para ficar por cima de tudo.
    // Embaixo do botão; sem espaço embaixo, em cima dele.
    if Tip.text != "": Rectangle {
        property <length> w: tip-text.preferred-width + 16px;
        x: max(4px, min(root.width - self.w - 4px, Tip.x - self.w / 2));
        y: Tip.y + self.height + 4px > root.height ? Tip.y - self.height - 48px : Tip.y;
        width: self.w;
        height: 28px;
        background: Theme.ink;
        border-radius: 2px;
        tip-text := Text {
            x: 8px;
            height: parent.height;
            text: Tip.text;
            font-family: Theme.pixel;
            font-size: 20px;
            color: Theme.surface-0;
            vertical-alignment: center;
        }
    }
}
