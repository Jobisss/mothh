// Interface do mothh. Os valores de cor e fonte seguem docs/design-system.md.
//
// Dica: `slint-viewer ui/app.slint --auto-reload` mostra a tela e recarrega
// a cada mudança, sem recompilar o Rust.

import { ListView, ScrollView } from "std-widgets.slint";
import "fonts/VT323-Regular.ttf";
import "fonts/Geist-Regular.ttf";
import "fonts/Geist-SemiBold.ttf";
// Opções de fonte das configurações (V6-05, `fonts.rs`).
import "fonts/ShareTechMono-Regular.ttf";
import "fonts/Silkscreen-Regular.ttf";
import "fonts/DotGothic16-Regular.ttf";
import "fonts/AtkinsonHyperlegible-Regular.ttf";
import "fonts/FiraSans-Regular.ttf";
import "fonts/Lato-Regular.ttf";

// Alguém numa chamada, para quem está de fora ver: foto ou inicial, e o
// nome na dica.
export struct CallFace {
    id: string,
    name: string,
    initial: string,
    photo: image,
    has-photo: bool,
}

export struct ConversationRow {
    id: string,
    name: string,
    initial: string,
    preview: string,
    time: string,
    is-group: bool,
    selected: bool,
    // "▪ 3 na sala" quando há gente na chamada do grupo; vazio se não.
    in-call: string,
    // Conversa direta: a foto da outra pessoa, quando ela tem.
    photo: image,
    has-photo: bool,
    // Quem está na chamada (vazio com servidor antigo, que só manda a conta).
    call-faces: [CallFace],
}

// Um quadro de vídeo na chamada: câmera ou tela. `id` vazio é a própria
// câmera; os de tela terminam em "#tela".
export struct VideoTile {
    id: string,
    name: string,
    frame: image,
    // De quem é (id da pessoa); vazio nos nossos.
    person: string,
    // A tela de alguém que ainda não estamos assistindo: sem vídeo, só o
    // convite. Clicar começa a baixar.
    waiting: bool,
}

// Uma tela ou janela que dá para compartilhar, com a foto dela quando
// já chegou. `detail` é o tamanho da tela ("1920×1080").
export struct ShareSourceRow {
    id: string,
    name: string,
    detail: string,
    has-preview: bool,
    preview: image,
}

export struct MessageRow {
    // Id da mensagem no servidor, para editar e apagar.
    id: string,
    // É minha: aparecem "editar" e "apagar" ao passar o mouse.
    mine: bool,
    // O texto foi trocado depois de enviada.
    edited: bool,
    author-photo: image,
    author-initial: string,
    author: string,
    // Id de quem mandou: clicar no nome abre o cartão da pessoa.
    author-id: string,
    time: string,
    text: string,
    // Mesma pessoa, menos de 5 min depois da anterior: sem nome e horário.
    continues: bool,
    // Mensagem de áudio: id do anexo e duração ("0:10"). Vazio no texto.
    audio-id: string,
    duration: string,
    file-id: string,
    file-name: string,
    file-size: string,
    is-image: bool,
    preview-ready: bool,
    preview-image: image,
}

// O perfil de alguém, como o cartão e a página mostram (`profiles.rs`).
// As imagens (foto grande, fundo, artes) vêm à parte, porque GIF troca de
// quadro o tempo todo.
export struct ProfileViewData {
    listening-title: string,
    listening-artist: string,
    listening-elapsed: string,
    listening-duration: string,
    listening-progress: float,
    id: string,
    is-me: bool,
    name: string,
    initial: string,
    // "nome real · de onde" (vazio se a pessoa não pôs).
    sub: string,
    about: string,
    has-accent: bool,
    accent: color,
    // "no mothh desde nov de 2026".
    member-since: string,
    // Nome da conversa em cuja chamada a pessoa está (vazio: nenhuma).
    in-call: string,
    show-art: bool,
    show-about: bool,
    // A página completa chegou do servidor.
    full: bool,
    // Pedimos ao servidor e esperamos.
    loading: bool,
}

export struct MemberRow {
    id: string,
    name: string,
    is-owner: bool,
    // Quem vê é o dono e esta linha não é a dele.
    can-remove: bool,
    // Está falando na chamada deste grupo agora (F2-04).
    speaking: bool,
}

// Uma pessoa na chamada em que estamos, com o volume dela para nós
// (0 a 200, em %): a voz e o som da tela, se ela está mandando.
export struct CallPersonRow {
    id: string,
    name: string,
    // Primeira letra do nome, para quem ainda não tem foto.
    initial: string,
    photo: image,
    has-photo: bool,
    // Nível da voz agora, de 0 a 1, medido no app (levels.rs); a borda da
    // foto cresce com ele.
    level: float,
    speaking: bool,
    // Microfone desligado.
    muted: bool,
    // Conexão como o LiveKit mede: 0 sem medida, 1 caiu, 2 ruim, 3 boa, 4 ótima.
    quality: int,
    // Só na sua linha: ping até o servidor de chamadas, em ms (0: sem medida).
    ping: int,
    is-me: bool,
    voice: int,
    screen-audio: bool,
    screen: int,
}

export struct ModuleRow {
    id: string,
    name: string,
    description: string,
    on: bool,
}

export struct MusicViewData {
    video-id: string,
    conversation-id: string, panel-open: bool, has-track: bool,
    title: string, subtitle: string, status: string, detail: string, error: string,
    playing: bool, buffering: bool, can-control: bool, online: bool, listening: bool,
    connecting: bool, submitting: bool, volume: int,
    position-ms: float, duration-ms: float, queued: int,
}

export struct MusicQueueRow {
    id: string, title: string, detail: string, failed: bool, can-remove: bool,
}

// O que está ligado no registro de módulos (modules.rs). O Rust escreve aqui
// ao abrir o app e a cada interruptor; o resto da tela só lê, e módulo
// desligado não aparece.
export global Modules {
    in-out property <bool> dither: true;
    in-out property <bool> received-sound: true;
    in-out property <bool> call-sound: true;
    in-out property <bool> music: true;
}

// Exportado porque o Rust troca as fontes (`fonts.rs`); as cores só leem.
export global Theme {
    out property <color> surface-0: #0a0a0a;
    out property <color> surface-1: #111111;
    out property <color> surface-2: #1a1a1a;
    out property <color> surface-3: #262626;
    out property <color> border: #262626;
    out property <color> border-strong: #6b6b6b;
    out property <color> ink: #f2f2f2;
    out property <color> ink-muted: #9a9a9a;
    out property <color> danger: #ff5a4f;
    // As famílias escolhidas nas configurações; o padrão é o do design system.
    in-out property <string> pixel: "VT323";
    in-out property <string> sans: "Geist";
    // Cada fonte tem a sua proporção: os tamanhos em px deste arquivo foram
    // pensados para a VT323 (estreita) e a Geist; as outras entram com um
    // fator menor para ocupar o mesmo espaço (`fonts.rs`).
    in-out property <float> pixel-scale: 1.0;
    in-out property <float> sans-scale: 1.0;
}

// Rostinho de alguém numa chamada: foto (ou inicial) num quadrado, com o
// nome na dica quando o mouse para em cima.
component FaceChip inherits Rectangle {
    in property <CallFace> face;
    in property <length> size: 28px;
    // Dentro da linha da conversa, clicar no rostinho abre a conversa.
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: 2px;
    background: Theme.surface-3;
    border-width: 1px;
    border-color: Theme.border-strong;
    clip: true;

    if root.face.has-photo: Image {
        width: parent.width;
        height: parent.height;
        source: root.face.photo;
        image-fit: cover;
    }
    if !root.face.has-photo: Text {
        text: root.face.initial;
        font-family: Theme.pixel;
        font-size: (root.size * 0.75) * Theme.pixel-scale;
        color: Theme.ink-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if !self.has-hover && Tip.text == root.face.name {
                Tip.text = "";
            }
        }
    }
    Timer {
        interval: 350ms;
        running: area.has-hover && Tip.text != root.face.name;
        triggered => {
            Tip.text = root.face.name;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 4px;
        }
    }
}

component ConversationItem inherits Rectangle {
    in property <ConversationRow> item;
    callback clicked();

    height: 64px;
    border-radius: 4px;
    background: item.selected ? Theme.surface-3 : area.has-hover ? Theme.surface-2 : transparent;

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: item.is-group ? 4px : 22px;
            background: Theme.surface-3;
            border-width: 1px;
            border-color: Theme.border-strong;
            clip: true;
            if item.has-photo: Image {
                width: parent.width;
                height: parent.height;
                source: item.photo;
                image-fit: cover;
            }
            if !item.has-photo: Text {
                text: item.initial;
                font-family: Theme.pixel;
                font-size: 26px * Theme.pixel-scale;
                color: Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.name;
                    font-family: Theme.pixel;
                    font-size: 24px * Theme.pixel-scale;
                    color: Theme.ink;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: item.time;
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: item.preview;
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // Quem está na chamada, mesmo sem entrar nela: os rostinhos
                // (até quatro) e a conta.
                if item.in-call != "": HorizontalLayout {
                    spacing: 2px;
                    for face[i] in item.call-faces: FaceChip {
                        visible: i < 4;
                        width: i < 4 ? 20px : 0px;
                        face: face;
                        size: 20px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.clicked(); }
                    }
                    Text {
                        // Grupo: a conta. Direta: "te chamando" ou "em chamada".
                        text: item.is-group && item.call-faces.length > 0 ? " " + item.call-faces.length
                            : item.call-faces.length > 0 ? " " + item.in-call : item.in-call;
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Player de uma mensagem de áudio: tocar/parar, barra e duração.
component AudioPlayer inherits Rectangle {
    in property <bool> playing;
    // De 0 a 1, quanto já tocou.
    in property <float> progress;
    in property <string> duration;
    // Quanto já tocou ("0:03"), enquanto toca.
    in property <string> elapsed;
    callback play();
    callback stop();

    width: 280px;
    height: 40px;
    border-radius: 2px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: area.has-hover || root.playing ? Theme.ink : Theme.border-strong;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.playing {
                root.stop();
            } else {
                root.play();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // Triângulo para tocar, quadrado para parar. Desenhados, porque a
        // VT323 não tem esses símbolos.
        Rectangle {
            width: 12px;
            if !root.playing: Path {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 14px;
                viewbox-width: 12;
                viewbox-height: 14;
                commands: "M 0 0 L 12 7 L 0 14 Z";
                fill: Theme.ink;
            }
            if root.playing: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 11px;
                height: 11px;
                background: Theme.ink;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 2px;
                background: Theme.border-strong;
            }
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width * clamp(root.progress, 0, 1);
                height: 2px;
                background: Theme.ink;
            }
        }

        Text {
            text: root.playing ? root.elapsed + " / " + root.duration : root.duration;
            font-family: Theme.pixel;
            font-size: 20px * Theme.pixel-scale;
            color: Theme.ink-muted;
            vertical-alignment: center;
        }
    }
}

// Campo de texto com cara de terminal: "> " na frente e borda clara no foco.
component Field inherits Rectangle {
    in property <bool> password;
    // Texto cinza que aparece com o campo vazio.
    in property <string> placeholder;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted();
    forward-focus: input;

    height: 48px;
    border-radius: 2px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.ink : Theme.border-strong;

    // Clicar em qualquer parte da caixa foca o campo.
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            text: ">";
            font-family: Theme.pixel;
            font-size: 22px * Theme.pixel-scale;
            color: Theme.ink-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                enabled: root.enabled;
                input-type: root.password ? InputType.password : InputType.text;
                font-family: Theme.sans;
                font-size: 15px * Theme.sans-scale;
                color: Theme.ink;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
            }
            if input.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Botão principal (fundo claro) ou secundário (só a borda).
component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    border-radius: 2px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary
        ? (area.has-hover ? Theme.ink-muted : Theme.ink)
        : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.primary ? Theme.ink : Theme.border-strong;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-family: Theme.pixel;
        font-size: 24px * Theme.pixel-scale;
        color: root.primary ? Theme.surface-0 : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FieldLabel inherits Text {
    font-family: Theme.pixel;
    font-size: 22px * Theme.pixel-scale;
    color: Theme.ink-muted;
}

// Texto clicável pequeno, como o "sair" do rodapé.
component Link inherits Text {
    callback clicked();
    out property <bool> link-hover: link-area.has-hover;
    font-family: Theme.pixel;
    font-size: 20px * Theme.pixel-scale;
    color: link-area.has-hover ? Theme.ink : Theme.ink-muted;
    link-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Dica que aparece embaixo de um botão de ícone. A janela desenha ela por
// cima de tudo; o botão só escreve aqui depois de um tempo com o mouse em
// cima, e apaga quando o mouse sai.
global Tip {
    in-out property <string> text;
    // Meio da borda de baixo do botão, em coordenadas da janela.
    in-out property <length> x;
    in-out property <length> y;
}

// Botão quadrado só com ícone; o que ele faz aparece na dica. `active`:
// ligado (câmera ligada, tela sendo mostrada), fica invertido. `danger`:
// vermelho (microfone mudo, sair da chamada).
component IconButton inherits Rectangle {
    in property <bool> model-icon;
    in property <image> icon;
    in property <string> tip;
    in property <bool> active;
    in property <bool> danger;
    in property <bool> enabled: true;
    // Lado do quadrado; o ícone ocupa dois terços.
    in property <length> size: 36px;
    opacity: root.enabled ? 1 : 0.3;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 2px;
    background: root.active && !root.model-icon ? Theme.ink : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.ink : (area.has-hover ? Theme.border-strong : transparent);

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.model-icon ? 36px : root.size * 2 / 3;
        height: root.model-icon ? 32px : root.size * 2 / 3;
        source: root.icon;
        image-rendering: root.model-icon ? pixelated : smooth;
        colorize: root.model-icon ? transparent : root.active ? Theme.surface-0
            : root.danger ? Theme.danger
            : (area.has-hover ? Theme.ink : Theme.ink-muted);
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            // O botão costuma mudar de dica ao clicar (ligar vira desligar).
            Tip.text = "";
            root.clicked();
        }
        changed has-hover => {
            if !self.has-hover && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }

    Timer {
        interval: 450ms;
        running: area.has-hover && Tip.text != root.tip;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 6px;
        }
    }
}

component MessageItem inherits Rectangle {
    in property <MessageRow> item;
    // Este áudio é o que está tocando agora.
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    callback play-audio(string);
    callback stop-audio();
    callback save-file(string, string);
    callback view-image(string, string);
    // Clicou no nome de quem mandou: id, nome e onde (na janela).
    callback author-clicked(string, string, length, length);
    // "editar" numa mensagem minha: id e o texto de agora, para o campo.
    callback edit(string, string);
    // "apagar", já confirmado na própria mensagem.
    callback delete(string);
    // Clicou em "apagar" uma vez: a mensagem pergunta antes de apagar.
    property <bool> confirming;
    property <bool> is-text: item.audio-id == "" && item.file-id == "";
    // A linha com o mouse em cima fica marcada, para se ver de qual
    // mensagem são os botões.
    border-radius: 2px;
    background: hover.has-hover && item.mine ? Theme.surface-2 : transparent;

    // Envolve tudo: a TouchArea marca `has-hover` antes de os filhos verem
    // o mouse, então o texto selecionável e os botões contam como "em cima".
    hover := TouchArea {
        changed has-hover => { if !self.has-hover { root.confirming = false; } }

    VerticalLayout {
    // Bloco novo ganha espaço em cima; continuação fica colada na anterior.
    padding-top: item.continues ? 0px : 10px;
    padding-bottom: 2px;
    spacing: 2px;

    if !item.continues: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 24px;
            height: 24px;
            background: Theme.surface-3;
            border-radius: 2px;
            clip: true;
            if item.author-photo.width > 0: Image { width: parent.width; height: parent.height; source: item.author-photo; image-fit: cover; }
            if item.author-photo.width == 0: Text { text: item.author-initial; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; font-family: Theme.pixel; font-size: 20px * Theme.pixel-scale; }
            TouchArea {
                enabled: item.author-id != "";
                mouse-cursor: pointer;
                clicked => { root.author-clicked(item.author-id, item.author, self.absolute-position.x, self.absolute-position.y); }
            }
        }
        Rectangle {
            width: author-text.preferred-width;
            author-text := Text {
                text: item.author;
                font-family: Theme.pixel;
                font-size: 22px * Theme.pixel-scale;
                color: Theme.ink;
            }
            Rectangle {
                y: parent.height - 3px;
                height: 1px;
                background: author-area.has-hover && item.author-id != "" ? Theme.ink : transparent;
            }
            author-area := TouchArea {
                enabled: item.author-id != "";
                mouse-cursor: pointer;
                clicked => {
                    root.author-clicked(item.author-id, item.author,
                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        Text {
            text: item.time;
            font-family: Theme.pixel;
            font-size: 18px * Theme.pixel-scale;
            color: Theme.ink-muted;
            vertical-alignment: bottom;
        }
    }
    // TextInput só de leitura, e não Text: assim dá para selecionar com o
    // mouse e copiar com Ctrl+C. Sem cursor nem edição.
    if root.is-text: TextInput {
        text: item.text;
        read-only: true;
        // Sem o cursor piscando ao clicar: só a seleção aparece.
        text-cursor-width: 0;
        single-line: false;
        wrap: word-wrap;
        font-family: Theme.sans;
        font-size: 15px * Theme.sans-scale;
        color: Theme.ink;
        selection-background-color: Theme.ink;
        selection-foreground-color: Theme.surface-0;
    }
    if root.is-text && item.edited: Text {
        text: "editada";
        font-family: Theme.pixel;
        font-size: 16px * Theme.pixel-scale;
        color: Theme.ink-muted;
    }
    if item.audio-id != "": HorizontalLayout {
        alignment: start;
        padding-top: 2px;
        padding-bottom: 2px;
        AudioPlayer {
            playing: root.playing;
            progress: root.progress;
            elapsed: root.elapsed;
            duration: item.duration;
            play => { root.play-audio(item.audio-id); }
            stop => { root.stop-audio(); }
        }
    }
    if item.file-id != "": Rectangle {
        width: 260px;
        height: item.is-image ? 210px : 64px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: Theme.surface-2;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            if !item.is-image: Text {
                text: item.file-name;
                font-family: Theme.sans;
                font-size: 14px * Theme.sans-scale;
                color: Theme.ink;
                overflow: elide;
            }
            if item.is-image && item.preview-ready: Image {
                source: item.preview-image;
                width: 240px;
                height: 170px;
                image-fit: contain;
            }
            if item.is-image && !item.preview-ready: Text {
                text: "carregando imagem...";
                height: 170px;
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            Text {
                text: item.file-size + (item.is-image ? "  ·  abrir imagem" : "  ·  baixar");
                font-family: Theme.pixel;
                font-size: 18px * Theme.pixel-scale;
                color: Theme.ink-muted;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { if item.is-image { root.view-image(item.file-id, item.file-name); } else { root.save-file(item.file-id, item.file-name); } }
        }
    }
    }

        // Botões de editar e apagar, no canto direito, só com o mouse em cima.
        if item.mine && hover.has-hover && !root.confirming: HorizontalLayout {
            // Sem largura explícita, o layout iria até a borda do pai e
            // espalharia os filhos para fora da tela.
            width: self.preferred-width;
            x: parent.width - self.width - 4px;
            y: item.continues ? -2px : 6px;
            spacing: 2px;
            if root.is-text: IconButton {
                size: 26px;
                icon: @image-url("icons/pencil.svg");
                tip: "editar";
                clicked => { root.edit(item.id, item.text); }
            }
            IconButton {
                size: 26px;
                icon: @image-url("icons/close.svg");
                tip: "apagar";
                clicked => { root.confirming = true; }
            }
        }
        if root.confirming: HorizontalLayout {
            width: self.preferred-width;
            x: parent.width - self.width - 4px;
            y: item.continues ? -2px : 6px;
            height: 28px;
            spacing: 12px;
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: "apagar para todo mundo?";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
                vertical-alignment: center;
            }
            Link {
                text: "[ apagar ]";
                color: Theme.danger;
                vertical-alignment: center;
                clicked => { root.confirming = false; root.delete(item.id); }
            }
            Link {
                text: "cancelar";
                vertical-alignment: center;
                clicked => { root.confirming = false; }
            }
        }
    }
}

// Quem está na chamada: a foto (ou a inicial do nome) num quadrado. Quem
// fala ganha uma borda clara que cresce com o volume da voz, medido aqui no
// app, então anda junto com o som. O nome aparece na dica, com o mouse em
// cima. O tamanho do quadrado não muda: nada na faixa pula de lugar.
component CallAvatar inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <image> photo;
    in property <bool> has-photo;
    in property <float> level;
    in property <bool> speaking;
    in property <bool> muted;
    in property <int> quality;
    in property <int> ping;
    // Botão direito: abre o menu de volume, onde está o ponteiro.
    callback menu(length, length);
    // Clique: abre o cartão da pessoa.
    callback clicked(length, length);

    property <string> quality-text: root.quality == 1 ? "caiu" : root.quality == 2 ? "conexão ruim"
        : root.quality == 3 ? "conexão boa" : root.quality == 4 ? "conexão ótima" : "";
    property <string> tip: root.name
        + (root.muted ? " · mutado" : "")
        + (root.quality-text != "" ? " · " + root.quality-text : "")
        + (root.ping > 0 ? " · ping " + root.ping + " ms" : "");

    // Até 5px de borda em volta da foto de 32px.
    property <length> ring: root.level > 0.01 ? 1px + root.level * 4px : (root.speaking ? 1px : 0px);
    width: 42px;
    height: 42px;

    // A borda: um quadrado claro atrás da foto, maior que ela.
    Rectangle {
        x: 5px - root.ring;
        y: 5px - root.ring;
        width: 32px + 2 * root.ring;
        height: 32px + 2 * root.ring;
        border-radius: 3px;
        background: root.ring > 0 ? Theme.ink : transparent;
    }

    Rectangle {
        x: 5px;
        y: 5px;
        width: 32px;
        height: 32px;
        border-radius: 2px;
        background: Theme.surface-2;
        border-width: root.ring > 0 ? 0px : 1px;
        border-color: Theme.border-strong;
        clip: true;

        if root.has-photo: Image {
            width: parent.width;
            height: parent.height;
            source: root.photo;
            image-fit: cover;
        }
        if !root.has-photo: Text {
            text: root.initial;
            font-family: Theme.pixel;
            font-size: 24px * Theme.pixel-scale;
            color: Theme.ink-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Mutado: microfone cortado no canto de baixo.
    if root.muted: Rectangle {
        x: 25px;
        y: 25px;
        width: 16px;
        height: 16px;
        border-radius: 2px;
        background: Theme.surface-0;
        border-width: 1px;
        border-color: Theme.danger;
        Image {
            width: 12px;
            height: 12px;
            x: 2px;
            y: 2px;
            source: @image-url("icons/mic-off.svg");
            colorize: Theme.danger;
        }
    }

    // Conexão: três barrinhas no canto de cima (vermelhas quando ruim).
    if root.quality > 0: Rectangle {
        x: 28px;
        y: 1px;
        width: 13px;
        height: 11px;
        border-radius: 1px;
        background: Theme.surface-0;
        for i in 3: Rectangle {
            x: 2px + i * 4px;
            y: 9px - (i + 1) * 2px - 1px;
            width: 2px;
            height: (i + 1) * 2px + 1px;
            background: root.quality <= 2 ? (i < root.quality - 1 ? Theme.danger : Theme.surface-3)
                : (i < root.quality - 1 ? Theme.ink : Theme.surface-3);
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.text = "";
            root.clicked(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                Tip.text = "";
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        changed has-hover => {
            if !self.has-hover && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }

    Timer {
        interval: 350ms;
        running: area.has-hover && Tip.text != root.tip;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 4px;
        }
    }
}

// Reação de alguém na tela cheia: a câmera, se a pessoa ligou, ou a foto
// (a inicial) no meio. A borda cresce com a voz, como na faixa da chamada.
component ReactionTile inherits Rectangle {
    in property <CallPersonRow> person;
    in property <[VideoTile]> tiles;

    property <length> ring: root.person.level > 0.01 ? 2px + root.person.level * 5px
        : (root.person.speaking ? 2px : 0px);
    property <length> face: min(64px, root.height - 28px);

    // A borda: um retângulo claro atrás do quadro, maior que ele.
    Rectangle {
        x: -root.ring;
        y: -root.ring;
        width: root.width + 2 * root.ring;
        height: root.height + 2 * root.ring;
        border-radius: 3px;
        background: root.ring > 0 ? Theme.ink : transparent;
    }

    Rectangle {
        background: Theme.surface-1;
        border-radius: 2px;
        border-width: root.ring > 0 ? 0px : 1px;
        border-color: Theme.border-strong;
        clip: true;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 6px;
            width: root.face;
            height: root.face;
            border-radius: 2px;
            background: Theme.surface-2;
            clip: true;
            if root.person.has-photo: Image {
                width: parent.width;
                height: parent.height;
                source: root.person.photo;
                image-fit: cover;
            }
            if !root.person.has-photo: Text {
                text: root.person.initial;
                font-family: Theme.pixel;
                font-size: (root.face * 0.75) * Theme.pixel-scale;
                color: Theme.ink-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // A câmera, por cima da foto (o tile da câmera tem o id da pessoa).
        for tile in root.tiles: Rectangle {
            visible: tile.id == root.person.id && !tile.waiting;
            background: #000000;
            Image {
                width: 100%;
                height: 100%;
                source: tile.frame;
                image-fit: cover;
            }
        }

        Rectangle {
            x: 4px;
            y: parent.height - self.height - 4px;
            width: min(parent.width - 8px, reaction-name.preferred-width + 8px);
            height: reaction-name.preferred-height;
            background: Theme.surface-0;
            reaction-name := Text {
                x: 4px;
                width: parent.width - 8px;
                text: root.person.name;
                font-family: Theme.pixel;
                font-size: 18px * Theme.pixel-scale;
                color: Theme.ink;
                overflow: elide;
            }
        }

        if root.person.muted: Rectangle {
            x: parent.width - self.width - 4px;
            y: 4px;
            width: 18px;
            height: 18px;
            border-radius: 2px;
            background: Theme.surface-0;
            border-width: 1px;
            border-color: Theme.danger;
            Image {
                x: 3px;
                y: 3px;
                width: 12px;
                height: 12px;
                source: @image-url("icons/mic-off.svg");
                colorize: Theme.danger;
            }
        }
    }
}

// Volume de 0% a 200%, com um risco no 100%. Arrastar ou rolar a roda
// muda; perto do 100% ele gruda no 100%; clique duplo volta para 100%.
component VolumeSlider inherits Rectangle {
    in property <bool> vertical;
    in property <int> value;
    // Fim da escala e o ponto que gruda (o risco): 200 e 100 no volume.
    in property <int> max: 200;
    in property <int> snap: 100;
    callback moved-to(int);

    property <float> ratio: root.value / root.max;
    property <length> track: (root.vertical ? root.height : root.width) - 12px;

    function pick(pos: length) {
        let r = clamp(root.vertical ? 1 - (pos - 6px) / root.track : (pos - 6px) / root.track, 0, 1);
        let v = round(r * root.max);
        root.moved-to(abs(v - root.snap) <= root.max * 3 / 100 ? root.snap : v);
    }

    // Trilho, parte cheia e o risco do 100%.
    Rectangle {
        x: root.vertical ? (root.width - 4px) / 2 : 6px;
        y: root.vertical ? 6px : (root.height - 4px) / 2;
        width: root.vertical ? 4px : root.track;
        height: root.vertical ? root.track : 4px;
        background: Theme.surface-3;
    }
    Rectangle {
        x: root.vertical ? (root.width - 4px) / 2 : 6px;
        y: root.vertical ? 6px + root.track * (1 - root.ratio) : (root.height - 4px) / 2;
        width: root.vertical ? 4px : root.track * root.ratio;
        height: root.vertical ? root.track * root.ratio : 4px;
        background: Theme.ink;
    }
    Rectangle {
        x: root.vertical ? (root.width - 16px) / 2 : 6px + root.track * root.snap / root.max - 1px;
        y: root.vertical ? 6px + root.track * (1 - root.snap / root.max) - 1px : (root.height - 16px) / 2;
        width: root.vertical ? 16px : 2px;
        height: root.vertical ? 2px : 16px;
        background: Theme.border-strong;
    }
    Rectangle {
        width: root.vertical ? 22px : 10px;
        height: root.vertical ? 10px : 22px;
        x: root.vertical ? (root.width - self.width) / 2 : 6px + root.track * root.ratio - self.width / 2;
        y: root.vertical ? 6px + root.track * (1 - root.ratio) - self.height / 2 : (root.height - self.height) / 2;
        border-radius: 1px;
        border-width: 2px;
        border-color: Theme.ink;
        background: area.pressed || area.has-hover ? Theme.ink : Theme.surface-0;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pick(root.vertical ? self.mouse-y : self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.pick(root.vertical ? self.mouse-y : self.mouse-x);
            }
        }
        double-clicked => { root.moved-to(root.snap); }
        scroll-event(event) => {
            if event.delta-y == 0 {
                return reject;
            }
            root.moved-to(clamp(root.value + (event.delta-y > 0 ? 5 : -5), 0, root.max));
            accept
        }
    }
}

// Uma coluna do mixer: o volume em cima, o slider e o nome embaixo.
component MixerStrip inherits VerticalLayout {
    in property <string> name;
    in property <string> kind;
    in property <int> value;
    callback moved-to(int);

    width: 76px;
    spacing: 4px;
    Text {
        text: root.value + "%";
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: root.value == 0 ? Theme.danger : Theme.ink;
        horizontal-alignment: center;
    }
    VolumeSlider {
        vertical: true;
        height: 160px;
        value: root.value;
        moved-to(v) => { root.moved-to(v); }
    }
    Text {
        text: root.name;
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: Theme.ink;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.kind;
        font-family: Theme.pixel;
        font-size: 16px * Theme.pixel-scale;
        color: Theme.ink-muted;
        horizontal-alignment: center;
    }
}

// O mixer da chamada: uma coluna para a voz de cada pessoa e outra para o
// som da tela de quem está mandando. Só muda o que nós ouvimos.
component Mixer inherits Rectangle {
    in property <[CallPersonRow]> people;
    callback set-volume(string, bool, int);
    callback close();

    width: max(240px, mixer-layout.preferred-width);
    height: mixer-layout.preferred-height;
    background: Theme.surface-0;
    border-width: 1px;
    border-color: Theme.ink;
    border-radius: 2px;

    // Clique no fundo do painel não fecha ele.
    TouchArea {}

    mixer-layout := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: "MIXER";
                font-family: Theme.pixel;
                font-size: 24px * Theme.pixel-scale;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: @image-url("icons/close.svg");
                tip: "fechar o mixer";
                clicked => { root.close(); }
            }
        }
        if root.people.length <= 1: Text {
            text: "> só você na chamada";
            font-family: Theme.pixel;
            font-size: 20px * Theme.pixel-scale;
            color: Theme.ink-muted;
        }
        HorizontalLayout {
            alignment: start;
            for person in root.people: HorizontalLayout {
                spacing: 8px;
                if !person.is-me: MixerStrip {
                    name: person.name;
                    kind: "voz";
                    value: person.voice;
                    moved-to(v) => { root.set-volume(person.id, false, v); }
                }
                if !person.is-me && person.screen-audio: MixerStrip {
                    name: person.name;
                    kind: "tela";
                    value: person.screen;
                    moved-to(v) => { root.set-volume(person.id, true, v); }
                }
            }
        }
        Text {
            text: "só muda o que você ouve · clique duplo: 100%";
            font-family: Theme.pixel;
            font-size: 16px * Theme.pixel-scale;
            color: Theme.ink-muted;
        }
    }
}

// Uma linha clicável do menu do botão direito.
component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    border-radius: 2px;
    background: item-area.has-hover ? Theme.ink : transparent;
    Text {
        x: 8px;
        height: parent.height;
        text: root.text;
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: item-area.has-hover ? Theme.surface-0 : Theme.ink;
        vertical-alignment: center;
    }
    item-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Uma linha de volume no menu do botão direito.
component MenuVolume inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    callback moved-to(int);
    spacing: 8px;
    height: 30px;
    Text {
        width: 44px;
        text: root.label;
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: Theme.ink-muted;
        vertical-alignment: center;
    }
    VolumeSlider {
        horizontal-stretch: 1;
        value: root.value;
        moved-to(v) => { root.moved-to(v); }
    }
    Text {
        width: 48px;
        text: root.value + "%";
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: root.value == 0 ? Theme.danger : Theme.ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Menu do botão direito sobre uma pessoa ou um vídeo da chamada: o volume
// dela e o da tela, mutar só para nós e a tela cheia.
component CallMenu inherits Rectangle {
    in property <string> title;
    in property <bool> has-person;
    in property <CallPersonRow> person;
    // O vídeo clicado (vazio: clicou no nome) e se ele já está em tela cheia.
    in property <string> tile;
    in property <bool> full;
    // O vídeo é a tela de alguém que estamos assistindo.
    in property <bool> screen-tile;
    callback set-volume(string, bool, int);
    callback toggle-full();
    callback stop-watching();
    callback close();

    width: 280px;
    height: menu-layout.preferred-height;
    background: Theme.surface-0;
    border-width: 1px;
    border-color: Theme.ink;
    border-radius: 2px;

    TouchArea {}

    menu-layout := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text {
            text: root.title;
            font-family: Theme.pixel;
            font-size: 22px * Theme.pixel-scale;
            color: Theme.ink;
            overflow: elide;
        }
        if root.has-person && !root.person.is-me: MenuVolume {
            label: "voz";
            value: root.person.voice;
            moved-to(v) => { root.set-volume(root.person.id, false, v); }
        }
        if root.has-person && !root.person.is-me && root.person.screen-audio: MenuVolume {
            label: "tela";
            value: root.person.screen;
            moved-to(v) => { root.set-volume(root.person.id, true, v); }
        }
        if root.has-person && !root.person.is-me: MenuItem {
            text: root.person.voice == 0 ? "desmutar para mim" : "mutar para mim";
            clicked => { root.set-volume(root.person.id, false, root.person.voice == 0 ? 100 : 0); }
        }
        if root.tile != "": MenuItem {
            text: root.full ? "sair da tela cheia" : "tela cheia";
            clicked => {
                root.toggle-full();
                root.close();
            }
        }
        if root.screen-tile: MenuItem {
            text: "parar de assistir";
            clicked => {
                root.stop-watching();
                root.close();
            }
        }
    }
}

// Linha de erro em vermelho; vazia, não ocupa espaço.
component ErrorLine inherits Text {
    in property <string> message;
    visible: root.message != "";
    height: root.message == "" ? 0px : self.preferred-height;
    text: "! " + root.message;
    font-family: Theme.pixel;
    font-size: 20px * Theme.pixel-scale;
    color: Theme.danger;
    wrap: word-wrap;
}

// Coluna da direita dentro de um grupo: quem está nele, convidar e sair.
component MembersPanel inherits Rectangle {
    // Clicou no nome de alguém: id, nome e onde.
    callback show-profile(string, string, length, length);
    in property <[MemberRow]> members;
    in property <string> error;
    callback invite(string);
    callback remove(string);
    callback leave();

    // Sair pede um segundo clique, para não sair sem querer.
    property <bool> confirm-leave;

    width: 260px;
    background: Theme.surface-0;

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "MEMBROS · " + root.members.length;
            font-family: Theme.pixel;
            font-size: 26px * Theme.pixel-scale;
            color: Theme.ink;
        }

        ListView {
            vertical-stretch: 1;
            for member in root.members: HorizontalLayout {
                height: 32px;
                spacing: 8px;
                // Falando na chamada: o nome fica invertido.
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 2px;
                    background: member.speaking ? Theme.ink : transparent;
                    animate background { duration: 90ms; }
                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        text: member.name;
                        font-family: Theme.pixel;
                        font-size: 22px * Theme.pixel-scale;
                        color: member.speaking ? Theme.surface-0 : Theme.ink;
                        overflow: elide;
                        vertical-alignment: center;
                        animate color { duration: 90ms; }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-profile(member.id, member.name,
                                self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                if member.is-owner: Text {
                    text: "[dono]";
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                    vertical-alignment: center;
                }
                if member.can-remove: Link {
                    text: "remover";
                    vertical-alignment: center;
                    clicked => { root.remove(member.id); }
                }
            }
        }

        FieldLabel { text: "convidar pelo usuário"; }
        invite-field := Field {
            accepted => {
                root.invite(self.text);
                self.text = "";
            }
        }
        ErrorLine { message: root.error; }

        Rectangle { height: 4px; }

        Button {
            label: root.confirm-leave ? "[ confirmar saída ]" : "sair do grupo";
            primary: root.confirm-leave;
            clicked => {
                if root.confirm-leave {
                    root.leave();
                }
                root.confirm-leave = !root.confirm-leave;
            }
        }
    }
}

// Interruptor de liga/desliga, quadrado como o resto da tela.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 2px;
    background: root.on ? Theme.ink : Theme.surface-2;
    border-width: 1px;
    border-color: root.on ? Theme.ink : Theme.border-strong;

    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 16px;
        height: parent.height - 8px;
        border-radius: 1px;
        background: root.on ? Theme.surface-0 : Theme.ink-muted;
        animate x { duration: 120ms; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Aba de cima do seletor de compartilhar.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 36px;
    width: tab-label.preferred-width + 24px;
    border-radius: 2px;
    background: root.selected ? Theme.ink : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.ink : Theme.border-strong;

    tab-label := Text {
        text: root.label;
        font-family: Theme.pixel;
        font-size: 22px * Theme.pixel-scale;
        color: root.selected ? Theme.surface-0 : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Escolher o que mostrar na chamada (F2-06): uma aba para a tela inteira e
// outra para uma janela, cada opção com a foto do que ela é de verdade, e o
// som junto ou não. Fica por cima da conversa, com o fundo escurecido.
component SharePicker inherits Rectangle {
    in property <[ShareSourceRow]> screens;
    in property <[ShareSourceRow]> windows;
    in property <bool> audio-supported;
    in-out property <bool> audio;
    callback pick(string, bool);
    callback close();

    // 0: tela inteira, 1: janela.
    property <int> tab: 0;
    property <string> chosen;
    property <[ShareSourceRow]> shown: root.tab == 0 ? root.screens : root.windows;

    background: #000000b0;

    // Clicar fora do quadro fecha.
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(parent.width - 48px, 820px);
        height: min(parent.height - 48px, 600px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-0;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: 2px;

        // Segura os cliques dentro do quadro.
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "COMPARTILHAR";
                    font-family: Theme.pixel;
                    font-size: 28px * Theme.pixel-scale;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: @image-url("icons/close.svg");
                    tip: "fechar";
                    clicked => { root.close(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Tab {
                    label: root.screens.length + root.windows.length == 0 ? "tela inteira" : "tela inteira (" + root.screens.length + ")";
                    selected: root.tab == 0;
                    clicked => {
                        root.tab = 0;
                        root.chosen = "";
                    }
                }
                Tab {
                    label: root.screens.length + root.windows.length == 0 ? "janela" : "janela (" + root.windows.length + ")";
                    selected: root.tab == 1;
                    clicked => {
                        root.tab = 1;
                        root.chosen = "";
                    }
                }
            }

            Text {
                text: root.screens.length + root.windows.length == 0 ? "> procurando telas e janelas..."
                    : root.tab == 0 ? "> mostra tudo o que aparece no monitor, inclusive notificações"
                    : "> mostra só uma janela, mesmo com outra por cima dela";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
                wrap: word-wrap;
            }

            grid := ScrollView {
                vertical-stretch: 1;
                property <length> gap: 12px;
                property <int> cols: max(1, floor((self.visible-width + self.gap) / (220px + self.gap)));
                property <length> card-width: (self.visible-width - (self.cols - 1) * self.gap) / self.cols;
                // Foto em 16:9 e uma linha de nome embaixo.
                property <length> card-height: (self.card-width - 8px) * 9 / 16 + 40px;
                content-height: ceil(root.shown.length / self.cols) * (self.card-height + self.gap);

                for source[i] in root.shown: Rectangle {
                    x: mod(i, grid.cols) * (grid.card-width + grid.gap);
                    y: floor(i / grid.cols) * (grid.card-height + grid.gap);
                    width: grid.card-width;
                    height: grid.card-height;
                    border-radius: 2px;
                    border-width: source.id == root.chosen ? 2px : 1px;
                    border-color: source.id == root.chosen ? Theme.ink
                        : (card-area.has-hover ? Theme.border-strong : Theme.border);
                    background: source.id == root.chosen ? Theme.surface-2 : Theme.surface-1;

                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: (parent.width - 8px) * 9 / 16;
                        background: Theme.surface-0;
                        clip: true;
                        if source.has-preview: Image {
                            width: 100%;
                            height: 100%;
                            source: source.preview;
                            image-fit: contain;
                        }
                        if !source.has-preview: Text {
                            text: "...";
                            font-family: Theme.pixel;
                            font-size: 22px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 8px;
                        y: parent.height - 36px;
                        width: parent.width - 16px;
                        height: 32px;
                        text: source.detail == "" ? source.name : source.name + " · " + source.detail;
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: source.id == root.chosen ? Theme.ink : Theme.ink-muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    card-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.chosen = source.id; }
                        double-clicked => { root.pick(source.id, root.audio && root.audio-supported); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                if root.audio-supported: Switch {
                    y: (parent.height - self.height) / 2;
                    on: root.audio;
                    toggled => { root.audio = !root.audio; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.audio-supported ? "compartilhar o som" : "som da tela: só no Windows por enquanto";
                        font-family: Theme.pixel;
                        font-size: 22px * Theme.pixel-scale;
                        color: root.audio-supported && root.audio ? Theme.ink : Theme.ink-muted;
                    }
                    if root.audio-supported: Text {
                        text: root.tab == 0 ? "todo o som do PC, menos o do mothh" : "só o som do programa dessa janela";
                        font-family: Theme.pixel;
                        font-size: 18px * Theme.pixel-scale;
                        color: Theme.ink-muted;
                        overflow: elide;
                    }
                }
                Button {
                    width: 120px;
                    label: "cancelar";
                    clicked => { root.close(); }
                }
                Button {
                    width: 160px;
                    primary: true;
                    enabled: root.chosen != "";
                    label: "compartilhar";
                    clicked => { root.pick(root.chosen, root.audio && root.audio-supported); }
                }
            }
        }
    }
}

// Uma escolha entre várias opções (qual microfone, por exemplo). Clicar na
// linha abre a lista embaixo; a escolhida tem o ">".
component Select inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> current;
    callback choose(int);
    property <bool> open;

    Rectangle {
        height: 56px;
        border-radius: 4px;
        background: head.has-hover ? Theme.surface-2 : transparent;
        head := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            Text {
                width: 180px;
                text: root.label;
                font-family: Theme.pixel;
                font-size: 24px * Theme.pixel-scale;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Text {
                text: root.options.length == 0 ? "procurando..." : root.options[root.current];
                font-family: Theme.pixel;
                font-size: 22px * Theme.pixel-scale;
                color: Theme.ink-muted;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.open ? "fechar" : "trocar";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: head.has-hover ? Theme.ink : Theme.ink-muted;
                vertical-alignment: center;
            }
        }
    }
    if root.open: VerticalLayout {
        padding-left: 8px;
        padding-bottom: 8px;
        for option[i] in root.options: Rectangle {
            height: 32px;
            border-radius: 2px;
            background: option-area.has-hover ? Theme.surface-2 : transparent;
            Text {
                x: 8px;
                width: parent.width - 16px;
                text: (i == root.current ? "> " : "  ") + option;
                font-family: Theme.pixel;
                font-size: 22px * Theme.pixel-scale;
                color: i == root.current ? Theme.ink : Theme.ink-muted;
                overflow: elide;
                vertical-alignment: center;
            }
            option-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = false;
                    root.choose(i);
                }
            }
        }
    }
}

// Coluna da direita quando a engrenagem está aberta: os dispositivos da
// chamada e um interruptor por módulo.
// Título de seção da página de perfil, com uma dica curta à direita
// (como "PLACA ... sua linha na lista de conversas" no desenho do perfil).
component ProfileSection inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    in property <image> icon;
    spacing: 8px;
    height: 32px;
    Image {
        width: 24px;
        height: 24px;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: Theme.ink;
    }
    Text {
        text: root.title;
        font-family: Theme.pixel;
        font-size: 28px * Theme.pixel-scale;
        color: Theme.ink;
        vertical-alignment: center;
    }
    Text {
        text: root.hint;
        font-family: Theme.pixel;
        font-size: 18px * Theme.pixel-scale;
        color: Theme.ink-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Botão com ícone pixelado e texto, como o "[ editar personagem ]" do desenho.
component IconLabelButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: 2px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary
        ? (area.has-hover ? Theme.ink-muted : Theme.ink)
        : (area.has-hover ? Theme.surface-2 : transparent);
    border-width: 1px;
    border-color: root.primary ? Theme.ink : Theme.border-strong;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Image {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.primary ? Theme.surface-0 : Theme.ink;
        }
        Text {
            text: "[ " + root.label + " ]";
            font-family: Theme.pixel;
            font-size: 22px * Theme.pixel-scale;
            color: root.primary ? Theme.surface-0 : Theme.ink;
            vertical-alignment: center;
        }
    }
}

// Foto (ou inicial) num quadrado, com moldura opcional.
component ProfilePhoto inherits Rectangle {
    in property <image> photo;
    in property <string> initial;
    in property <length> size: 44px;
    in property <length> frame: 1px;
    width: root.size;
    height: root.size;
    border-radius: 2px;
    background: Theme.surface-3;
    border-width: root.frame;
    border-color: root.frame > 1px ? Theme.ink : Theme.border-strong;
    clip: true;
    if root.photo.width > 0: Image {
        x: root.frame;
        y: root.frame;
        width: parent.width - 2 * root.frame;
        height: parent.height - 2 * root.frame;
        source: root.photo;
        image-fit: cover;
    }
    if root.photo.width == 0: Text {
        text: root.initial;
        font-family: Theme.pixel;
        font-size: (root.size * 0.6) * Theme.pixel-scale;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Campo de texto com várias linhas (o "sobre mim").
component AreaField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    forward-focus: input;
    height: 110px;
    border-radius: 2px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.ink : Theme.border-strong;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    input := TextInput {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        single-line: false;
        wrap: word-wrap;
        font-family: Theme.sans;
        font-size: 14px * Theme.sans-scale;
        color: Theme.ink;
    }
    if input.text == "": Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        text: root.placeholder;
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: Theme.ink-muted;
        wrap: word-wrap;
    }
}

// Mini cartão de alguém: abre com um clique na pessoa (nome no chat, membros,
// foto na chamada, a sua linha no rodapé). Mostra o básico e leva para a
// página completa.
component ListeningCard inherits Rectangle {
    in property <ProfileViewData> data;
    in property <image> turntable;
    callback open-spotify(string, string);
    height: 174px;
    background: Theme.surface-2;
    border-radius: 3px;
    VerticalLayout {
        padding: 10px;
        spacing: 7px;
        Text { text: "Ouvindo Spotify"; font-size: 13px; color: Theme.ink-muted; }
        HorizontalLayout {
            spacing: 8px;
            Image { width: 76px; height: 72px; source: root.turntable; image-fit: contain; image-rendering: pixelated; }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: root.data.listening-title; font-size: 14px; color: Theme.ink; overflow: elide; }
                Text { text: root.data.listening-artist; font-size: 12px; color: Theme.ink-muted; overflow: elide; }
                Rectangle {
                    height: 3px;
                    background: Theme.border-strong;
                    Rectangle { x: 0px; y: 0px; width: parent.width * root.data.listening-progress; height: parent.height; background: Theme.ink; }
                }
                Text { text: root.data.listening-elapsed + " / " + root.data.listening-duration; font-family: Theme.pixel; font-size: 17px * Theme.pixel-scale; color: Theme.ink-muted; }
            }
        }
        IconLabelButton {
            icon: @image-url("icons/music-external.svg");
            label: "Abrir no Spotify";
            clicked => { root.open-spotify(root.data.listening-title, root.data.listening-artist); }
        }
    }
}

component ProfileCard inherits Rectangle {
    in property <image> turntable;
    callback open-spotify(string, string);
    in property <ProfileViewData> data;
    // Foto grande (pode ser GIF); a pequena das listas enquanto ela não chega.
    in property <image> photo;
    in property <image> small-photo;
    in property <image> bg-image;
    callback open-page();
    callback message();
    callback edit();

    width: 300px;
    height: card-layout.preferred-height;
    border-radius: 4px;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-strong;
    clip: true;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000099;

    // Clique dentro do cartão não fecha ele.
    TouchArea {}

    card-layout := VerticalLayout {
        Rectangle {
            height: 96px;
            background: root.data.has-accent ? root.data.accent.darker(0.45) : Theme.surface-3;
            if root.bg-image.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.bg-image;
                image-fit: cover;
            }
        }
        Rectangle {
            height: 46px;
            ProfilePhoto {
                x: 14px;
                y: -44px;
                photo: root.photo.width > 0 ? root.photo : root.small-photo;
                initial: root.data.initial;
                size: 86px;
                frame: 3px;
            }
        }
        VerticalLayout {
            padding: 14px;
            padding-top: 2px;
            spacing: 4px;
            Text {
                text: root.data.name;
                font-family: Theme.pixel;
                font-size: 34px * Theme.pixel-scale;
                color: Theme.ink;
                overflow: elide;
            }
            if root.data.sub != "": Text {
                text: root.data.sub;
                font-family: Theme.sans;
                font-size: 13px * Theme.sans-scale;
                color: Theme.ink-muted;
                overflow: elide;
            }
            if root.data.in-call != "": Text {
                text: "▪ na chamada · " + root.data.in-call;
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: root.data.has-accent ? root.data.accent : Theme.ink;
                overflow: elide;
            }
            if root.data.listening-title != "": ListeningCard {
                data: root.data;
                turntable: root.turntable;
                open-spotify(title, artist) => { root.open-spotify(title, artist); }
            }
            if root.data.about != "": Rectangle {
                height: min(about-text.preferred-height, 58px) + 14px;
                border-radius: 2px;
                background: Theme.surface-2;
                clip: true;
                about-text := Text {
                    x: 8px;
                    y: 7px;
                    width: parent.width - 16px;
                    height: parent.height - 14px;
                    text: root.data.about;
                    font-family: Theme.sans;
                    font-size: 13px * Theme.sans-scale;
                    color: Theme.ink;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
            if root.data.loading: Text {
                text: "carregando...";
                font-family: Theme.pixel;
                font-size: 18px * Theme.pixel-scale;
                color: Theme.ink-muted;
            }
            if root.data.member-since != "": Text {
                text: root.data.member-since;
                font-family: Theme.pixel;
                font-size: 18px * Theme.pixel-scale;
                color: Theme.ink-muted;
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: 8px;
                IconLabelButton {
                    horizontal-stretch: 1;
                    icon: @image-url("icons/user.svg");
                    label: "ver perfil";
                    primary: true;
                    clicked => { root.open-page(); }
                }
                if root.data.is-me: IconLabelButton {
                    width: 110px;
                    icon: @image-url("icons/pencil.svg");
                    label: "editar";
                    clicked => { root.edit(); }
                }
                if !root.data.is-me: IconButton {
                    y: 2px;
                    icon: @image-url("icons/chat.svg");
                    tip: "mandar mensagem";
                    clicked => { root.message(); }
                }
            }
        }
    }
}

// A página de perfil completa, no lugar da conversa (como a da Steam): o
// fundo da pessoa atrás de tudo, a coluna do meio com o cabeçalho e as
// vitrines.
component ProfilePage inherits Rectangle {
    in property <image> turntable;
    callback open-spotify(string, string);
    in property <ProfileViewData> data;
    in property <image> photo;
    in property <image> small-photo;
    in property <image> bg-image;
    in property <image> art;
    in property <image> art-side;
    // Sem fundo: o dither do app, tingido com a cor da pessoa.
    in property <image> dither;
    callback close();
    callback edit();
    callback message();

    background: Theme.surface-0;
    clip: true;

    if root.bg-image.width == 0: Rectangle {
        background: root.data.has-accent
            ? @linear-gradient(180deg, root.data.accent.darker(0.55) 0%, Theme.surface-0 100%)
            : Theme.surface-0;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.dither;
            image-fit: cover;
            image-rendering: pixelated;
            opacity: 0.35;
        }
    }
    if root.bg-image.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.bg-image;
        image-fit: cover;
    }

    page-scroll := ScrollView {
        VerticalLayout {
            width: page-scroll.visible-width;
            padding-top: 32px;
            padding-bottom: 40px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                column := Rectangle {
                    width: min(840px, page-scroll.visible-width - 48px);
                    height: column-layout.preferred-height;
                    background: #0c0b0ed4;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: #ffffff12;

                    column-layout := VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        // Cabeçalho: foto, nome e o resto.
                        HorizontalLayout {
                            spacing: 22px;
                            ProfilePhoto {
                                photo: root.photo.width > 0 ? root.photo : root.small-photo;
                                initial: root.data.initial;
                                size: column.width < 640px ? 96px : 140px;
                                frame: 3px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: root.data.name;
                                    font-family: Theme.pixel;
                                    font-size: 52px * Theme.pixel-scale;
                                    color: Theme.ink;
                                    overflow: elide;
                                }
                                if root.data.sub != "": Text {
                                    text: root.data.sub;
                                    font-family: Theme.sans;
                                    font-size: 15px * Theme.sans-scale;
                                    color: Theme.ink-muted;
                                    overflow: elide;
                                }
                                if root.data.in-call != "": Text {
                                    text: "▪ na chamada · " + root.data.in-call;
                                    font-family: Theme.pixel;
                                    font-size: 22px * Theme.pixel-scale;
                                    color: root.data.has-accent ? root.data.accent : Theme.ink;
                                    overflow: elide;
                                }
                                if root.data.member-since != "": Text {
                                    text: root.data.member-since;
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                    overflow: elide;
                                }
                                if root.data.loading: Text {
                                    text: "carregando o perfil...";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                }
                                if !root.data.full && !root.data.loading: Text {
                                    text: "Este servidor ainda não guarda páginas de perfil.";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                if root.data.is-me: IconLabelButton {
                                    width: column.width < 640px ? 150px : 200px;
                                    icon: @image-url("icons/pencil.svg");
                                    label: "editar perfil";
                                    clicked => { root.edit(); }
                                }
                                if !root.data.is-me: IconLabelButton {
                                    width: column.width < 640px ? 150px : 200px;
                                    icon: @image-url("icons/chat.svg");
                                    label: column.width < 640px ? "falar" : "mensagem";
                                    clicked => { root.message(); }
                                }
                            }
                        }

                        if root.data.listening-title != "": ListeningCard {
                            data: root.data;
                            turntable: root.turntable;
                            open-spotify(title, artist) => { root.open-spotify(title, artist); }
                        }
                        // Arte em destaque: a imagem grande e a faixa estreita.
                        if root.data.show-art && (root.art.width > 0 || root.art-side.width > 0): Rectangle {
                            property <bool> both: root.art.width > 0 && root.art-side.width > 0;
                            property <length> inner: self.width - 24px;
                            property <length> main-w: self.both ? (self.inner - 10px) * 0.75 : self.inner;
                            property <length> row-h: root.art.width > 0
                                ? min(560px, self.main-w * root.art.height / root.art.width)
                                : min(560px, self.inner * root.art-side.height / max(1, root.art-side.width));
                            height: self.row-h + 56px;
                            border-radius: 2px;
                            background: #00000052;
                            Text {
                                x: 12px;
                                y: 10px;
                                text: "ARTE EM DESTAQUE";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                            }
                            if root.art.width > 0: Rectangle {
                                x: 12px;
                                y: 44px;
                                width: parent.main-w;
                                height: parent.row-h;
                                clip: true;
                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.art;
                                    image-fit: cover;
                                }
                            }
                            if root.art-side.width > 0: Rectangle {
                                x: parent.both ? 12px + parent.main-w + 10px : 12px;
                                y: 44px;
                                width: parent.both ? parent.inner - parent.main-w - 10px : parent.inner;
                                height: parent.row-h;
                                clip: true;
                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.art-side;
                                    image-fit: cover;
                                }
                            }
                        }

                        if root.data.show-about && root.data.about != "": Rectangle {
                            height: about-layout.preferred-height;
                            border-radius: 2px;
                            background: #00000052;
                            about-layout := VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: "SOBRE MIM";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                }
                                Text {
                                    text: root.data.about;
                                    font-family: Theme.sans;
                                    font-size: 15px * Theme.sans-scale;
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // A sua página vazia: diz onde mexer.
                        if root.data.is-me && root.data.full && root.art.width == 0 && root.art-side.width == 0 && root.data.about == "": Text {
                            text: "Sua página ainda está vazia. Em \"editar perfil\" dá para pôr um fundo, uma arte em destaque (GIF também) e um texto sobre você.";
                            font-family: Theme.pixel;
                            font-size: 20px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: 16px;
        width: 38px;
        height: 38px;
        border-radius: 2px;
        background: Theme.surface-0;
        IconButton {
            x: 1px;
            y: 1px;
            icon: @image-url("icons/close.svg");
            tip: "fechar o perfil";
            clicked => { root.close(); }
        }
    }
}

// Página de perfil: como você aparece (na lista e no cartão) e o que dá para
// trocar por enquanto: foto, nome e senha. O desenho segue o do perfil
// (placa, moldura e mural ficam para depois, com o mercado).
// Um quadradinho de cor para escolher a cor de destaque ("" é nenhuma).
component AccentSwatch inherits Rectangle {
    in property <string> value;
    in property <color> shown;
    in property <bool> selected;
    callback pick(string);
    width: 30px;
    height: 30px;
    border-radius: 2px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.ink : Theme.border-strong;
    background: Theme.surface-0;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        background: root.value == "" ? Theme.surface-2 : root.shown;
    }
    if root.value == "": Text {
        text: "×";
        font-family: Theme.pixel;
        font-size: 22px * Theme.pixel-scale;
        color: Theme.ink-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(root.value); }
    }
}

// Uma imagem da página no editor: miniatura, escolher e tirar.
component PageImageRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <image> image;
    in property <length> thumb-width: 96px;
    callback pick();
    callback remove();
    spacing: 12px;
    Rectangle {
        width: root.thumb-width;
        height: 54px;
        border-radius: 2px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;
        if root.image.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.image;
            image-fit: cover;
        }
        if root.image.width == 0: Text {
            text: "nenhuma";
            font-family: Theme.pixel;
            font-size: 18px * Theme.pixel-scale;
            color: Theme.ink-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            font-family: Theme.pixel;
            font-size: 22px * Theme.pixel-scale;
            color: Theme.ink;
            overflow: elide;
        }
        Text {
            text: root.hint;
            font-family: Theme.pixel;
            font-size: 17px * Theme.pixel-scale;
            color: Theme.ink-muted;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 6px;
            IconLabelButton {
                width: 130px;
                icon: @image-url("icons/photo.svg");
                label: "escolher";
                clicked => { root.pick(); }
            }
            if root.image.width > 0: IconButton {
                y: 2px;
                icon: @image-url("icons/close.svg");
                tip: "tirar " + root.label;
                clicked => { root.remove(); }
            }
        }
    }
}

component ProfilePanel inherits Rectangle {
    // Página de perfil: textos e imagens (só com o servidor que guarda perfis).
    in property <bool> profiles-supported;
    in-out property <string> real-name;
    in-out property <string> location;
    in-out property <string> about;
    in-out property <string> accent;
    in-out property <bool> show-art: true;
    in-out property <bool> show-about: true;
    in property <image> page-background;
    in property <image> page-art;
    in property <image> page-art-side;
    in property <string> page-message;
    in property <bool> page-error;
    callback save-page();
    callback pick-page-image(string);
    callback remove-page-image(string);
    callback view-page();
    in property <image> profile-photo;
    in property <string> user-name;
    in property <string> initial;
    in property <string> status;
    // Faixa do cartão: o mesmo dither animado da barra lateral.
    in property <image> banner;
    // Resposta da última troca: texto e se foi erro.
    in property <string> name-message;
    in property <bool> name-error;
    in property <string> password-message;
    in property <bool> password-error;
    callback pick-photo();
    callback rename(string);
    callback change-password(string, string);
    callback close();

    property <string> local-password-error;
    background: Theme.surface-1;

    VerticalLayout {
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Text {
                    text: "PERFIL";
                    font-family: Theme.pixel;
                    font-size: 28px * Theme.pixel-scale;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Text {
                    text: "como os outros te veem";
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/close.svg");
                    tip: "fechar perfil";
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        profile-scroll := ScrollView {
            vertical-stretch: 1;

            HorizontalLayout {
                width: profile-scroll.visible-width;
                padding: 24px;
                spacing: 24px;

                // Esquerda: a sua linha na lista de conversas dos outros.
                if profile-scroll.visible-width > 1000px: VerticalLayout {
                    width: 260px;
                    spacing: 8px;
                    alignment: start;
                    FieldLabel { text: "> na lista de conversas"; font-size: 18px; }
                    Rectangle {
                        height: 72px;
                        border-radius: 4px;
                        background: Theme.surface-0;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            ProfilePhoto {
                                photo: root.profile-photo;
                                initial: root.initial;
                                size: 44px;
                                y: (parent.height - self.height) / 2;
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    Text {
                                        text: root.user-name;
                                        font-family: Theme.pixel;
                                        font-size: 24px * Theme.pixel-scale;
                                        color: Theme.ink;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: "agora";
                                        font-family: Theme.pixel;
                                        font-size: 18px * Theme.pixel-scale;
                                        color: Theme.ink-muted;
                                    }
                                }
                                Text {
                                    text: "bora pra chamada?";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    Text {
                        text: "A sua foto aparece na lista de quem conversa com você, nos membros do grupo e na chamada.";
                        font-family: Theme.pixel;
                        font-size: 18px * Theme.pixel-scale;
                        color: Theme.ink-muted;
                        wrap: word-wrap;
                    }
                }

                // Meio: o cartão.
                VerticalLayout {
                    width: 300px;
                    alignment: start;
                Rectangle {
                    height: card.preferred-height;
                    border-radius: 4px;
                    background: Theme.surface-0;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    clip: true;

                    card := VerticalLayout {
                        Rectangle {
                            height: 110px;
                            background: Theme.surface-3;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.banner;
                                image-fit: cover;
                                image-rendering: pixelated;
                            }
                        }
                        // A foto sobe um pouco por cima da faixa.
                        Rectangle {
                            height: 56px;
                            ProfilePhoto {
                                x: 16px;
                                y: -48px;
                                photo: root.profile-photo;
                                initial: root.initial;
                                size: 100px;
                                frame: 3px;
                            }
                        }
                        VerticalLayout {
                            padding: 16px;
                            padding-top: 4px;
                            spacing: 4px;
                            Text {
                                text: root.user-name;
                                font-family: Theme.pixel;
                                font-size: 34px * Theme.pixel-scale;
                                color: Theme.ink;
                                overflow: elide;
                            }
                            Text {
                                text: "@" + root.user-name + " · " + root.status;
                                font-family: Theme.pixel;
                                font-size: 18px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                overflow: elide;
                            }
                            Rectangle { height: 12px; }
                            IconLabelButton {
                                icon: @image-url("icons/photo.svg");
                                label: "trocar foto";
                                primary: true;
                                clicked => { root.pick-photo(); }
                            }
                            IconLabelButton {
                                icon: @image-url("icons/user.svg");
                                label: "ver minha página";
                                clicked => { root.view-page(); }
                            }
                        }
                    }
                }
                }

                // Direita: o que dá para trocar.
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 300px;
                    max-width: 560px;
                    spacing: 10px;
                    alignment: start;

                    ProfileSection {
                        icon: @image-url("icons/photo.svg");
                        title: "FOTO";
                        hint: "na lista, nos membros e na chamada";
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ProfilePhoto {
                            photo: root.profile-photo;
                            initial: root.initial;
                            size: 56px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "PNG, JPG, WEBP ou GIF. O meio quadrado da imagem vira a foto; GIF anima na sua página e no seu cartão.";
                                font-family: Theme.pixel;
                                font-size: 18px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                wrap: word-wrap;
                            }
                            IconLabelButton {
                                icon: @image-url("icons/photo.svg");
                                label: "escolher imagem";
                                width: 230px;
                                clicked => { root.pick-photo(); }
                            }
                        }
                    }

                    Rectangle { height: 8px; }
                    ProfileSection {
                        icon: @image-url("icons/pencil.svg");
                        title: "NOME";
                        hint: "também é o nome para entrar";
                    }
                    name-field := Field {
                        placeholder: "novo nome";
                        text: root.user-name;
                        accepted => { root.rename(self.text); }
                    }
                    Text {
                        text: root.name-message != "" ? root.name-message : "3 a 20 letras sem acento, números, _ e .";
                        font-family: Theme.pixel;
                        font-size: 18px * Theme.pixel-scale;
                        color: root.name-error ? Theme.danger : Theme.ink-muted;
                        wrap: word-wrap;
                    }
                    IconLabelButton {
                        icon: @image-url("icons/pencil.svg");
                        label: "salvar nome";
                        width: 230px;
                        enabled: name-field.text != "" && name-field.text != root.user-name;
                        clicked => { root.rename(name-field.text); }
                    }

                    Rectangle { height: 8px; }
                    ProfileSection {
                        icon: @image-url("icons/user.svg");
                        title: "SUA PÁGINA";
                        hint: "o que aparece no seu perfil";
                    }
                    if !root.profiles-supported: Text {
                        text: "Este servidor ainda não guarda páginas de perfil. Atualize o servidor para usar.";
                        font-family: Theme.pixel;
                        font-size: 18px * Theme.pixel-scale;
                        color: Theme.ink-muted;
                        wrap: word-wrap;
                    }
                    if root.profiles-supported: VerticalLayout {
                        spacing: 10px;
                        FieldLabel { text: "nome real (opcional)"; }
                        real-name-field := Field {
                            placeholder: "como te chamam";
                            text <=> root.real-name;
                        }
                        FieldLabel { text: "de onde"; }
                        Field {
                            placeholder: "cidade, país";
                            text <=> root.location;
                        }
                        FieldLabel { text: "sobre mim"; }
                        AreaField {
                            placeholder: "um pouco sobre você";
                            text <=> root.about;
                        }
                        FieldLabel { text: "cor de destaque"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for c in [
                                { v: "", c: #000000 },
                                { v: "#7dff9b", c: #7dff9b },
                                { v: "#6bd3ff", c: #6bd3ff },
                                { v: "#b98bff", c: #b98bff },
                                { v: "#ff5ab4", c: #ff5ab4 },
                                { v: "#ff8a3d", c: #ff8a3d },
                                { v: "#ffd36b", c: #ffd36b },
                                { v: "#ff5a4f", c: #ff5a4f },
                                { v: "#f2f2f2", c: #f2f2f2 },
                            ]: AccentSwatch {
                                value: c.v;
                                shown: c.c;
                                selected: root.accent == c.v;
                                pick(v) => { root.accent = v; }
                            }
                        }
                        FieldLabel { text: "imagens (PNG, JPG ou GIF)"; }
                        PageImageRow {
                            label: "fundo";
                            hint: "atrás da página inteira";
                            image: root.page-background;
                            pick => { root.pick-page-image("fundo"); }
                            remove => { root.remove-page-image("fundo"); }
                        }
                        PageImageRow {
                            label: "arte principal";
                            hint: "a imagem grande da vitrine";
                            image: root.page-art;
                            pick => { root.pick-page-image("arte"); }
                            remove => { root.remove-page-image("arte"); }
                        }
                        PageImageRow {
                            label: "arte lateral";
                            hint: "a faixa estreita ao lado";
                            image: root.page-art-side;
                            thumb-width: 40px;
                            pick => { root.pick-page-image("arte-lateral"); }
                            remove => { root.remove-page-image("arte-lateral"); }
                        }
                        FieldLabel { text: "vitrines"; }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Switch {
                                y: 2px;
                                on: root.show-art;
                                toggled => { root.show-art = !root.show-art; }
                            }
                            Text {
                                text: "arte em destaque";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 12px; }
                            Switch {
                                y: 2px;
                                on: root.show-about;
                                toggled => { root.show-about = !root.show-about; }
                            }
                            Text {
                                text: "sobre mim";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                        }
                        if root.page-message != "": Text {
                            text: root.page-message;
                            font-family: Theme.pixel;
                            font-size: 18px * Theme.pixel-scale;
                            color: root.page-error ? Theme.danger : Theme.ink-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            IconLabelButton {
                                horizontal-stretch: 1;
                                icon: @image-url("icons/pencil.svg");
                                label: "salvar";
                                primary: true;
                                clicked => { root.save-page(); }
                            }
                            IconLabelButton {
                                horizontal-stretch: 1;
                                icon: @image-url("icons/user.svg");
                                label: "ver como fica";
                                clicked => { root.view-page(); }
                            }
                        }
                    }

                    Rectangle { height: 8px; }
                    ProfileSection {
                        icon: @image-url("icons/key.svg");
                        title: "SENHA";
                        hint: "os outros aparelhos saem da conta";
                    }
                    current-field := Field {
                        password: true;
                        placeholder: "senha atual";
                    }
                    new-field := Field {
                        password: true;
                        placeholder: "senha nova (8 ou mais)";
                    }
                    confirm-field := Field {
                        password: true;
                        placeholder: "repita a senha nova";
                        accepted => { password-button.clicked(); }
                    }
                    Text {
                        text: root.local-password-error != "" ? root.local-password-error : root.password-message;
                        visible: self.text != "";
                        font-family: Theme.pixel;
                        font-size: 18px * Theme.pixel-scale;
                        color: root.local-password-error != "" || root.password-error ? Theme.danger : Theme.ink-muted;
                        wrap: word-wrap;
                    }
                    password-button := IconLabelButton {
                        icon: @image-url("icons/key.svg");
                        label: "trocar senha";
                        width: 230px;
                        enabled: current-field.text != "" && new-field.text != "";
                        clicked => {
                            if new-field.text != confirm-field.text {
                                root.local-password-error = "As duas senhas novas não são iguais.";
                            } else {
                                root.local-password-error = "";
                                root.change-password(current-field.text, new-field.text);
                                current-field.text = "";
                                new-field.text = "";
                                confirm-field.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsPanel inherits Rectangle {
    in property <[ModuleRow]> modules;
    // Opções de cada dispositivo (a primeira é o padrão do sistema) e qual
    // está escolhida.
    // Fontes (V6-05): as opções de cada família e a escolhida.
    in property <[string]> font-pixel-options;
    in property <int> font-pixel-choice;
    in property <[string]> font-sans-options;
    in property <int> font-sans-choice;
    in property <[string]> mic-options;
    in property <int> mic-choice;
    in property <[string]> speaker-options;
    in property <int> speaker-choice;
    in property <[string]> camera-options;
    in property <int> camera-choice;
    // Teste da câmera: ligado, o último quadro e a frase de como foi.
    in property <bool> camera-testing;
    in property <image> camera-test-frame;
    in property <string> camera-test-status;
    callback test-camera(bool);
    callback toggle(string, bool);
    // Redução de ruído do microfone na chamada.
    // Intensidade da redução de ruído, 0 a 100.
    in property <int> noise-level;
    callback set-noise-level(int);
    // "mic", "speaker" ou "camera", e a posição na lista.
    callback choose-device(string, int);
    // "pixel" ou "sans", e o índice na lista.
    callback choose-font(string, int);
    callback close();
    // Versão do app (vazia fora da release).
    in property <string> version;
    callback check-updates();

    background: Theme.surface-1;

    VerticalLayout {
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: "CONFIGURAÇÕES";
                    font-family: Theme.pixel;
                    font-size: 28px * Theme.pixel-scale;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/close.svg");
                    tip: "fechar configurações";
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        settings-scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: settings-scroll.visible-width;
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "> chamada";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                }
                Select {
                    label: "microfone";
                    options: root.mic-options;
                    current: root.mic-choice;
                    choose(i) => { root.choose-device("mic", i); }
                }
                // Redução de ruído com intensidade: 0 desliga, 50 é o RNNoise
                // inteiro (o padrão), acima disso também corta entre as falas.
                Rectangle {
                    height: 84px;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "redução de ruído · " + (root.noise-level == 0 ? "desligada" : root.noise-level + "%");
                                font-family: Theme.pixel;
                                font-size: 24px * Theme.pixel-scale;
                                color: root.noise-level > 0 ? Theme.ink : Theme.ink-muted;
                            }
                            Text {
                                text: root.noise-level == 0 ? "o microfone vai como está"
                                    : root.noise-level <= 50 ? "tira teclado, ventilador e barulho de fundo do seu microfone"
                                    : "também corta o barulho entre as falas";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                overflow: elide;
                            }
                        }
                        VolumeSlider {
                            width: 220px;
                            height: 36px;
                            y: (parent.height - self.height) / 2;
                            value: root.noise-level;
                            max: 100;
                            snap: 50;
                            moved-to(v) => { root.set-noise-level(v); }
                        }
                    }
                }
                Select {
                    label: "saída de áudio";
                    options: root.speaker-options;
                    current: root.speaker-choice;
                    choose(i) => { root.choose-device("speaker", i); }
                }
                Select {
                    label: "câmera";
                    options: root.camera-options;
                    current: root.camera-choice;
                    choose(i) => { root.choose-device("camera", i); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    Button {
                        width: 180px;
                        label: root.camera-testing ? "parar teste" : "testar câmera";
                        clicked => { root.test-camera(!root.camera-testing); }
                    }
                    Text {
                        text: root.camera-test-status;
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.ink-muted;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.camera-testing: Rectangle {
                    height: 240px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface-0;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.camera-test-frame;
                        image-fit: contain;
                    }
                }

                Rectangle { height: 16px; }

                Text {
                    text: "> fontes";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                }
                Select {
                    label: "títulos e botões";
                    options: root.font-pixel-options;
                    current: root.font-pixel-choice;
                    choose(i) => { root.choose-font("pixel", i); }
                }
                Select {
                    label: "mensagens";
                    options: root.font-sans-options;
                    current: root.font-sans-choice;
                    choose(i) => { root.choose-font("sans", i); }
                }

                Rectangle { height: 16px; }

                Text {
                    text: "> módulos";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                }

                for module in root.modules: Rectangle {
                    height: 64px;
                    border-radius: 4px;
                    background: row-area.has-hover ? Theme.surface-2 : transparent;

                    // A linha toda liga e desliga, não só o interruptor.
                    row-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle(module.id, !module.on); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: module.name;
                                font-family: Theme.pixel;
                                font-size: 24px * Theme.pixel-scale;
                                color: module.on ? Theme.ink : Theme.ink-muted;
                            }
                            Text {
                                text: module.description;
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                overflow: elide;
                            }
                        }
                        Switch {
                            y: (parent.height - self.height) / 2;
                            on: module.on;
                            toggled => { root.toggle(module.id, !module.on); }
                        }
                    }
                }

                Rectangle { height: 8px; }
                Text {
                    text: "> atualização";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    IconLabelButton {
                        width: 260px;
                        icon: @image-url("icons/download.svg");
                        label: "buscar atualização";
                        clicked => { root.check-updates(); }
                    }
                    Text {
                        text: root.version != "" ? "mothh " + root.version : "versão de desenvolvimento";
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.ink-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Tela de carregamento: a mariposa (do moth-animacao.html) entra, paira
// batendo as asas enquanto o app procura atualização e sai voando quando
// acaba. As asas são uma folha de 16 quadros de um ciclo (gravada da
// animação original, ui/moth/asas.png); entrada, balanço e saída são as
// mesmas contas do HTML. Fecha sozinha (`gone`) quando a saída termina.
component MothSplash inherits Rectangle {
    in property <string> status;
    in property <string> version;
    // Já pode sair (a busca acabou). A saída espera a entrada quase terminar.
    in property <bool> leaving;
    in property <bool> can-skip;
    in property <bool> ask-restart;
    // `animation-tick()` de quando a tela abriu.
    in property <duration> started;
    callback skip();
    callback restart();
    callback later();
    callback gone();

    property <duration> exit-at: 0ms;
    changed leaving => {
        if root.leaving {
            root.exit-at = max(animation-tick(), root.started + 1.8s);
        }
    }

    property <float> t: (animation-tick() - root.started) / 1s;
    property <float> entry: 1 - pow(1 - min(1, root.t / 2.8), 3);
    property <float> q: root.leaving ? clamp((animation-tick() - root.exit-at) / 2.6s, 0, 1) : 0;
    property <float> a: root.q * root.q;
    property <float> frequency: root.leaving && root.q > 0 ? 3.25 : 2.1;
    property <int> frame: mod(floor(root.t * root.frequency * 16), 16);
    // A caixa da mariposa no HTML (360px); os quadros têm margem para as
    // pontas das asas (440 para 360).
    property <length> flight: min(root.width * 0.45, 320px);
    property <float> scale: (0.35 + 0.65 * root.entry) * (1 - root.a * 0.65);
    property <length> dx: root.width * 0.75 * (1 - root.entry) - root.a * root.width * 0.8;
    property <length> dy: root.height * 0.3 * (1 - root.entry) + sin(root.t * 1.5 * 1rad) * 6px - root.a * root.height * 0.18;

    // O fundo some durante a saída: o app aparece enquanto a mariposa voa.
    background: Theme.surface-0.with-alpha(1 - root.a);

    // Por cima de tudo: nada atrás dela recebe clique enquanto está aberta.
    TouchArea { }

    Image {
        width: root.flight * 440 / 360 * root.scale;
        height: self.width;
        x: (root.width - self.width) / 2 + root.dx;
        y: (root.height - self.height) / 2 - root.height * 0.04 + root.dy;
        source: @image-url("moth/asas.png");
        source-clip-x: mod(root.frame, 4) * 320;
        source-clip-y: floor(root.frame / 4) * 320;
        source-clip-width: 320;
        source-clip-height: 320;
        opacity: min(1, root.t * 1.4) * (1 - max(0, (root.q - 0.55) / 0.45));
    }

    VerticalLayout {
        y: root.height * 0.74;
        width: root.width;
        height: root.height * 0.2;
        spacing: 10px;
        alignment: start;
        opacity: root.leaving && root.q > 0 ? max(0, 1 - (animation-tick() - root.exit-at) / 3s) : min(1, root.t / 2);

        Text {
            text: root.status;
            font-family: Theme.pixel;
            font-size: 22px * Theme.pixel-scale;
            letter-spacing: 3px;
            color: #777777;
            horizontal-alignment: center;
        }
        if root.can-skip: HorizontalLayout {
            alignment: center;
            Link {
                text: "[ pular ]";
                clicked => { root.skip(); }
            }
        }
        if root.ask-restart: HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Button {
                width: 220px;
                primary: true;
                label: "[ reiniciar agora ]";
                clicked => { root.restart(); }
            }
            Button {
                width: 140px;
                label: "[ depois ]";
                clicked => { root.later(); }
            }
        }
    }

    if root.version != "": Text {
        x: 16px;
        y: root.height - self.height - 12px;
        text: "mothh " + root.version;
        font-family: Theme.pixel;
        font-size: 18px * Theme.pixel-scale;
        color: #555555;
        opacity: 1 - root.a;
    }

    // A saída terminou: a tela fecha.
    Timer {
        interval: 100ms;
        running: root.leaving;
        triggered => {
            if root.q >= 1 {
                root.gone();
            }
        }
    }
}

// Tela de entrada: usuário, senha, "entrar" e "criar conta".
component LoginScreen inherits Rectangle {
    in property <bool> connecting;
    in-out property <string> error;
    callback login(string, string);
    callback register(string, string);

    background: Theme.surface-0;

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                spacing: 10px;

                Text {
                    text: "mothh";
                    font-family: Theme.pixel;
                    font-size: 72px * Theme.pixel-scale;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.connecting ? "> conectando..." : "> entre para conversar";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                    horizontal-alignment: center;
                }

                Rectangle { height: 16px; }

                FieldLabel { text: "usuário"; }
                username := Field {
                    enabled: !root.connecting;
                    accepted => { password.focus(); }
                }

                Rectangle { height: 4px; }

                FieldLabel { text: "senha"; }
                password := Field {
                    password: true;
                    enabled: !root.connecting;
                    accepted => { enter.clicked(); }
                }

                // A linha de erro guarda o espaço mesmo vazia, para a tela não pular,
                // e cresce quando o texto quebra em duas linhas.
                Text {
                    min-height: 28px;
                    text: root.error == "" ? "" : "! " + root.error;
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.danger;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                enter := Button {
                    label: "[ entrar ]";
                    primary: true;
                    enabled: !root.connecting;
                    clicked => {
                        root.error = "";
                        root.login(username.text, password.text);
                    }
                }
                Button {
                    label: "criar conta";
                    enabled: !root.connecting;
                    clicked => {
                        root.error = "";
                        root.register(username.text, password.text);
                    }
                }
            }
        }
    }

    init => { username.focus(); }
}

// Botão da barra da janela (minimizar, maximizar, fechar). O desenho é feito
// com linhas de 1px, no traço fino do resto do app.
component WindowButton inherits Rectangle {
    // "min", "max", "restore" ou "close".
    in property <string> kind;
    callback clicked();

    width: 46px;
    background: area.pressed ? (root.kind == "close" ? Theme.danger.darker(20%) : Theme.surface-3)
        : area.has-hover ? (root.kind == "close" ? Theme.danger : Theme.surface-2)
        : transparent;
    property <color> line: area.has-hover ? (root.kind == "close" ? #ffffff : Theme.ink) : Theme.ink-muted;

    if root.kind == "min": Rectangle {
        x: (parent.width - 10px) / 2;
        y: parent.height / 2;
        width: 10px;
        height: 1px;
        background: root.line;
    }
    if root.kind == "max": Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-width: 1px;
        border-color: root.line;
    }
    // Restaurar: dois quadrados, um atrás do outro.
    if root.kind == "restore": Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        Rectangle {
            x: 2px;
            y: 0;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.line;
        }
        Rectangle {
            x: 0;
            y: 2px;
            width: 8px;
            height: 8px;
            background: area.has-hover ? Theme.surface-2 : Theme.surface-0;
            border-width: 1px;
            border-color: root.line;
        }
    }
    if root.kind == "close": Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.line;
        stroke-width: 1px;
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Barra da janela do próprio app, no lugar da barra do Windows: a mariposa,
// o nome e os três botões. Arrastar move a janela (o Windows ainda encaixa
// nas bordas da tela); clique duplo maximiza.
component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();

    background: Theme.surface-0;

    // Primeiro: fica atrás dos botões, que pegam o clique antes.
    TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag();
            }
        }
    }

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("icons/mothh.png");
    }
    Text {
        x: 36px;
        height: parent.height;
        text: root.title;
        font-family: Theme.pixel;
        font-size: 20px * Theme.pixel-scale;
        color: Theme.ink-muted;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: parent.width - self.width;
        width: 3 * 46px;
        height: parent.height;
        WindowButton {
            kind: "min";
            clicked => { root.minimize(); }
        }
        WindowButton {
            kind: root.maximized ? "restore" : "max";
            clicked => { root.toggle-maximize(); }
        }
        WindowButton {
            kind: "close";
            clicked => { root.close(); }
        }
    }

    // Linha de baixo, a mesma das divisões do app.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// Faixa invisível na borda da janela sem moldura: arrastar muda o tamanho.
// `dir` é o lado, como o winit chama ("n", "se", ...).
component ResizeEdge inherits TouchArea {
    in property <string> dir;
    callback resize(string);

    mouse-cursor: dir == "n" || dir == "s" ? MouseCursor.ns-resize
        : dir == "e" || dir == "w" ? MouseCursor.ew-resize
        : dir == "ne" || dir == "sw" ? MouseCursor.nesw-resize
        : MouseCursor.nwse-resize;
    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            root.resize(root.dir);
        }
    }
}

component MusicVolume inherits Rectangle {
    in property <int> value;
    callback moved-to(int);
    function pick(x: length) { root.moved-to(round(clamp((x - 5px) / max(1px, root.width - 10px), 0, 1) * 100)); }
    Rectangle { x: 5px; y: (parent.height - 2px) / 2; width: parent.width - 10px; height: 2px; background: #555; }
    Rectangle { x: 5px; y: (parent.height - 2px) / 2; width: (parent.width - 10px) * root.value / 100; height: 2px; background: #ccc; }
    Rectangle { x: (parent.width - 10px) * root.value / 100; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: Theme.ink; }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.pick(self.mouse-x); } }
        moved => { if self.pressed { root.pick(self.mouse-x); } }
        double-clicked => { root.moved-to(100); }
        scroll-event(event) => { if event.delta-y == 0 { return reject; } root.moved-to(clamp(root.value + (event.delta-y > 0 ? 5 : -5), 0, 100)); accept }
    }
}

// Cena GLB renderizada pelo Rust, com câmera orbital e disco independente.
component MusicPanel inherits Rectangle {
    in property <MusicViewData> data;
    in property <[MusicQueueRow]> queue;
    in property <[float]> bands;
    in property <image> turntable;
    callback orbit(float, float);
    callback reset-view();
    in-out property <string> query;
    in property <bool> preview-queue;
    changed preview-queue => { if root.preview-queue { queue-popup.show(); } }
    callback action(string, string);
    property <bool> narrow: root.width < 650px;
    property <length> slot-w: root.narrow ? 112px : min(212px, root.width * 0.24);
    property <length> body-x: root.slot-w + 24px;
    property <length> body-w: root.width - root.body-x - 16px;
    property <duration> received;
    changed data => { root.received = animation-tick(); }
    property <float> elapsed: min(root.data.duration-ms, root.data.position-ms + (root.data.playing ? (animation-tick() - root.received) / 1ms : 0));
    property <float> progress: root.data.duration-ms > 0 ? root.elapsed / root.data.duration-ms : 0;
    function clock(ms: float) -> string {
        let minutes = floor(ms / 60000);
        let seconds = floor(mod(ms / 1000, 60));
        return minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
    }
    function submit() {
        if root.data.online && !root.data.submitting && root.query != "" { root.action("enqueue", root.query); }
    }

    height: 224px;
    background: @linear-gradient(105deg, #141414, #0d0d0d);
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 4px;

    // O próprio GLB; arrastar orbita a câmera sem mexer na reprodução.
    Rectangle {
        x: 10px; y: 12px; width: root.slot-w; height: parent.height - 24px;
        background: #0c0c0c;
        border-color: #303030;
        border-width: 1px;
        border-radius: 3px;
        Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.turntable; image-fit: contain; image-rendering: pixelated; }
        model-area := TouchArea {
            property <length> last-x;
            property <length> last-y;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.last-x = self.mouse-x; self.last-y = self.mouse-y;
                }
            }
            moved => {
                if self.pressed {
                    root.orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                    self.last-x = self.mouse-x; self.last-y = self.mouse-y;
                }
            }
            double-clicked => { root.reset-view(); }
        }
        if model-area.has-hover && !model-area.pressed: Text {
            x: 4px; y: parent.height - 19px; width: parent.width - 8px; height: 16px;
            text: "arraste para girar"; font-family: Theme.pixel; font-size: 14px * Theme.pixel-scale;
            color: Theme.ink-muted; horizontal-alignment: center;
        }
    }

    Text {
        x: root.body-x; y: 12px; width: max(80px, root.body-w - 84px); height: 28px;
        text: root.data.title; font-family: Theme.pixel; font-size: (root.narrow ? 23px : 27px) * Theme.pixel-scale;
        font-weight: 700; color: Theme.ink; overflow: elide;
    }
    Text {
        x: root.body-x; y: 41px; width: max(80px, root.body-w - 80px); height: 21px;
        text: root.data.subtitle; font-family: Theme.pixel; font-size: 18px * Theme.pixel-scale;
        color: Theme.ink-muted; overflow: elide;
    }
    IconButton {
        x: parent.width - 84px; y: 7px; width: 32px; height: 32px;
        icon: @image-url("icons/music-queue.svg"); tip: "próximas músicas · " + root.data.queued;
        clicked => { queue-popup.show(); }
    }
    IconButton {
        x: parent.width - 46px; y: 7px; width: 32px; height: 32px;
        icon: @image-url("icons/music-external.svg"); tip: "abrir a música no YouTube";
        enabled: root.data.has-track;
        clicked => { root.action("source", ""); }
    }

    // Mesmo espaço das informações na referência; só estados reais da sala.
    Rectangle {
        x: root.body-x; y: 75px; width: root.narrow ? root.body-w : root.body-w * 0.52; height: 43px;
        Rectangle { x: 0; y: 0; width: 1px; background: Theme.border-strong; }
        Text { x: 9px; width: parent.width - 12px; height: 21px;
            text: "> " + root.data.status; font-family: Theme.pixel; font-size: 18px * Theme.pixel-scale;
            color: root.data.error != "" ? Theme.danger : Theme.ink; overflow: elide; }
        Text { x: 9px; y: 23px; width: parent.width - 12px; height: 20px;
            text: root.data.detail; font-family: Theme.pixel; font-size: 17px * Theme.pixel-scale;
            color: Theme.ink-muted; overflow: elide; }
    }
    if !root.narrow: Rectangle {
        x: root.body-x + root.body-w * 0.56; y: 61px; width: root.body-w * 0.44; height: 58px;
        for level[i] in root.bands: Rectangle {
            x: i * parent.width / 32;
            width: max(2px, parent.width / 32 - 3px);
            height: max(2px, level * parent.height);
            y: parent.height - self.height;
            background: @linear-gradient(0deg, #343434, #dedede);
            animate height { duration: 90ms; easing: linear; }
        }
    }
    Rectangle {
        x: root.body-x; y: 128px; width: root.body-w; height: 31px;
        background: #131313; border-color: request-input.has-focus ? #a0a0a0 : #393939;
        border-width: 1px; border-radius: 2px;
        Text { x: 9px; width: 14px; height: parent.height; text: ">"; vertical-alignment: center; font-family: Theme.pixel; font-size: 20px * Theme.pixel-scale; color: Theme.ink-muted; }
        request-input := TextInput {
            x: 27px; width: parent.width - 63px; height: parent.height;
            text <=> root.query; single-line: true; enabled: root.data.online && !root.data.submitting;
            font-family: Theme.pixel; font-size: 19px * Theme.pixel-scale; color: Theme.ink;
            vertical-alignment: center; accepted => { root.submit(); }
        }
        if root.query == "": Text {
            x: 27px; width: parent.width - 63px; height: parent.height;
            text: root.data.submitting ? "adicionando..." : "nome da música ou link do YouTube";
            font-family: Theme.pixel; font-size: 18px * Theme.pixel-scale; color: #777; vertical-alignment: center; overflow: elide;
        }
        Rectangle {
            x: parent.width - 32px; width: 32px; height: parent.height;
            background: add-area.has-hover ? Theme.surface-3 : transparent;
            Text { width: 100%; height: 100%; text: "+"; font-family: Theme.pixel; font-size: 26px * Theme.pixel-scale; color: root.data.online ? Theme.ink : #555; horizontal-alignment: center; vertical-alignment: center; }
            add-area := TouchArea { enabled: root.data.online && !root.data.submitting; mouse-cursor: pointer; clicked => { root.submit(); } }
        }
    }
    Rectangle {
        x: root.body-x; y: 172px; width: root.body-w; height: 2px;
        background: #3b3b3b;
        Rectangle { x: 0; y: 0; width: parent.width * root.progress; background: #aaa; }
        Rectangle { x: max(0px, (parent.width - 8px) * root.progress); y: -3px; width: 8px; height: 8px; border-radius: 4px; background: Theme.ink; }
    }
    Text { x: root.body-x; y: 187px; width: 43px; height: 23px; text: root.clock(root.elapsed); font-family: Theme.pixel; font-size: 18px * Theme.pixel-scale; color: Theme.ink; }
    if !root.narrow: Link {
        x: root.body-x + 47px; y: 189px; width: 100px; height: 23px;
        text: root.data.connecting ? "entrando..." : (root.data.listening ? "[ sair ]" : "[ ouvir ]");
        font-size: 17px;
        clicked => { root.action("listen", ""); }
    }
    // Play central pausa a sala para o condutor, ou só a escuta para os demais.
    IconButton {
        x: root.body-x + root.body-w * (root.narrow ? 0.29 : 0.44) - 16px; y: 181px; width: 32px; height: 32px;
        icon: root.data.listening && (root.data.playing || !root.data.can-control) ? @image-url("icons/music-pause.svg") : @image-url("icons/music-play.svg");
        active: root.data.playing && root.data.listening;
        enabled: root.data.online && root.data.has-track && !root.data.connecting && !root.data.buffering;
        tip: root.data.can-control && root.data.listening ? "pausar ou retomar para a sala" : (root.data.listening ? "parar de ouvir" : "ouvir a música");
        clicked => { root.action("play", ""); }
    }
    IconButton {
        x: root.body-x + root.body-w * (root.narrow ? 0.29 : 0.44) + 22px; y: 181px; width: 32px; height: 32px;
        icon: @image-url("icons/music-next.svg"); tip: "pular para a próxima música";
        enabled: root.data.online && root.data.can-control && root.data.has-track;
        clicked => { root.action("skip", ""); }
    }
    if !root.narrow: Text {
        x: parent.width - 197px; y: 187px; width: 43px; height: 23px;
        text: root.clock(root.data.duration-ms); font-family: Theme.pixel; font-size: 18px * Theme.pixel-scale; color: Theme.ink-muted;
    }
    Image { x: parent.width - 146px; y: 189px; width: 20px; height: 20px; source: @image-url("icons/music-volume.svg"); colorize: root.data.volume > 0 ? Theme.ink : Theme.ink-muted; }
    MusicVolume {
        x: parent.width - 119px; y: 187px; width: 103px; height: 24px;
        value: root.data.volume;
        moved-to(value) => { root.action("volume", "" + value); }
    }

    // Erros completos continuam acessíveis, sem empurrar o painel e o chat.
    if root.data.error != "": Rectangle {
        x: root.body-x; y: 73px; width: root.narrow ? root.body-w : root.body-w * 0.52; height: 48px;
        background: #15100f;
        Text { x: 7px; y: 1px; width: parent.width - 14px; height: 46px;
            text: root.data.error; wrap: word-wrap; overflow: elide; font-family: Theme.pixel; font-size: 16px * Theme.pixel-scale; color: Theme.danger;
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.action("refresh", ""); } }
    }

    queue-popup := PopupWindow {
        x: max(0px, root.width - self.width - 8px); y: 42px;
        width: min(380px, root.width - 16px); height: 300px;
        Rectangle {
            background: #111; border-color: Theme.border-strong; border-width: 1px; border-radius: 3px;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "PRÓXIMAS · " + root.data.queued; font-family: Theme.pixel; font-size: 23px * Theme.pixel-scale; color: Theme.ink; vertical-alignment: center; }
                    IconButton { width: 28px; height: 28px; icon: @image-url("icons/close.svg"); tip: "fechar fila"; clicked => { queue-popup.close(); } }
                }
                if root.queue.length == 0: Text { text: "A fila está vazia.\nAdicione uma música no painel."; color: Theme.ink-muted; font-family: Theme.pixel; font-size: 20px * Theme.pixel-scale; wrap: word-wrap; vertical-stretch: 1; }
                if root.queue.length > 0: ListView {
                    vertical-stretch: 1;
                    for item[i] in root.queue: Rectangle {
                        height: 56px;
                        background: mod(i, 2) == 0 ? #171717 : #111;
                        Text { x: 6px; y: 5px; width: parent.width - 43px; height: 23px; text: (i + 1) + ". " + item.title; font-family: Theme.pixel; font-size: 20px * Theme.pixel-scale; color: item.failed ? Theme.ink-muted : Theme.ink; overflow: elide; }
                        Text { x: 7px; y: 29px; width: parent.width - 44px; height: 20px; text: item.detail; font-family: Theme.pixel; font-size: 16px * Theme.pixel-scale; color: item.failed ? Theme.danger : Theme.ink-muted; overflow: elide; }
                        if item.can-remove: IconButton { x: parent.width - 31px; y: 12px; width: 28px; height: 28px; icon: @image-url("icons/close.svg"); tip: "remover pedido"; enabled: root.data.online; clicked => { root.action("remove", item.id); } }
                    }
                }
                if root.data.can-control: HorizontalLayout {
                    Link { text: "[ limpar fila ]"; clicked => { root.action("clear", ""); } }
                    Link { text: "[ parar tudo ]"; clicked => { root.action("stop", ""); queue-popup.close(); } }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.profile == "" ? "mothh" : "mothh · " + root.profile;
    init => { root.splash-started = animation-tick(); }
    // Ícone da janela e da barra de tarefas (logo temporária, a mariposa).
    icon: @image-url("icons/mothh.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.surface-0;
    default-font-family: Theme.sans;
    // Sem a barra do Windows: o app desenha a dele (`TitleBar`).
    no-frame: true;
    // O Rust avisa quando a janela maximiza ou volta (o ícone do botão muda
    // e as bordas de mudar o tamanho somem).
    in property <bool> window-maximized;
    // Altura da barra; some no vídeo em tela cheia.
    property <length> bar-h: root.full-tile != "" ? 0 : 32px;

    in property <[ConversationRow]> conversations;
    in property <MusicViewData> music-data;
    // Suspenso na 0.5.1: atividade no perfil não publica áudio.
    property <bool> shared-music-enabled: false;
    in property <image> turntable-frame;
    callback turntable-visibility(bool);
    callback turntable-playing(bool);
    callback turntable-track(string);
    callback turntable-orbit(float, float);
    callback turntable-reset();
    callback open-spotify(string, string);
    out property <bool> activity-playing: root.logged-in && ((root.card-open && root.card.listening-title != "") || (root.page-open && root.page.listening-title != ""));
    changed activity-playing => { root.turntable-playing(root.activity-playing); }
    out property <bool> turntable-visible: root.activity-playing && !root.settings-open && !root.profile-open && root.full-tile == "";
    changed turntable-visible => { root.turntable-visibility(root.turntable-visible); }
    in property <bool> music-queue-preview;
    in property <[MusicQueueRow]> music-queue;
    in property <[float]> music-bands;
    in-out property <string> music-query;
    in property <string> music-room-name;
    in property <string> music-room-id;
    callback music-action(string, string);
    // "ping 180 ms" na faixa da chamada (vazio sem medida).
    in property <string> call-ping;
    // Quem está na chamada da conversa aberta, quando não estamos nela.
    in property <[CallFace]> open-call-faces;
    in property <[MessageRow]> messages;
    in property <[MemberRow]> members;
    in property <string> open-title;
    // A conversa aberta é um grupo criado por alguém (dá para convidar e sair).
    in property <bool> open-is-group;
    // A conversa aberta é direta: a chamada é 1:1 e quem está nela "te chama".
    in property <bool> open-is-direct;
    in property <bool> members-open;
    // O formulário de grupo novo está aberto; o Rust fecha quando o grupo nasce.
    in-out property <bool> creating-group;
    // Erro do último pedido de grupo (criar, convidar, remover, sair).
    in-out property <string> group-error;
    in property <string> status: "conectando...";
    // Atualização automática (`update.rs`): a versão nova, se já está baixada
    // (dá para reiniciar) e a página dela (versão portátil só abre a página).
    in property <string> update-version;
    in property <bool> update-ready;
    in property <string> update-page;
    in property <string> app-version;
    in property <string> user-name;
    // Primeira letra do nome, para quem ainda não tem foto.
    in property <string> user-initial;
    in property <string> profile;
    in-out property <string> pending-name;
    // Miniatura do anexo pendente quando é imagem (vazia se não for).
    in-out property <image> pending-preview;
    callback cancel-attachment();
    in-out property <bool> image-open;
    in-out property <image> viewer-image;
    in-out property <string> viewer-id;
    in-out property <string> viewer-name;
    in-out property <float> viewer-zoom: 1;
    callback open-image(string, string);
    in-out property <image> profile-photo;
    callback pick-profile-photo();
    in property <bool> logged-in;
    in property <bool> connecting: true;
    in-out property <string> auth-error;
    // Existem mensagens mais antigas no servidor / já foram pedidas.
    in property <bool> has-older;
    in property <bool> loading-older;
    // O Rust liga antes de pôr mensagens no topo da lista; a tela mantém o
    // ponto de leitura e desliga de novo.
    in-out property <bool> keep-from-bottom;
    // Campo "nova conversa": o Rust limpa quando a conversa abre, e mostra o
    // erro embaixo quando a busca não dá certo.
    in-out property <string> direct-search;
    in property <string> direct-error;
    // Lista da tela de configurações e se ela está aberta no lugar da conversa.
    in property <[ModuleRow]> modules;
    in-out property <bool> settings-open;
    // Tela de carregamento (a mariposa): abre com o app, buscando atualização,
    // e de novo pelo botão "buscar atualização" das configurações.
    in-out property <bool> splash-open: true;
    in-out property <string> splash-status: "BUSCANDO ATUALIZAÇÕES";
    in-out property <bool> splash-leaving;
    in-out property <bool> splash-can-skip;
    in-out property <bool> splash-ask-restart;
    in-out property <duration> splash-started;
    callback check-updates();
    callback splash-skip();
    callback splash-restart();
    // Página de perfil (clicar na sua foto ou no seu nome, no rodapé).
    in-out property <bool> profile-open;
    in-out property <string> profile-name-message;
    in-out property <bool> profile-name-error;
    in-out property <string> profile-password-message;
    in-out property <bool> profile-password-error;
    callback rename-user(string);
    callback change-password(string, string);
    // Quadro atual do fundo em dither; o Rust troca alguns por segundo.
    in property <image> dither-frame;
    // O botão "mic" está apertado e o microfone gravando ("0:03").
    in property <bool> recording;
    in property <string> recording-time;
    // O áudio tocando agora (id do anexo; vazio se nenhum) e onde ele está.
    in property <string> playing-id;
    in property <float> playing-progress;
    in property <string> playing-time;
    // A conversa aberta tem chamada (é um grupo).
    in property <bool> can-call;
    // Nome da conversa da chamada em que estamos ou entrando (vazio: nenhuma),
    // e se é a que está aberta.
    in property <string> call-name;
    in property <bool> call-is-open;
    // Já conectou (antes disso, "entrando...") e se o microfone está mudo.
    in property <bool> call-connected;
    in property <bool> call-muted;
    // Quem está na chamada e quem fala agora.
    in property <[CallPersonRow]> call-people;
    in property <bool> call-camera;
    // Estamos compartilhando a tela; a lista para escolher qual está aberta.
    in property <bool> call-sharing;
    in property <bool> share-picker-open;
    in property <[ShareSourceRow]> share-screens;
    in property <[ShareSourceRow]> share-windows;
    // Levar o som junto com a tela; o Rust põe a escolha da última vez ao
    // abrir a lista. Só o Windows sabe gravar o som da tela por enquanto.
    in-out property <bool> share-audio: true;
    in property <bool> share-audio-supported;
    // Listas das configurações: microfone, saída e câmera (a primeira opção
    // é o padrão do sistema) e a posição da escolhida.
    // Fontes (V6-05): as opções de cada família e a escolhida.
    in property <[string]> font-pixel-options;
    in property <int> font-pixel-choice;
    in property <[string]> font-sans-options;
    in property <int> font-sans-choice;
    in property <[string]> mic-options;
    in property <int> mic-choice;
    in property <[string]> speaker-options;
    in property <int> speaker-choice;
    in property <[string]> camera-options;
    in property <int> camera-choice;
    // Teste da câmera nas configurações (`video::start_test`).
    in property <bool> camera-testing;
    in property <image> camera-test-frame;
    in property <string> camera-test-status;
    // Câmeras e telas na chamada; `video.rs` troca o quadro de cada uma.
    in property <[VideoTile]> video-tiles;
    // O tile ampliado (id; vazio: nenhum). Clicar num tile amplia ou volta;
    // o Rust limpa quando o tile some.
    in-out property <string> big-tile;
    // O vídeo em tela cheia (id; vazio: nenhum). Cobre a janela toda e põe
    // ela em tela cheia; Esc ou clique duplo sai.
    in-out property <string> full-tile;
    // Na tela cheia: a coluna com a câmera (ou a foto) de cada amigo.
    in-out property <bool> reactions-open;
    // Mixer aberto, e onde fica o botão dele (o painel abre embaixo).
    property <bool> mixer-open;
    property <length> mixer-x;
    property <length> mixer-y;
    // Menu do botão direito: de quem (id da pessoa; vazio nos nossos
    // vídeos), de qual vídeo (vazio: clicou no nome), o título e onde abrir.
    property <bool> menu-open;
    property <string> menu-person;
    property <string> menu-tile;
    property <string> menu-title;
    property <length> menu-x;
    property <length> menu-y;

    function open-menu(person: string, tile: string, title: string, x: length, y: length) {
        Tip.text = "";
        root.menu-person = person;
        root.menu-tile = tile;
        root.menu-title = title;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-open = true;
    }

    changed full-tile => {
        root.set-window-fullscreen(self.full-tile != "");
        root.focus-changed(self.big-tile, self.full-tile);
    }
    changed big-tile => { root.focus-changed(self.big-tile, self.full-tile); }
    changed call-is-open => {
        if !self.call-is-open {
            root.mixer-open = false;
            root.menu-open = false;
            root.full-tile = "";
        }
    }

    // A lista está colada no fim: mensagem nova faz ela descer junto.
    property <bool> stick-to-bottom: true;
    // Altura do conteúdo antes da última mudança, para saber quanto entrou.
    property <length> last-content-height;

    callback login(string, string);
    callback register(string, string);
    callback logout();
    callback open-conversation(string);
    callback send-message(string);
    // Editar (id, texto novo) e apagar (id) uma mensagem minha.
    callback edit-chat-message(string, string);
    callback delete-chat-message(string);
    // A mensagem que está no campo para editar; vazio: escrevendo uma nova.
    in-out property <string> editing-id;
    callback load-older();
    callback open-direct(string);
    callback create-group(string);
    callback show-members(bool);
    callback invite(string);
    callback remove-member(string);
    callback leave-group();
    callback toggle-module(string, bool);
    // Segurar o "mic" grava; soltar em cima envia, soltar fora cancela.
    callback start-recording();
    callback stop-recording();
    callback cancel-recording();
    callback play-audio(string);
    callback stop-audio();
    callback pick-file();
    // Ctrl+V no campo do chat: `true` quando a área de transferência tinha
    // imagem ou arquivos e eles viraram anexo; `false` deixa colar o texto.
    callback paste-clipboard() -> bool;
    callback save-file(string, string);
    callback join-call();
    callback leave-call();
    callback toggle-mute();
    callback toggle-camera();
    // Minimiza o app e abre a janelinha do overlay (`overlay.rs`).
    callback open-overlay();
    callback open-share-picker();
    callback close-share-picker();
    // O id da tela ou janela, e se vai com som.
    callback start-share(string, bool);
    // A tela de configurações abriu: procura os dispositivos de novo.
    callback refresh-devices();
    callback choose-device(string, int);
    // "pixel" ou "sans", e o índice na lista.
    callback choose-font(string, int);
    // Redução de ruído do microfone (configurações > chamada).
    in-out property <int> noise-level: 50;
    callback set-noise-level(int);
    // Liga (`true`) ou desliga o teste da câmera.
    callback test-camera(bool);
    callback stop-share();
    // Volume de alguém para nós: id da pessoa, se é o som da tela, em %.
    callback set-volume(string, bool, int);
    callback set-window-fullscreen(bool);
    // Assistir ou parar de assistir a tela de alguém (id da pessoa).
    callback watch-screen(string, bool);
    // Mudou o vídeo ampliado ou em tela cheia: a câmera dele vem maior.
    callback focus-changed(string, string);
    callback window-drag();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback window-resize(string);
    // Muda o tamanho: o Rust confere se maximizou (arrastar para o topo da
    // tela também maximiza).
    callback window-changed();
    changed width => { root.window-changed(); }
    changed height => { root.window-changed(); }
    callback apply-update();
    callback open-update-page(string);

    // Perfis (`profiles.rs`): o seu id, se o servidor guarda páginas, o mini
    // cartão (um clique em alguém) e a página completa.
    in property <string> my-id;
    in property <bool> profiles-supported;
    in-out property <bool> card-open;
    in property <ProfileViewData> card;
    in property <image> card-photo;
    in property <image> card-small-photo;
    in property <image> card-background;
    in-out property <length> card-x;
    in-out property <length> card-y;
    in-out property <bool> page-open;
    in property <ProfileViewData> page;
    in property <image> page-photo;
    in property <image> page-small-photo;
    in property <image> page-background;
    in property <image> page-art;
    in property <image> page-art-side;
    // O editor da sua página (dentro de "editar perfil").
    in-out property <string> edit-real-name;
    in-out property <string> edit-location;
    in-out property <string> edit-about;
    in-out property <string> edit-accent;
    in-out property <bool> edit-show-art: true;
    in-out property <bool> edit-show-about: true;
    in property <image> edit-avatar;
    in property <image> edit-background;
    in property <image> edit-art;
    in property <image> edit-art-side;
    in-out property <string> edit-message;
    in-out property <bool> edit-error;
    // Pede o perfil de alguém (id, nome que a tela já sabe) para o cartão
    // (`false`) ou para a página (`true`).
    callback request-profile(string, string, bool);
    // Fechou o cartão (`false`) ou a página (`true`).
    callback profile-hidden(bool);
    callback save-profile();
    callback pick-profile-image(string);
    callback remove-profile-image(string);

    // Um clique em alguém: o mini cartão aparece perto do clique.
    function show-card(id: string, name: string, x: length, y: length) {
        if id == "" {
            return;
        }
        Tip.text = "";
        root.menu-open = false;
        root.card-x = x;
        root.card-y = y;
        root.card-open = true;
        root.request-profile(id, name, false);
    }
    // "ver perfil": a página no lugar da conversa.
    function open-page(id: string, name: string) {
        root.card-open = false;
        root.settings-open = false;
        root.profile-open = false;
        root.full-tile = "";
        root.page-open = true;
        root.request-profile(id, name, true);
    }
    function edit-my-profile() {
        root.card-open = false;
        root.page-open = false;
        root.settings-open = false;
        root.profile-open = true;
        root.profile-name-message = "";
        root.profile-password-message = "";
        root.edit-message = "";
    }
    changed card-open => {
        if !self.card-open {
            root.profile-hidden(false);
        }
    }
    changed page-open => {
        if !self.page-open {
            root.profile-hidden(true);
        }
    }

    // Fechar as configurações desliga o teste, para soltar a câmera.
    changed open-title => { root.cancel-attachment(); root.music-query = ""; }
    changed logged-in => {
        root.cancel-attachment();
        root.image-open = false;
    }
    changed settings-open => {
        if !root.settings-open && root.camera-testing {
            root.test-camera(false);
        }
    }

    if root.bar-h > 0: TitleBar {
        y: 0;
        height: root.bar-h;
        title: root.title;
        maximized: root.window-maximized;
        drag => { root.window-drag(); }
        minimize => { root.window-minimize(); }
        toggle-maximize => { root.window-toggle-maximize(); }
        close => { root.window-close(); }
    }

    if !root.logged-in: LoginScreen {
        y: root.bar-h;
        height: root.height - root.bar-h;
        connecting: root.connecting;
        error <=> root.auth-error;
        login(username, password) => { root.login(username, password); }
        register(username, password) => { root.register(username, password); }
    }

    if root.logged-in: HorizontalLayout {
        y: root.bar-h;
        height: root.height - root.bar-h;
        // Coluna da esquerda: lista de conversas.
        Rectangle {
            width: 320px;
            background: Theme.surface-0;

            // Primeiro filho: fica atrás de todo o resto da coluna.
            if Modules.dither: Image {
                width: parent.width;
                height: parent.height;
                source: root.dither-frame;
                image-fit: fill;
                image-rendering: pixelated;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: "CONVERSAS";
                        font-family: Theme.pixel;
                        font-size: 26px * Theme.pixel-scale;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                    Link {
                        text: root.creating-group ? "cancelar" : "+ grupo";
                        font-size: 22px;
                        vertical-alignment: center;
                        clicked => {
                            root.group-error = "";
                            root.creating-group = !root.creating-group;
                        }
                    }
                }

                if root.creating-group: VerticalLayout {
                    spacing: 8px;
                    FieldLabel { text: "nome do grupo"; }
                    group-name := Field {
                        accepted => {
                            root.group-error = "";
                            root.create-group(self.text);
                        }
                    }
                    ErrorLine { message: root.group-error; }
                    init => { group-name.focus(); }
                }

                VerticalLayout {
                    spacing: 4px;
                    Field {
                        placeholder: "conversar com... (usuário)";
                        text <=> root.direct-search;
                        accepted => {
                            root.stick-to-bottom = true;
                            root.open-direct(self.text);
                        }
                    }
                    if root.direct-error != "": Text {
                        text: "! " + root.direct-error;
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for row in root.conversations: ConversationItem {
                        item: row;
                        clicked => {
                            // Conversa recém-aberta começa pelo fim.
                            root.stick-to-bottom = true;
                            root.page-open = false;
                            root.editing-id = "";
                            root.open-conversation(row.id);
                        }
                    }
                }

                // Na chamada de outra conversa: dá para sair sem abrir ela.
                if root.shared-music-enabled && root.music-room-name != "" && Modules.music: HorizontalLayout {
                    spacing: 6px;
                    Image { width: 24px; height: 28px; source: root.turntable-frame; image-fit: contain; image-rendering: pixelated; }
                    Link { text: root.music-room-name; height: 28px; horizontal-stretch: 1; overflow: elide;
                        clicked => { root.open-conversation(root.music-room-id); root.music-action("show", ""); } }
                    IconButton { width: 28px; height: 28px; icon: @image-url("icons/music-stop.svg"); tip: "parar de ouvir música"; clicked => { root.music-action("leave", ""); } }
                }

                if root.call-name != "" && !root.call-is-open: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "▪ na chamada: " + root.call-name;
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.call-connected: IconButton {
                        icon: root.call-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                        danger: root.call-muted;
                        tip: root.call-muted ? "ligar o microfone" : "mutar o microfone";
                        clicked => { root.toggle-mute(); }
                    }
                    IconButton {
                        icon: @image-url("icons/overlay.svg");
                        tip: "modo overlay";
                        clicked => { root.open-overlay(); }
                    }
                    IconButton {
                        icon: @image-url("icons/leave.svg");
                        danger: true;
                        tip: "sair da chamada";
                        clicked => { root.leave-call(); }
                    }
                }

                // Versão nova: uma linha discreta, sem interromper nada.
                if root.update-version != "": HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.update-ready
                            ? "▪ " + root.update-version + " pronta"
                            : "▪ " + root.update-version + " disponível";
                        font-family: Theme.pixel;
                        font-size: 20px * Theme.pixel-scale;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Link {
                        text: root.update-ready ? "[ reiniciar ]" : "[ baixar ]";
                        vertical-alignment: center;
                        clicked => {
                            if root.update-ready {
                                root.apply-update();
                            } else {
                                root.open-update-page(root.update-page);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    // Foto e nome: abrem (e fecham) a página de perfil.
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 2px;
                        background: root.profile-open ? Theme.surface-3 : (me-area.has-hover ? Theme.surface-2 : transparent);
                        me-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.card-open && root.card.is-me {
                                    root.card-open = false;
                                } else {
                                    root.show-card(root.my-id, root.user-name,
                                        self.absolute-position.x + 8px, self.absolute-position.y - 8px);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding: 2px;
                            ProfilePhoto {
                                photo: root.profile-photo;
                                initial: root.user-initial;
                                size: 32px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.user-name + " · " + root.status;
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: me-area.has-hover || root.profile-open ? Theme.ink : Theme.ink-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/gear.svg");
                        active: root.settings-open;
                        tip: root.settings-open ? "fechar configurações" : "configurações";
                        clicked => {
                            root.settings-open = !root.settings-open;
                            if root.settings-open {
                                root.profile-open = false;
                                root.refresh-devices();
                            }
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/logout.svg");
                        tip: "sair da conta";
                        clicked => { root.logout(); }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        if root.profile-open && !root.settings-open: ProfilePanel {
            horizontal-stretch: 1;
            profile-photo: root.profile-photo;
            user-name: root.user-name;
            initial: root.user-initial;
            status: root.status;
            banner: root.dither-frame;
            name-message: root.profile-name-message;
            name-error: root.profile-name-error;
            password-message: root.profile-password-message;
            password-error: root.profile-password-error;
            pick-photo => { root.pick-profile-photo(); }
            rename(name) => {
                root.profile-name-message = "salvando...";
                root.profile-name-error = false;
                root.rename-user(name);
            }
            change-password(current, new) => {
                root.profile-password-message = "trocando...";
                root.profile-password-error = false;
                root.change-password(current, new);
            }
            close => { root.profile-open = false; }
            profiles-supported: root.profiles-supported;
            real-name <=> root.edit-real-name;
            location <=> root.edit-location;
            about <=> root.edit-about;
            accent <=> root.edit-accent;
            show-art <=> root.edit-show-art;
            show-about <=> root.edit-show-about;
            page-background: root.edit-background;
            page-art: root.edit-art;
            page-art-side: root.edit-art-side;
            page-message: root.edit-message;
            page-error: root.edit-error;
            save-page => {
                root.edit-message = "salvando...";
                root.edit-error = false;
                root.save-profile();
            }
            pick-page-image(kind) => { root.pick-profile-image(kind); }
            remove-page-image(kind) => { root.remove-profile-image(kind); }
            view-page => { root.open-page(root.my-id, root.user-name); }
        }

        if root.settings-open: SettingsPanel {
            horizontal-stretch: 1;
            modules: root.modules;
            mic-options: root.mic-options;
            mic-choice: root.mic-choice;
            speaker-options: root.speaker-options;
            speaker-choice: root.speaker-choice;
            camera-options: root.camera-options;
            camera-choice: root.camera-choice;
            camera-testing: root.camera-testing;
            camera-test-frame: root.camera-test-frame;
            camera-test-status: root.camera-test-status;
            version: root.app-version;
            test-camera(on) => { root.test-camera(on); }
            toggle(id, on) => { root.toggle-module(id, on); }
            noise-level: root.noise-level;
            set-noise-level(v) => { root.set-noise-level(v); }
            choose-device(kind, i) => { root.choose-device(kind, i); }
            font-pixel-options: root.font-pixel-options;
            font-pixel-choice: root.font-pixel-choice;
            font-sans-options: root.font-sans-options;
            font-sans-choice: root.font-sans-choice;
            choose-font(kind, i) => { root.choose-font(kind, i); }
            check-updates => {
                root.splash-status = "BUSCANDO ATUALIZAÇÕES";
                root.splash-leaving = false;
                root.splash-can-skip = false;
                root.splash-ask-restart = false;
                root.splash-started = animation-tick();
                root.splash-open = true;
                root.check-updates();
            }
            close => { root.settings-open = false; }
        }

        // A página de perfil de alguém, no lugar da conversa.
        if root.page-open && !root.settings-open && !root.profile-open: ProfilePage {
            turntable: root.turntable-frame;
            open-spotify(title, artist) => { root.open-spotify(title, artist); }
            horizontal-stretch: 1;
            data: root.page;
            photo: root.page-photo;
            small-photo: root.page-small-photo;
            bg-image: root.page-background;
            art: root.page-art;
            art-side: root.page-art-side;
            dither: root.dither-frame;
            close => { root.page-open = false; }
            edit => { root.edit-my-profile(); }
            message => {
                root.page-open = false;
                root.open-direct(root.page.name);
            }
        }

        // Coluna da direita: conversa aberta.
        if !root.settings-open && !root.profile-open && !root.page-open: Rectangle {
            background: Theme.surface-1;
            horizontal-stretch: 1;

            VerticalLayout {
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        // Os botões de ícone têm 36px: sobra 14px em cima e embaixo.
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        Text {
                            text: root.open-title == "" ? "> escolha uma conversa" : root.open-title;
                            font-family: Theme.pixel;
                            font-size: 28px * Theme.pixel-scale;
                            color: root.open-title == "" ? Theme.ink-muted : Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Chamada acontecendo sem a gente: quem está nela.
                        if !root.call-is-open && root.open-call-faces.length > 0: HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: 0;
                            Text {
                                horizontal-stretch: 0;
                                text: root.open-is-direct ? "está te chamando" : "na chamada";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                vertical-alignment: center;
                            }
                            for face in root.open-call-faces: FaceChip {
                                face: face;
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.show-card(face.id, face.name,
                                        self.absolute-position.x, self.absolute-position.y + self.height);
                                }
                            }
                        }
                        if root.shared-music-enabled && root.can-call && Modules.music: IconButton {
                            icon: root.turntable-frame;
                            model-icon: true;
                            active: root.music-data.panel-open;
                            tip: root.music-data.panel-open ? "fechar música" : "música da sala";
                            clicked => { root.music-action("toggle", ""); }
                        }
                        if root.can-call && !root.call-is-open: IconButton {
                            property <bool> ringing: root.open-is-direct && root.open-call-faces.length > 0;
                            icon: @image-url("icons/phone.svg");
                            active: self.ringing;
                            tip: self.ringing ? "atender" : root.open-is-direct ? "ligar" : "entrar na chamada";
                            clicked => { root.join-call(); }
                        }
                        if root.call-is-open && !root.call-connected: Text {
                            text: "entrando...";
                            font-family: Theme.pixel;
                            font-size: 22px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            vertical-alignment: center;
                        }
                        if root.call-is-open && root.call-connected: HorizontalLayout {
                            spacing: 4px;
                            IconButton {
                                icon: root.call-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                                danger: root.call-muted;
                                tip: root.call-muted ? "ligar o microfone" : "mutar o microfone";
                                clicked => { root.toggle-mute(); }
                            }
                            IconButton {
                                icon: root.call-camera ? @image-url("icons/camera.svg") : @image-url("icons/camera-off.svg");
                                active: root.call-camera;
                                tip: root.call-camera ? "desligar a câmera" : "ligar a câmera";
                                clicked => { root.toggle-camera(); }
                            }
                            IconButton {
                                icon: @image-url("icons/screen.svg");
                                active: root.call-sharing || root.share-picker-open;
                                tip: root.call-sharing ? "parar de mostrar a tela" : "mostrar a tela ou uma janela";
                                clicked => {
                                    if root.call-sharing {
                                        root.stop-share();
                                    } else if root.share-picker-open {
                                        root.close-share-picker();
                                    } else {
                                        root.open-share-picker();
                                    }
                                }
                            }
                            mixer-button := IconButton {
                                icon: @image-url("icons/mixer.svg");
                                active: root.mixer-open;
                                tip: root.mixer-open ? "fechar o mixer" : "volume de cada pessoa";
                                clicked => {
                                    root.mixer-x = mixer-button.absolute-position.x + mixer-button.width;
                                    root.mixer-y = mixer-button.absolute-position.y + mixer-button.height + 6px;
                                    root.mixer-open = !root.mixer-open;
                                }
                            }
                            IconButton {
                                icon: @image-url("icons/overlay.svg");
                                tip: "modo overlay: minimiza e deixa só uma janelinha";
                                clicked => { root.open-overlay(); }
                            }
                        }
                        if root.call-is-open: IconButton {
                            icon: @image-url("icons/leave.svg");
                            danger: true;
                            tip: "sair da chamada";
                            clicked => { root.leave-call(); }
                        }
                        if root.open-is-group: IconButton {
                            icon: @image-url("icons/members.svg");
                            active: root.members-open;
                            tip: root.members-open ? "fechar membros" : "membros do grupo";
                            clicked => {
                                root.group-error = "";
                                root.show-members(!root.members-open);
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // Na chamada desta conversa: quem está nela, e quem fala em destaque.
                if root.call-is-open && root.call-connected && root.call-people.length > 0: Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;
                        alignment: start;
                        for person in root.call-people: CallAvatar {
                            name: person.name;
                            initial: person.initial;
                            // A sua foto é a do perfil, mesmo antes de o servidor ter.
                            photo: person.is-me ? root.profile-photo : person.photo;
                            has-photo: person.is-me ? root.profile-photo.width > 0 : person.has-photo;
                            level: person.level;
                            speaking: person.speaking;
                            muted: person.muted;
                            quality: person.quality;
                            ping: person.ping;
                            menu(x, y) => {
                                if !person.is-me {
                                    root.open-menu(person.id, "", person.name, x, y);
                                }
                            }
                            clicked(x, y) => { root.show-card(person.is-me ? root.my-id : person.id, person.name, x, y); }
                        }
                        // O seu ping até o servidor de chamadas.
                        if root.call-ping != "": Text {
                            text: root.call-ping;
                            font-family: Theme.pixel;
                            font-size: 18px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                if root.shared-music-enabled && root.can-call && Modules.music && root.music-data.panel-open: Rectangle {
                    height: 244px;
                    MusicPanel {
                        x: 12px; y: 10px; width: parent.width - 24px;
                        data: root.music-data;
                        preview-queue: root.music-queue-preview;
                        queue: root.music-queue;
                        bands: root.music-bands;
                        turntable: root.turntable-frame;
                        orbit(dx, dy) => { root.turntable-orbit(dx, dy); }
                        reset-view => { root.turntable-reset(); }
                        query <=> root.music-query;
                        action(kind, payload) => { root.music-action(kind, payload); }
                    }
                }

                // O tile ampliado (uma tela compartilhada, ou uma câmera
                // clicada) ocupa a largura toda, até metade da janela.
                if root.call-is-open && root.big-tile != "": big := Rectangle {
                    height: min(root.height / 2, (self.width - 32px) * 9 / 16) + 16px;
                    for tile in root.video-tiles: Rectangle {
                        x: 16px;
                        y: 8px;
                        width: parent.width - 32px;
                        height: parent.height - 16px;
                        visible: tile.id == root.big-tile;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 2px;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: tile.frame;
                            image-fit: contain;
                        }
                        Rectangle {
                            x: 4px;
                            y: parent.height - self.height - 4px;
                            width: big-label.preferred-width + 8px;
                            height: big-label.preferred-height;
                            background: Theme.surface-0;
                            big-label := Text {
                                text: tile.name + " · clique para reduzir · botão direito: volume e tela cheia";
                                font-family: Theme.pixel;
                                font-size: 18px * Theme.pixel-scale;
                                color: Theme.ink;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.big-tile = ""; }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.open-menu(tile.person, tile.id, tile.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // Câmeras e telas da chamada aberta, lado a lado em 16:9. Com
                // muita gente, os tiles encolhem para caber na largura. Clicar
                // num tile amplia ele.
                if root.call-is-open && root.video-tiles.length > 0: strip := Rectangle {
                    // Posição à mão em vez de HorizontalLayout: com layout, a
                    // largura dos tiles dependeria dela mesma.
                    property <length> tile-width: min(240px, (self.width - 32px - 8px * (root.video-tiles.length - 1)) / root.video-tiles.length);
                    height: self.tile-width * 9 / 16 + 16px;
                    for tile[i] in root.video-tiles: Rectangle {
                        x: 16px + i * (strip.tile-width + 8px);
                        y: 8px;
                        width: strip.tile-width;
                        height: strip.tile-width * 9 / 16;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: tile.id == root.big-tile ? Theme.ink : Theme.border;
                        border-radius: 2px;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: tile.frame;
                            image-fit: contain;
                        }
                        tile-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if tile.waiting {
                                    root.watch-screen(tile.person, true);
                                } else {
                                    root.big-tile = root.big-tile == tile.id ? "" : tile.id;
                                }
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.open-menu(tile.person, tile.waiting ? "" : tile.id, tile.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        // A tela de alguém que ainda não baixamos: o botão de
                        // assistir no meio do tile.
                        if tile.waiting: Rectangle {
                            width: watch-row.preferred-width;
                            height: watch-row.preferred-height;
                            y: (parent.height - self.height) / 2 - 8px;
                            background: tile-area.has-hover ? Theme.ink : Theme.surface-0;
                            border-width: 1px;
                            border-color: Theme.ink;
                            border-radius: 2px;
                            watch-row := HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 6px;
                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: @image-url("icons/screen.svg");
                                    colorize: tile-area.has-hover ? Theme.surface-0 : Theme.ink;
                                }
                                Text {
                                    text: "assistir";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    vertical-alignment: center;
                                    color: tile-area.has-hover ? Theme.surface-0 : Theme.ink;
                                }
                            }
                        }
                        Rectangle {
                            x: 4px;
                            y: parent.height - self.height - 4px;
                            width: label.preferred-width + 8px;
                            height: label.preferred-height;
                            background: Theme.surface-0;
                            label := Text {
                                text: tile.name;
                                font-family: Theme.pixel;
                                font-size: 18px * Theme.pixel-scale;
                                color: Theme.ink;
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // ScrollView em vez de ListView: a ListView estima a altura das
                // linhas que ainda não desenhou, e com mensagens de tamanhos
                // diferentes o "fim da lista" ficava no lugar errado.
                messages-scroll := ScrollView {
                    vertical-stretch: 1;

                    changed content-height => {
                        if root.stick-to-bottom {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        } else if root.keep-from-bottom {
                            // Entrou coisa em cima: desce o mesmo tanto para o texto
                            // que estava na tela não sair do lugar.
                            self.content-y -= self.content-height - root.last-content-height;
                        }
                        root.keep-from-bottom = false;
                        root.last-content-height = self.content-height;
                    }
                    changed visible-height => {
                        if root.stick-to-bottom {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                    }
                    changed content-y => {
                        // Uma folga pequena: chegar "quase" no fim já conta.
                        root.stick-to-bottom = self.content-y <= self.visible-height - self.content-height + 8px;
                        if self.content-y >= -1px && root.has-older && !root.loading-older {
                            root.load-older();
                        }
                    }

                    VerticalLayout {
                        width: messages-scroll.visible-width;
                        // Sem isto, com poucas mensagens o layout estica cada uma
                        // até encher a tela.
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 8px;

                        if root.open-title != "": Text {
                            height: 36px;
                            text: root.loading-older ? "> carregando..."
                                : root.has-older ? "> role para cima para ver mais"
                                : "> início da conversa";
                            font-family: Theme.pixel;
                            font-size: 20px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for row in root.messages: MessageItem {
                            item: row;
                            playing: row.audio-id != "" && row.audio-id == root.playing-id;
                            progress: self.playing ? root.playing-progress : 0;
                            elapsed: root.playing-time;
                            play-audio(id) => { root.play-audio(id); }
                            stop-audio => { root.stop-audio(); }
                            save-file(id, name) => { root.save-file(id, name); }
                            view-image(id, name) => { root.open-image(id, name); }
                            author-clicked(id, name, x, y) => { root.show-card(id, name, x, y); }
                            edit(id, text) => {
                                root.editing-id = id;
                                input.text = text;
                                input.focus();
                            }
                            delete(id) => { root.delete-chat-message(id); }
                        }
                    }
                }

                // Campo de mensagem com cara de terminal: "> " e cursor.
                Rectangle {
                    height: 80px;
                    Rectangle {
                        x: 16px;
                        y: 16px;
                        // Sobra lugar à direita para arquivo e microfone.
                        width: parent.width - 32px - 112px;
                        height: 48px;
                        border-radius: 2px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: input.has-focus ? Theme.ink : Theme.border-strong;

                        // Clicar em qualquer parte da caixa foca o campo.
                        TouchArea {
                            mouse-cursor: text;
                            clicked => { input.focus(); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text {
                                text: ">";
                                font-family: Theme.pixel;
                                font-size: 22px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            FocusScope {
                                horizontal-stretch: 1;
                                focus-on-click: false;
                                capture-key-pressed(event) => {
                                    if event.modifiers.control && (event.text == "v" || event.text == "V") && root.paste-clipboard() {
                                        return accept;
                                    }
                                    if event.text == Key.Escape && root.editing-id != "" {
                                        root.editing-id = "";
                                        input.text = "";
                                        return accept;
                                    }
                                    reject
                                }
                                HorizontalLayout {
                                    input := TextInput {
                                        horizontal-stretch: 1;
                                        enabled: root.open-title != "";
                                        font-family: Theme.sans;
                                        font-size: 15px * Theme.sans-scale;
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            if root.editing-id != "" {
                                                root.edit-chat-message(root.editing-id, self.text);
                                                root.editing-id = "";
                                            } else {
                                                root.send-message(self.text);
                                            }
                                            self.text = "";
                                        }
                                    }
                                }
                            }
                        }

                        // Enquanto grava, o aviso cobre o campo de texto.
                        if root.recording: Rectangle {
                            border-radius: 2px;
                            background: Theme.surface-2;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                Rectangle {
                                    width: 10px;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: Theme.danger;
                                    }
                                }
                                Text {
                                    text: "gravando " + root.recording-time;
                                    font-family: Theme.pixel;
                                    font-size: 22px * Theme.pixel-scale;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "solte para enviar · arraste para fora para cancelar";
                                    font-family: Theme.pixel;
                                    font-size: 20px * Theme.pixel-scale;
                                    color: Theme.ink-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // Editando uma mensagem: aviso acima do campo, com "cancelar".
                    if root.editing-id != "": Rectangle {
                        x: 16px;
                        height: 32px;
                        y: -self.height - 6px;
                        width: min(parent.width - 32px, 420px);
                        border-radius: 2px;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            Text {
                                text: "editando a mensagem · Enter salva · Esc cancela";
                                font-family: Theme.pixel;
                                font-size: 20px * Theme.pixel-scale;
                                color: Theme.ink-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Link {
                                text: "cancelar";
                                vertical-alignment: center;
                                clicked => { root.editing-id = ""; input.text = ""; }
                            }
                        }
                    }

                    // O anexo esperando o envio, acima do campo: imagem
                    // aparece em miniatura; só vai junto com a mensagem.
                    if root.pending-name != "": Rectangle {
                        property <bool> has-preview: root.pending-preview.width > 0;
                        x: 16px;
                        height: self.has-preview ? 132px : 44px;
                        y: -self.height - 6px;
                        width: min(parent.width - 32px, self.has-preview ? max(240px, thumb.width + 72px) : 420px);
                        border-radius: 2px;
                        background: Theme.surface-1;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        thumb := Image {
                            visible: parent.has-preview;
                            x: 8px;
                            y: 8px;
                            height: parent.has-preview ? parent.height - 40px : 0;
                            width: parent.has-preview ? min(320px, self.height * root.pending-preview.width / max(1, root.pending-preview.height)) : 0;
                            source: root.pending-preview;
                            image-fit: contain;
                            horizontal-alignment: left;
                        }
                        Text {
                            x: 10px;
                            y: parent.has-preview ? parent.height - 30px : 0;
                            width: parent.width - 60px;
                            height: parent.has-preview ? 28px : parent.height;
                            text: root.pending-name;
                            font-family: Theme.pixel;
                            font-size: 20px * Theme.pixel-scale;
                            color: Theme.ink-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        IconButton {
                            x: parent.width - self.width - 4px;
                            y: 4px;
                            icon: @image-url("icons/close.svg");
                            tip: "tirar anexo";
                            clicked => { root.cancel-attachment(); }
                        }
                    }
                    file-button := Rectangle {
                        property <bool> enabled: root.open-title != "";
                        x: parent.width - 16px - 104px;
                        y: 16px;
                        width: 48px;
                        height: 48px;
                        border-radius: 2px;
                        opacity: self.enabled ? 1 : 0.5;
                        background: file-area.has-hover ? Theme.surface-2 : transparent;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        file-area := TouchArea {
                            enabled: file-button.enabled;
                            mouse-cursor: pointer;
                            clicked => {
                                Tip.text = "";
                                root.pick-file();
                            }
                            changed has-hover => {
                                if !self.has-hover {
                                    Tip.text = "";
                                }
                            }
                        }
                        Text {
                            text: "+";
                            font-family: Theme.pixel;
                            font-size: 26px * Theme.pixel-scale;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // A mesma dica dos botões de ícone.
                        Timer {
                            interval: 450ms;
                            running: file-area.has-hover && Tip.text != "mandar imagem ou arquivo";
                            triggered => {
                                Tip.text = "mandar imagem ou arquivo";
                                Tip.x = file-button.absolute-position.x + file-button.width / 2;
                                Tip.y = file-button.absolute-position.y + file-button.height + 6px;
                            }
                        }
                    }

                    // Segure para gravar um áudio.
                    mic := Rectangle {
                        property <bool> enabled: root.open-title != "";
                        x: parent.width - 16px - 48px;
                        y: 16px;
                        width: 48px;
                        height: 48px;
                        border-radius: 2px;
                        opacity: self.enabled ? 1 : 0.5;
                        background: root.recording ? Theme.ink
                            : mic-area.has-hover ? Theme.surface-2 : transparent;
                        border-width: 1px;
                        border-color: root.recording ? Theme.ink : Theme.border-strong;

                        mic-area := TouchArea {
                            enabled: mic.enabled;
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if !self.has-hover {
                                    Tip.text = "";
                                }
                            }
                            pointer-event(event) => {
                                if event.button != PointerEventButton.left {
                                    return;
                                }
                                if event.kind == PointerEventKind.down {
                                    Tip.text = "";
                                    root.start-recording();
                                } else if event.kind == PointerEventKind.up {
                                    // Soltou ainda em cima do botão: envia.
                                    if self.mouse-x >= 0 && self.mouse-x <= self.width
                                        && self.mouse-y >= 0 && self.mouse-y <= self.height {
                                        root.stop-recording();
                                    } else {
                                        root.cancel-recording();
                                    }
                                } else if event.kind == PointerEventKind.cancel {
                                    root.cancel-recording();
                                }
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/mic.svg");
                            colorize: root.recording ? Theme.surface-0 : Theme.ink;
                        }
                        Timer {
                            interval: 450ms;
                            running: mic-area.has-hover && !root.recording && Tip.text != "segure para gravar um áudio";
                            triggered => {
                                Tip.text = "segure para gravar um áudio";
                                Tip.x = mic.absolute-position.x + mic.width / 2;
                                Tip.y = mic.absolute-position.y + mic.height + 6px;
                            }
                        }
                    }
                }
            }
        }

        if root.members-open && root.open-is-group && !root.settings-open && !root.page-open && !root.profile-open: MembersPanel {
            members: root.members;
            error: root.group-error;
            invite(username) => {
                root.group-error = "";
                root.invite(username);
            }
            remove(id) => {
                root.group-error = "";
                root.remove-member(id);
            }
            leave => { root.leave-group(); }
            show-profile(id, name, x, y) => { root.show-card(id, name, x, y); }
        }
    }
    // Por cima da conversa (a lista de conversas continua à vista).
    if root.logged-in && root.share-picker-open && root.call-is-open && !root.settings-open: SharePicker {
        x: 320px;
        y: root.bar-h;
        width: root.width - 320px;
        height: root.height - root.bar-h;
        screens: root.share-screens;
        windows: root.share-windows;
        audio-supported: root.share-audio-supported;
        audio <=> root.share-audio;
        pick(id, audio) => { root.start-share(id, audio); }
        close => { root.close-share-picker(); }
    }

    // Um vídeo em tela cheia, por cima de tudo.
    if root.logged-in && root.call-is-open && root.full-tile != "": Rectangle {
        background: #000000;
        for tile in root.video-tiles: Rectangle {
            visible: tile.id == root.full-tile;
            Image {
                width: 100%;
                height: 100%;
                source: tile.frame;
                image-fit: contain;
            }
            TouchArea {
                double-clicked => { root.full-tile = ""; }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.open-menu(tile.person, tile.id, tile.name, self.mouse-x, self.mouse-y);
                    }
                }
            }
            Rectangle {
                x: 8px;
                y: parent.height - self.height - 8px;
                width: full-label.preferred-width + 12px;
                height: full-label.preferred-height + 4px;
                background: Theme.surface-0;
                full-label := Text {
                    text: tile.name + " · esc ou clique duplo para sair";
                    font-family: Theme.pixel;
                    font-size: 20px * Theme.pixel-scale;
                    color: Theme.ink;
                }
            }
        }
        // Reações: as câmeras (ou as fotos) de quem está na chamada, numa
        // coluna à direita, para ver a cara dos amigos sem sair da tela cheia.
        if root.reactions-open: reactions := Rectangle {
            // A sua linha vem primeiro, quando está na lista.
            property <int> skip: root.call-people.length > 0 && root.call-people[0].is-me ? 1 : 0;
            property <int> count: root.call-people.length - self.skip;
            property <length> gap: 14px;
            property <length> tile-h: self.count <= 0 ? 0 : min(126px, (root.height - 76px - (self.count - 1) * self.gap) / self.count);
            property <length> tile-w: self.tile-h * 16 / 9;
            x: parent.width - self.tile-w - 20px;
            y: 64px;
            width: self.tile-w;
            height: max(0px, self.count * (self.tile-h + self.gap));
            for person[i] in root.call-people: ReactionTile {
                visible: !person.is-me;
                x: 0;
                y: (i - reactions.skip) * (reactions.tile-h + reactions.gap);
                width: reactions.tile-w;
                height: reactions.tile-h;
                person: person;
                tiles: root.video-tiles;
            }
        }
        if root.reactions-open && root.call-people.length <= 1: Rectangle {
            x: parent.width - self.width - 20px;
            y: 64px;
            width: alone-text.preferred-width + 16px;
            height: alone-text.preferred-height + 4px;
            background: Theme.surface-0;
            alone-text := Text {
                text: "ninguém mais na chamada";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
            }
        }
        Rectangle {
            x: parent.width - self.width - 16px;
            y: 16px;
            width: 38px;
            height: 38px;
            border-radius: 2px;
            background: Theme.surface-0;
            IconButton {
                x: 1px;
                y: 1px;
                icon: @image-url("icons/smile.svg");
                active: root.reactions-open;
                tip: root.reactions-open ? "esconder as reações" : "ver a reação dos amigos";
                clicked => { root.reactions-open = !root.reactions-open; }
            }
        }
        full-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.full-tile = "";
                    return accept;
                }
                reject
            }
        }
        init => { full-keys.focus(); }
    }

    // O mini cartão de alguém, perto do clique. Clicar fora ou Esc fecha.
    if root.logged-in && root.card-open: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.card-open = false;
                }
            }
        }
        card-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.card-open = false;
                    return accept;
                }
                reject
            }
        }
        init => { card-keys.focus(); }
        ProfileCard {
            turntable: root.turntable-frame;
            open-spotify(title, artist) => { root.open-spotify(title, artist); }
            x: max(8px, min(root.width - self.width - 8px, root.card-x + 6px));
            y: max(8px, min(root.height - self.height - 8px, root.card-y - 30px));
            data: root.card;
            photo: root.card-photo;
            small-photo: root.card-small-photo;
            bg-image: root.card-background;
            open-page => { root.open-page(root.card.id, root.card.name); }
            edit => { root.edit-my-profile(); }
            message => {
                root.card-open = false;
                root.page-open = false;
                root.open-direct(root.card.name);
            }
        }
    }

    // O mixer, embaixo do botão dele. Clicar fora (com qualquer botão) fecha.
    if root.logged-in && root.mixer-open && root.call-is-open && root.call-connected: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-open = false;
                }
            }
        }
        Mixer {
            x: max(8px, min(root.width - self.width - 8px, root.mixer-x - self.width));
            y: root.mixer-y;
            people: root.call-people;
            set-volume(id, screen, v) => { root.set-volume(id, screen, v); }
            close => { root.mixer-open = false; }
        }
    }

    // O menu do botão direito. Clicar fora (com qualquer botão) fecha.
    if root.logged-in && root.menu-open && root.call-is-open: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.menu-open = false;
                }
            }
        }
        if root.menu-person == "": CallMenu {
            x: max(8px, min(root.width - self.width - 8px, root.menu-x));
            y: max(8px, min(root.height - self.height - 8px, root.menu-y));
            title: root.menu-title;
            has-person: false;
            tile: root.menu-tile;
            full: root.menu-tile != "" && root.menu-tile == root.full-tile;
            toggle-full => { root.full-tile = root.full-tile == root.menu-tile ? "" : root.menu-tile; }
            close => { root.menu-open = false; }
        }
        for person in root.call-people: CallMenu {
            visible: person.id == root.menu-person;
            x: max(8px, min(root.width - self.width - 8px, root.menu-x));
            y: max(8px, min(root.height - self.height - 8px, root.menu-y));
            title: root.menu-title;
            has-person: true;
            person: person;
            tile: root.menu-tile;
            full: root.menu-tile != "" && root.menu-tile == root.full-tile;
            screen-tile: root.menu-tile != "" && root.menu-tile == person.id + "#tela";
            set-volume(id, screen, v) => { root.set-volume(id, screen, v); }
            stop-watching => { root.watch-screen(person.id, false); }
            toggle-full => { root.full-tile = root.full-tile == root.menu-tile ? "" : root.menu-tile; }
            close => { root.menu-open = false; }
        }
    }

    // Bordas de mudar o tamanho (a janela não tem moldura). Ficam por cima
    // do resto, mas são finas; somem com a janela maximizada ou em tela cheia.
    if !root.window-maximized && root.full-tile == "": Rectangle {
        property <length> e: 5px;
        ResizeEdge { dir: "n"; x: parent.e; y: 0; width: root.width - 2 * parent.e; height: parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "s"; x: parent.e; y: root.height - parent.e; width: root.width - 2 * parent.e; height: parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "w"; x: 0; y: parent.e; width: parent.e; height: root.height - 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "e"; x: root.width - parent.e; y: parent.e; width: parent.e; height: root.height - 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "nw"; x: 0; y: 0; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "ne"; x: root.width - 2 * parent.e; y: 0; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "sw"; x: 0; y: root.height - 2 * parent.e; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
        ResizeEdge { dir: "se"; x: root.width - 2 * parent.e; y: root.height - 2 * parent.e; width: 2 * parent.e; height: 2 * parent.e; resize(d) => { root.window-resize(d); } }
    }

    // Visualizador de imagem: a imagem começa ajustada no meio da tela;
    // arrastar move para qualquer lado, a roda dá zoom onde está o mouse.
    if root.image-open: Rectangle {
        background: #0a0a0af2;
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.image-open = false; return accept; }
                return reject;
            }
        }
        stage := Rectangle {
            y: 64px;
            width: parent.width;
            height: parent.height - 64px;
            clip: true;
            // Cabe inteira no espaço, sem passar do tamanho real.
            property <float> fit: min(1, min(self.width / max(1px, root.viewer-image.width * 1px),
                self.height / max(1px, root.viewer-image.height * 1px)) * 0.95);
            property <length> pan-x;
            property <length> pan-y;
            property <length> start-x;
            property <length> start-y;
            function zoom-at(factor: float, mx: length, my: length) {
                let z = clamp(root.viewer-zoom * factor, 0.1, 20);
                let f = z / root.viewer-zoom;
                // O ponto embaixo do mouse continua embaixo do mouse.
                self.pan-x = mx - self.width / 2 - (mx - self.width / 2 - self.pan-x) * f;
                self.pan-y = my - self.height / 2 - (my - self.height / 2 - self.pan-y) * f;
                root.viewer-zoom = z;
            }
            function reset() {
                self.pan-x = 0;
                self.pan-y = 0;
                root.viewer-zoom = 1;
            }
            Image {
                width: root.viewer-image.width * 1px * stage.fit * root.viewer-zoom;
                height: root.viewer-image.height * 1px * stage.fit * root.viewer-zoom;
                x: (stage.width - self.width) / 2 + stage.pan-x;
                y: (stage.height - self.height) / 2 + stage.pan-y;
                source: root.viewer-image;
                image-rendering: root.viewer-zoom * stage.fit > 2 ? pixelated : smooth;
            }
            pan := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        stage.start-x = stage.pan-x;
                        stage.start-y = stage.pan-y;
                    }
                }
                moved => {
                    stage.pan-x = stage.start-x + self.mouse-x - self.pressed-x;
                    stage.pan-y = stage.start-y + self.mouse-y - self.pressed-y;
                }
                double-clicked => {
                    if root.viewer-zoom == 1 { stage.zoom-at(2, self.mouse-x, self.mouse-y); } else { stage.reset(); }
                }
                scroll-event(event) => {
                    stage.zoom-at(event.delta-y > 0 ? 1.15 : 1 / 1.15, self.mouse-x, self.mouse-y);
                    return accept;
                }
            }
        }
        // Barra de cima, por cima da imagem.
        Rectangle {
            height: 64px;
            y: 0;
            background: Theme.surface-0;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                spacing: 6px;
                alignment: stretch;
                Text {
                    text: root.viewer-name;
                    font-family: Theme.pixel;
                    font-size: 24px * Theme.pixel-scale;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: round(root.viewer-zoom * stage.fit * 100) + "%";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink-muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 56px;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/zoom-out.svg");
                        tip: "diminuir";
                        clicked => { stage.zoom-at(1 / 1.25, stage.width / 2, stage.height / 2); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/zoom-in.svg");
                        tip: "aumentar";
                        clicked => { stage.zoom-at(1.25, stage.width / 2, stage.height / 2); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/fit.svg");
                        tip: "ajustar na tela";
                        clicked => { stage.reset(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/download.svg");
                        tip: "baixar";
                        clicked => { root.save-file(root.viewer-id, root.viewer-name); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/close.svg");
                        tip: "fechar (esc)";
                        clicked => { root.image-open = false; }
                    }
                }
            }
        }
    }

    // A dica dos botões de ícone, por último para ficar por cima de tudo.
    // Embaixo do botão; sem espaço embaixo, em cima dele.
    if Tip.text != "": Rectangle {
        property <length> w: tip-text.preferred-width + 16px;
        x: max(4px, min(root.width - self.w - 4px, Tip.x - self.w / 2));
        y: Tip.y + self.height + 4px > root.height ? Tip.y - self.height - 48px : Tip.y;
        width: self.w;
        height: 28px;
        background: Theme.ink;
        border-radius: 2px;
        tip-text := Text {
            x: 8px;
            height: parent.height;
            text: Tip.text;
            font-family: Theme.pixel;
            font-size: 20px * Theme.pixel-scale;
            color: Theme.surface-0;
            vertical-alignment: center;
        }
    }

    // A mariposa da tela de carregamento, por cima de absolutamente tudo.
    if root.splash-open: MothSplash {
        width: root.width;
        height: root.height;
        status: root.splash-status;
        version: root.app-version;
        leaving: root.splash-leaving;
        can-skip: root.splash-can-skip;
        ask-restart: root.splash-ask-restart;
        started: root.splash-started;
        skip => {
            root.splash-skip();
            root.splash-can-skip = false;
            root.splash-leaving = true;
        }
        restart => { root.splash-restart(); }
        later => {
            root.splash-ask-restart = false;
            root.splash-leaving = true;
        }
        gone => {
            root.splash-open = false;
            root.splash-leaving = false;
            root.splash-can-skip = false;
            root.splash-ask-restart = false;
        }
    }
}

// Uma mensagem no overlay: uma linha, "nome: texto" (áudio e arquivo viram
// uma palavra entre colchetes).
component OverlayMessage inherits Text {
    in property <MessageRow> message;
    text: root.message.author + ": "
        + (root.message.audio-id != "" ? "[áudio " + root.message.duration + "] "
            : root.message.file-id != "" ? "[" + root.message.file-name + "] " : "")
        + root.message.text;
    font-family: Theme.sans;
    font-size: 13px * Theme.sans-scale;
    color: Theme.ink;
    overflow: elide;
}

// O modo overlay: o app minimiza e fica só esta janelinha por cima de tudo,
// com o nome da conversa da chamada, quem está nela (com a borda da voz) e
// uma mensagem rápida para essa conversa. `overlay.rs` copia o que a janela
// principal mostra e muda o tamanho para `wanted-height`.
export component OverlayWindow inherits Window {
    title: "mothh · overlay";
    icon: @image-url("icons/mothh.png");
    no-frame: true;
    always-on-top: true;
    background: Theme.surface-0;
    default-font-family: Theme.sans;
    preferred-width: 300px;

    in property <string> call-name;
    in property <bool> connected;
    in property <bool> muted;
    in property <[CallPersonRow]> people;
    in property <image> my-photo;
    // As últimas mensagens da conversa da chamada.
    in property <[MessageRow]> messages;
    in-out property <bool> chat-open;
    out property <length> wanted-height: layout.preferred-height;
    callback drag();
    callback open-app();
    callback toggle-mute();
    callback send(string);

    layout := VerticalLayout {
        // Topo: arrastar move a janela.
        Rectangle {
            height: 38px;
            background: Theme.surface-1;
            TouchArea {
                mouse-cursor: move;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.drag();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 1px;
                padding-top: 1px;
                padding-bottom: 1px;
                spacing: 2px;
                Image {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/mothh.png");
                }
                Text {
                    text: root.call-name != "" ? " " + root.call-name : " mothh";
                    font-family: Theme.pixel;
                    font-size: 22px * Theme.pixel-scale;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.connected: IconButton {
                    icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                    danger: root.muted;
                    tip: root.muted ? "ligar o microfone" : "mutar o microfone";
                    clicked => { root.toggle-mute(); }
                }
                IconButton {
                    icon: @image-url("icons/overlay.svg");
                    tip: "voltar para o app";
                    clicked => { root.open-app(); }
                }
            }
        }

        // Quem está na chamada.
        Rectangle {
            height: 54px;
            clip: true;
            if root.people.length == 0: Text {
                x: 12px;
                text: root.call-name == "" ? "fora da chamada" : "entrando...";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: Theme.ink-muted;
                vertical-alignment: center;
            }
            HorizontalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                for person in root.people: CallAvatar {
                    name: person.name;
                    initial: person.initial;
                    photo: person.is-me ? root.my-photo : person.photo;
                    has-photo: person.is-me ? root.my-photo.width > 0 : person.has-photo;
                    level: person.level;
                    speaking: person.speaking;
                    muted: person.muted;
                    quality: person.quality;
                    ping: person.ping;
                }
            }
        }

        // Mensagem rápida: abre e fecha embaixo.
        Rectangle {
            height: 30px;
            background: chat-bar.has-hover ? Theme.surface-2 : Theme.surface-1;
            Text {
                x: 12px;
                text: (root.chat-open ? "▾ " : "▸ ") + "mensagem rápida";
                font-family: Theme.pixel;
                font-size: 20px * Theme.pixel-scale;
                color: chat-bar.has-hover || root.chat-open ? Theme.ink : Theme.ink-muted;
                vertical-alignment: center;
            }
            chat-bar := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chat-open = !root.chat-open; }
            }
        }
        if root.chat-open: VerticalLayout {
            padding: 8px;
            spacing: 4px;
            if root.messages.length == 0: Text {
                text: "nenhuma mensagem ainda";
                font-family: Theme.pixel;
                font-size: 18px * Theme.pixel-scale;
                color: Theme.ink-muted;
            }
            for message in root.messages: OverlayMessage { message: message; }
            quick := Field {
                height: 40px;
                placeholder: root.call-name != "" ? "mensagem para " + root.call-name : "mensagem";
                accepted => {
                    if self.text != "" {
                        root.send(self.text);
                        self.text = "";
                    }
                }
            }
            init => { quick.focus(); }
        }
    }

    // Contorno da janela, por cima de tudo (não pega cliques).
    Rectangle {
        border-width: 1px;
        border-color: Theme.border-strong;
    }

    if Tip.text != "": Rectangle {
        property <length> w: overlay-tip.preferred-width + 16px;
        x: max(4px, min(root.width - self.w - 4px, Tip.x - self.w / 2));
        y: Tip.y + self.height + 4px > root.height ? max(0px, Tip.y - self.height - 48px) : Tip.y;
        width: self.w;
        height: 28px;
        background: Theme.ink;
        border-radius: 2px;
        overlay-tip := Text {
            x: 8px;
            height: parent.height;
            text: Tip.text;
            font-family: Theme.pixel;
            font-size: 20px * Theme.pixel-scale;
            color: Theme.surface-0;
            vertical-alignment: center;
        }
    }
}
