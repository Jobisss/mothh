// Interface do mothh. Os valores de cor e fonte seguem docs/design-system.md.
//
// Dica: `slint-viewer ui/app.slint --auto-reload` mostra a tela e recarrega
// a cada mudança, sem recompilar o Rust.

import { ListView } from "std-widgets.slint";
import "fonts/VT323-Regular.ttf";
import "fonts/Geist-Regular.ttf";
import "fonts/Geist-SemiBold.ttf";

export struct ConversationRow {
    id: string,
    name: string,
    initial: string,
    preview: string,
    time: string,
    is-group: bool,
    selected: bool,
}

export struct MessageRow {
    author: string,
    time: string,
    text: string,
}

global Theme {
    out property <color> surface-0: #0a0a0a;
    out property <color> surface-1: #111111;
    out property <color> surface-2: #1a1a1a;
    out property <color> surface-3: #262626;
    out property <color> border: #262626;
    out property <color> border-strong: #6b6b6b;
    out property <color> ink: #f2f2f2;
    out property <color> ink-muted: #9a9a9a;
    out property <string> pixel: "VT323";
    out property <string> sans: "Geist";
}

component ConversationItem inherits Rectangle {
    in property <ConversationRow> item;
    callback clicked();

    height: 64px;
    border-radius: 4px;
    background: item.selected ? Theme.surface-3 : area.has-hover ? Theme.surface-2 : transparent;

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: item.is-group ? 4px : 22px;
            background: Theme.surface-3;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: item.initial;
                font-family: Theme.pixel;
                font-size: 26px;
                color: Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                Text {
                    text: item.name;
                    font-family: Theme.pixel;
                    font-size: 24px;
                    color: Theme.ink;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: item.time;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: Theme.ink-muted;
                }
            }
            Text {
                text: item.preview;
                font-family: Theme.pixel;
                font-size: 20px;
                color: Theme.ink-muted;
                overflow: elide;
            }
        }
    }
}

component MessageItem inherits VerticalLayout {
    in property <MessageRow> item;
    padding-top: 6px;
    padding-bottom: 6px;
    spacing: 2px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: item.author;
            font-family: Theme.pixel;
            font-size: 22px;
            color: Theme.ink;
        }
        Text {
            text: item.time;
            font-family: Theme.pixel;
            font-size: 18px;
            color: Theme.ink-muted;
            vertical-alignment: bottom;
        }
    }
    Text {
        text: item.text;
        font-family: Theme.sans;
        font-size: 15px;
        color: Theme.ink;
        wrap: word-wrap;
    }
}

// Campo de texto com rótulo, no mesmo estilo de terminal do campo de mensagem.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <bool> password;
    in-out property <string> text <=> input.text;
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    spacing: 4px;

    Text {
        text: root.label;
        font-family: Theme.pixel;
        font-size: 20px;
        color: Theme.ink-muted;
    }
    Rectangle {
        height: 44px;
        border-radius: 2px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: input.has-focus ? Theme.ink : Theme.border-strong;

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            input := TextInput {
                input-type: root.password ? InputType.password : InputType.text;
                font-family: Theme.sans;
                font-size: 15px;
                color: Theme.ink;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
            }
        }
    }
}

// Botão: cheio (preto no branco) para a ação principal, só borda para a outra.
component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    border-radius: 2px;
    border-width: 1px;
    border-color: root.enabled ? Theme.ink : Theme.border-strong;
    background: !root.primary ? (area.has-hover && root.enabled ? Theme.surface-2 : transparent)
        : root.enabled ? (area.has-hover ? Theme.ink-muted : Theme.ink) : Theme.surface-3;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-family: Theme.pixel;
        font-size: 24px;
        color: root.primary && root.enabled ? Theme.surface-0 : root.enabled ? Theme.ink : Theme.ink-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Tela de entrada: usuário, senha, "entrar" e "criar conta".
component LoginScreen inherits Rectangle {
    in property <string> error;
    in property <string> status;
    in property <bool> busy;
    callback login(string, string);
    callback register(string, string);

    background: Theme.surface-0;

    // Some com a senha da memória da tela assim que ela é enviada.
    function submit(create: bool) {
        if (create) {
            root.register(username.text, password.text);
        } else {
            root.login(username.text, password.text);
        }
        password.text = "";
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                spacing: 16px;

                Text {
                    text: "MOTHH";
                    font-family: Theme.pixel;
                    font-size: 56px;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: "> entre na sua conta";
                    font-family: Theme.pixel;
                    font-size: 22px;
                    color: Theme.ink-muted;
                    horizontal-alignment: center;
                }

                username := Field {
                    label: "usuário";
                    accepted => { password.focus-input(); }
                }
                password := Field {
                    label: "senha";
                    password: true;
                    accepted => { root.submit(false); }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        text: "entrar";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.submit(false); }
                    }
                    Button {
                        text: "criar conta";
                        enabled: !root.busy;
                        clicked => { root.submit(true); }
                    }
                }

                // Linha de erro (ou do que está acontecendo agora).
                Text {
                    text: root.error != "" ? "! " + root.error : root.busy ? "entrando..." : root.status;
                    font-family: Theme.pixel;
                    font-size: 20px;
                    color: root.error != "" ? Theme.ink : Theme.ink-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    init => { username.focus-input(); }
}

export component AppWindow inherits Window {
    title: root.user-name == "" ? "mothh" : "mothh · " + root.user-name;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.surface-0;
    default-font-family: Theme.sans;

    in property <[ConversationRow]> conversations;
    in property <[MessageRow]> messages;
    in property <string> open-title;
    in property <string> status: "conectando...";
    in property <string> user-name;
    in property <bool> logged-in;
    in property <bool> auth-busy;
    in property <string> auth-error;

    callback open-conversation(string);
    callback send-message(string);
    callback login(string, string);
    callback register(string, string);
    callback logout();

    if !root.logged-in: LoginScreen {
        error: root.auth-error;
        status: root.status;
        busy: root.auth-busy;
        login(user, pass) => { root.login(user, pass); }
        register(user, pass) => { root.register(user, pass); }
    }

    if root.logged-in: HorizontalLayout {
        // Coluna da esquerda: lista de conversas.
        Rectangle {
            width: 320px;
            background: Theme.surface-0;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "CONVERSAS";
                    font-family: Theme.pixel;
                    font-size: 26px;
                    color: Theme.ink;
                }

                ListView {
                    vertical-stretch: 1;
                    for row in root.conversations: ConversationItem {
                        item: row;
                        clicked => { root.open-conversation(row.id); }
                    }
                }

                // Rodapé: quem está logado e o botão de sair.
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.user-name + " · " + root.status;
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: Theme.ink-muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "[sair]";
                        font-family: Theme.pixel;
                        font-size: 20px;
                        color: logout-area.has-hover ? Theme.ink : Theme.ink-muted;
                        logout-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.logout(); }
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        // Coluna da direita: conversa aberta.
        Rectangle {
            background: Theme.surface-1;
            horizontal-stretch: 1;

            VerticalLayout {
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 16px;
                        Text {
                            text: root.open-title == "" ? "> escolha uma conversa" : root.open-title;
                            font-family: Theme.pixel;
                            font-size: 28px;
                            color: root.open-title == "" ? Theme.ink-muted : Theme.ink;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                messages-list := ListView {
                    vertical-stretch: 1;
                    for row in root.messages: MessageItem {
                        item: row;
                        padding-left: 16px;
                        padding-right: 16px;
                    }
                }

                // Campo de mensagem com cara de terminal: "> " e cursor.
                Rectangle {
                    height: 80px;
                    Rectangle {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: 48px;
                        border-radius: 2px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: input.has-focus ? Theme.ink : Theme.border-strong;

                        // Clicar em qualquer parte da caixa foca o campo.
                        TouchArea {
                            mouse-cursor: text;
                            clicked => { input.focus(); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text {
                                text: ">";
                                font-family: Theme.pixel;
                                font-size: 22px;
                                color: Theme.ink-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            input := TextInput {
                                horizontal-stretch: 1;
                                enabled: root.open-title != "";
                                font-family: Theme.sans;
                                font-size: 15px;
                                color: Theme.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => {
                                    root.send-message(self.text);
                                    self.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
